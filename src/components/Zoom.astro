---
// Ouverture : « Creative thinking. » s'écarte pendant qu'une arche vert sapin grandit jusqu'au plein écran.
// L'arche s'ouvre sur la section des expertises (même fond), dont le titre apparaît dedans.
const levels = [{ img: null }];
import { services } from '../config/site';
import Shape from './Shape.astro';
---

<section class="scene zoom" data-theme="cream" data-scene data-zoom style={`--n:${levels.length}`} aria-label="Creative thinking">
  <div class="scene__sticky zoom__sticky">
    <p class="zoom__word zoom__word--l" aria-hidden="true">Creative</p>
    <p class="zoom__word zoom__word--r" aria-hidden="true"><em>thinking.</em></p>

    {
      levels.map((l, i) => (
        <div class="zl zl--services" data-level style={`z-index:${i + 1}`}>
          <div class="zl__bg">
            <span class="zl__sh zl__sh--1"><Shape name="leaf" color="var(--sage)" /></span>
            <span class="zl__sh zl__sh--2"><Shape name="half" color="var(--ochre)" /></span>
            <span class="zl__sh zl__sh--3"><Shape name="circle" color="var(--clay)" /></span>
          </div>
          <div class="zl__veil" />
          <div class="zl__text zl__text--center">
            <p class="zl__flag">{services.length} expertises, 1 interlocutrice</p>
            <h2 class="zl__h">Six <em>expertises</em></h2>
            <p class="zl__lead">En mission ponctuelle ou en accompagnement mensuel. Retournez une carte pour voir ce qu'elle contient.</p>
          </div>
        </div>
      ))
    }
  </div>
</section>

<script>
  const scene = document.querySelector<HTMLElement>('[data-zoom]');
  if (scene) {
    const layers = [...scene.querySelectorAll<HTMLElement>('[data-level]')];
    const n = layers.length;
    const clamp = (x: number, a = 0, b = 1) => Math.min(b, Math.max(a, x));
    const ease = (x: number) => 1 - Math.pow(1 - x, 3);
    const render = (p: number) => {
      // t va de -1 (première arche encore petite) à n - 1 (dernier niveau plein écran).
      // Chaque étape : 65 % de transition puis un palier pour lire le niveau.
      const u = Math.min(p * n, n - 0.0001);
      const seg = Math.floor(u);
      const t = seg - 1 + Math.min((u - seg) / 0.65, 1);
      const vw = window.innerWidth;
      const vh = window.innerHeight;
      const small = vw < 760;
      const w0 = small ? vw * 0.62 : Math.min(vw * 0.26, 420);
      const h0 = small ? vh * 0.5 : vh * 0.58;
      scene.style.setProperty('--t', String(t));
      layers.forEach((el, i) => {
        const d = t - i;
        const img = el.firstElementChild as HTMLElement;
        const text = el.querySelector<HTMLElement>('.zl__text')!;
        const veil = el.querySelector<HTMLElement>('.zl__veil')!;
        if (d <= (i === 0 ? -1.01 : -0.995) || d > 1.05) {
          el.style.visibility = 'hidden';
          return;
        }
        el.style.visibility = 'visible';
        if (d <= 0) {
          // l'arche grandit jusqu'au plein écran
          const e = ease(d + 1);
          // le premier niveau part de l'arche, les suivants naissent d'un point au centre
          const ws = i === 0 ? w0 : w0 * 0.12;
          const hs = i === 0 ? h0 : h0 * 0.12;
          const w = ws + (vw - ws) * e;
          const h = hs + (vh - hs) * e;
          const ix = (vw - w) / 2;
          const iy = (vh - h) / 2;
          const r = (w / 2) * (1 - e);
          const rb = 28 * (1 - e);
          el.style.clipPath = `inset(${iy}px ${ix}px round ${r}px ${r}px ${rb}px ${rb}px)`;
          el.style.transform = 'none';
          el.style.opacity = '1';
          img.style.transform = `scale(${1.3 - 0.3 * e})`;
          text.style.opacity = String(clamp((d + 0.55) * 2.6));
          veil.style.opacity = String(0.25 + 0.75 * e);
        } else {
          // on plonge dedans : zoom avant et fondu
          el.style.clipPath = 'none';
          el.style.transform = `scale(${1 + d * 1.8})`;
          el.style.opacity = String(clamp(1 - d * 0.9));
          img.style.transform = 'scale(1)';
          text.style.opacity = String(clamp(1 - d * 4));
          veil.style.opacity = '1';
        }
      });
    };
    render(0);
    scene.addEventListener('scene', (e) => render((e as CustomEvent<number>).detail));
    window.addEventListener('resize', () => render(Number(getComputedStyle(scene).getPropertyValue('--p')) || 0));
  }
</script>

<style>
  .zoom {
    height: calc((var(--n) + 1) * 100vh + 60vh);
  }
  .zoom__sticky {
  }
  .zoom__word {
    position: absolute;
    top: 50%;
    z-index: 0;
    font: 300 clamp(4rem, 13vw, 13rem) / 1 var(--font-serif);
    letter-spacing: -0.04em;
    color: var(--ink);
    white-space: nowrap;
    opacity: calc(1 - (var(--t, -1) + 1) * 1.6);
  }
  .zoom__word em {
    color: var(--ochre);
  }
  .zoom__word--l {
    right: 53%;
    transform: translate(calc((var(--t, -1) + 1) * -40vw), -50%);
  }
  .zoom__word--r {
    left: 53%;
    transform: translate(calc((var(--t, -1) + 1) * 40vw), -50%);
  }
  .zl {
    position: absolute;
    inset: 0;
    overflow: hidden;
    transform-origin: 50% 50%;
    will-change: transform, clip-path, opacity;
  }
  .zl__bg {
    position: absolute;
    inset: 0;
    background: var(--fir);
  }
  .zl__sh { position: absolute; display: block; opacity: 0.9; }
  .zl__sh :global(.shape) { width: 100%; height: auto; }
  .zl__sh--1 { width: clamp(90px, 14vw, 200px); left: 8%; top: 14%; }
  .zl__sh--2 { width: clamp(80px, 12vw, 170px); right: 9%; top: 22%; }
  .zl__sh--3 { width: clamp(60px, 8vw, 120px); right: 18%; bottom: 12%; }
  @media (max-width: 760px) { .zl__sh--3 { bottom: 5%; right: 12%; } }
  .zl--services .zl__veil {
    display: none;
  }
  .zl__text--center {
    inset: 0;
    align-content: center;
    padding: 0 var(--gutter);
  }
  .zl__flag {
    padding: 0.5em 1.1em;
    border-radius: 999px;
    background: var(--ochre);
    color: #1a1a1a;
    font-size: 0.85rem;
    font-weight: 600;
  }
  .zl__h {
    font-size: clamp(3rem, 8vw, 7rem);
    color: #f4f1ea;
  }
  .zl__h em {
    color: var(--ochre);
  }
  .zl__lead {
    max-width: 30rem;
    color: rgb(244 241 234 / 0.78);
  }
  .zl__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    will-change: transform;
  }
  .zl__veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(26 26 26 / 0) 30%, rgb(26 26 26 / 0.4) 62%, rgb(26 26 26 / 0.74));
  }
  .zl__text {
    position: absolute;
    inset: auto 0 0 0;
    display: grid;
    justify-items: center;
    gap: 1.2rem;
    padding: 0 var(--gutter) clamp(72px, 12vh, 130px);
    text-align: center;
    color: var(--cream);
  }
  .zl__kicker {
    font-size: 0.78rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--sage-light);
  }
  .zl__title {
    font: 300 clamp(2.3rem, 5.4vw, 5.2rem) / 1.04 var(--font-serif);
    letter-spacing: -0.02em;
    max-width: 20ch;
  }
  .zl__title em {
    color: var(--ochre);
  }
  .zl__cta {
    background: var(--cream) !important;
    color: var(--moss) !important;
  }
  @media (max-width: 760px) {
    .zoom__word {
      font-size: 17vw;
    }
    .zoom__word--l {
      right: auto;
      left: 6vw;
      top: 13svh;
      transform: translateX(calc((var(--t, -1) + 1) * -60vw));
    }
    .zoom__word--r {
      left: auto;
      right: 6vw;
      top: auto;
      bottom: 10svh;
      transform: translateX(calc((var(--t, -1) + 1) * 60vw));
    }
  }
</style>
