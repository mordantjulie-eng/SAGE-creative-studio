---
// Scène « livre » : le parcours de Julie, façon CV, qui se feuillette au défilement.
import SceneNav from './SceneNav.astro';
type Entry = { when: string; title: string; where: string; text: string; todo?: boolean };
const entries: Entry[] = [
  { when: '2020 à 2024', title: 'Bachelier en Marketing', where: 'EPHEC, option International Business', text: 'Marketing digital, communication, UX/UI et business international.' },
  { when: '2023', title: 'YourStory Agency', where: 'Stage en création de contenu', text: "Contenus pour les réseaux sociaux et animation de communautés. Une maître de stage qui m'a fait confiance : une approche que j'ai reprise en encadrant mon propre stagiaire chez Kontnu." },
  { when: 'Waterloo', title: 'ENEON / Idweaver', where: 'Marketing Officer', text: 'Personal branding de dirigeants, podcasts, emailing et marque employeur, notamment pour Holcim Belgique, Compaktuna, Cantillana et Allten.' },
  { when: '2024 à 2025, Bruxelles', title: 'Socialsky', where: 'Community Manager Gen Z, CDD puis CDI', text: "Contenus et communautés pour Basic-Fit, Leonidas, Ixina, Yves Rocher, O'Tacos, Love Tomorrow, Equans BELUX et Renault Trucks." },
  { when: '2025 à 2027', title: 'Kontnu', where: 'Business developer puis digital marketing manager', text: 'Ventes et prospection dès octobre 2025, puis pilotage du marketing digital à partir de mai 2026.' },
];
const leaves = [
  { front: null, back: entries[0] },
  { front: entries[1], back: entries[2] },
  { front: entries[3], back: entries[4] },
];
---

<section class="scene book-scene" data-theme="cream" data-scene data-book aria-label="Mon parcours" id="parcours">
  <div class="scene__sticky book-scene__sticky">
    <div class="orbs" aria-hidden="true">
      <span class="orb orb--sage" style="width:640px;height:640px;left:-180px;top:-120px;--d:26s"></span>
      <span class="orb orb--champagne" style="width:560px;height:560px;right:-140px;bottom:-200px;opacity:.6;--d:30s"></span>
    </div>

    <div class="container book-scene__head">
      <p class="eyebrow">Mon parcours</p>
      <h2>Une histoire <em>qui se feuillette.</em></h2>
    </div>

    <div class="book-wrap" aria-hidden="true">
      <div class="book" data-book-el>
        <div class="book__page book__page--left">
          <div class="book__blank"><span>SAGE</span></div>
        </div>
        <div class="book__page book__page--right">
          <div class="book__end">
            <p class="cv__when">2027</p>
            <p>SAGE<br /><em>creative studio.</em></p>
            <p class="cv__text">Et la prochaine page, on l'écrit ensemble.</p>
          </div>
        </div>
        {
          leaves.map((l, i) => (
            <div class="leaf" data-leaf style={`z-index:${leaves.length - i}`}>
              <div class="leaf__face leaf__front">
                {l.front === null ? (
                  <div class="cover">
                    <span class="cover__brand">SAGE</span>
                    <span class="cover__title">Mon parcours</span>
                    <span class="cover__sub">Julie Mordant</span>
                  </div>
                ) : (
                  <article class:list={['cv', { 'cv--todo': l.front.todo }]}>
                    <p class="cv__when">{l.front.when}</p>
                    <h3 class="cv__title">{l.front.title}</h3>
                    <p class="cv__where">{l.front.where}</p>
                    <p class="cv__text">{l.front.text}</p>
                    <span class="cv__n">{i * 2}</span>
                  </article>
                )}
              </div>
              <div class="leaf__face leaf__back">
                <article class:list={['cv', { 'cv--todo': l.back.todo }]}>
                  <p class="cv__when">{l.back.when}</p>
                  <h3 class="cv__title">{l.back.title}</h3>
                  <p class="cv__where">{l.back.where}</p>
                  <p class="cv__text">{l.back.text}</p>
                  <span class="cv__n">{i * 2 + 1}</span>
                </article>
              </div>
            </div>
          ))
        }
      </div>
    </div>
    <SceneNav steps={4} label="Faites défiler pour tourner les pages" />
  </div>
</section>

<script>
  const scene = document.querySelector<HTMLElement>('[data-book]');
  if (scene) {
    const book = scene.querySelector<HTMLElement>('[data-book-el]')!;
    const leaves = [...scene.querySelectorAll<HTMLElement>('[data-leaf]')];
    const n = leaves.length;
    const clamp = (x: number) => Math.min(1, Math.max(0, x));
    const render = (p: number) => {
      // ouverture de la couverture puis pages, chacune sur une tranche du défilement
      const span = 0.8 / n;
      leaves.forEach((leaf, i) => {
        const t = clamp((p - 0.08 - i * span) / (span * 0.85));
        const e = t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2;
        leaf.style.transform = `rotateY(${-180 * e}deg)`;
        leaf.style.zIndex = String(e > 0.5 ? 10 + i : n - i);
      });
      const open = clamp((p - 0.08) / (span * 0.85));
      book.style.setProperty('--open', String(open));
    };
    render(0);
    scene.addEventListener('scene', (e) => render((e as CustomEvent<number>).detail));
  }
</script>

<style>
  .book-scene {
    height: 360vh;
  }
  .book-scene__sticky {
    display: grid;
    grid-template-rows: auto 1fr auto;
    padding-top: clamp(96px, 13vh, 140px);
    padding-bottom: 28px;
  }
  .book-scene__head {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 1rem;
  }
  .book-scene__head h2 {
    font-size: clamp(2.2rem, 4.6vw, 4rem);
  }
  .book-wrap {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    perspective: 2400px;
  }
  .book {
    --w: min(32vw, 46vh, 440px);
    --open: 0;
    position: relative;
    width: calc(var(--w) * 2);
    height: calc(var(--w) * 1.32);
    transform-style: preserve-3d;
    transform: translateX(calc(var(--w) * -0.5 * (1 - var(--open)))) rotateX(calc(14deg * (1 - var(--open)) + 6deg));
    transition: transform 0.1s linear;
  }
  .book__page {
    position: absolute;
    top: 0;
    width: 50%;
    height: 100%;
    background: #fbf9f4;
    box-shadow: var(--shadow);
  }
  .book__page--left {
    left: 0;
    border-radius: 14px 4px 4px 14px;
    opacity: calc(var(--open) * 3);
    background: linear-gradient(90deg, #f3efe6, #fbf9f4 85%, #e9e3d6);
  }
  .book__page--right {
    right: 0;
    border-radius: 4px 14px 14px 4px;
    background: linear-gradient(90deg, #e9e3d6, #fbf9f4 15%, #f3efe6);
  }
  .book__blank,
  .book__end {
    height: 100%;
    display: grid;
    place-items: center;
    text-align: center;
  }
  .book__blank span {
    font: italic 850 1.2rem var(--font-display);
    letter-spacing: 0.3em;
    color: var(--eucalyptus);
  }
  .book__end p {
    font: italic 850 clamp(1.3rem, 2.2vw, 2rem) / 1.15 var(--font-display);
    color: var(--ink);
  }
  .book__end em {
    color: var(--ochre);
  }
  .leaf {
    position: absolute;
    top: 0;
    right: 0;
    width: 50%;
    height: 100%;
    transform-origin: left center;
    transform-style: preserve-3d;
  }
  .leaf__face {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    background: #fbf9f4;
    overflow: hidden;
  }
  .leaf__front {
    border-radius: 4px 14px 14px 4px;
  }
  .leaf__back {
    transform: rotateY(180deg);
    border-radius: 14px 4px 4px 14px;
  }
  .leaf figure {
    margin: 0;
    height: 100%;
    padding: 9%;
    display: grid;
    grid-template-rows: 1fr auto;
    gap: 0.8rem;
  }
  .leaf figure img {
    width: 100%;
    height: 100%;
    border-radius: 6px;
  }
  .leaf figcaption {
    font: italic 700 1rem var(--font-display);
    color: var(--eucalyptus);
  }
  .cover {
    height: 100%;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.6rem;
    background: var(--grad-dark);
    color: var(--ink);
    box-shadow: inset 6px 0 12px -6px rgb(0 0 0 / 0.4);
  }
  .cover__brand {
    font: italic 850 1rem var(--font-display);
    letter-spacing: 0.4em;
    padding-left: 0.4em;
    opacity: 0.85;
  }
  .cover__title {
    font: italic 850 clamp(2.2rem, 3.6vw, 3.4rem) / 1 var(--font-display);
    color: var(--ochre);
  }
  .cover__sub {
    font: italic 700 0.95rem var(--font-display);
    opacity: 0.7;
  }
  .book-scene__note {
    position: relative;
    z-index: 1;
    text-align: center;
    font-size: 0.75rem;
    color: rgb(43 52 47 / 0.5);
  }
  @media (max-width: 760px) {
    .book {
      --w: 46vw;
      height: calc(var(--w) * 2.15);
    }
    .cv { padding: 10% 9%; gap: 0.4rem; }
    .cv__title { font-size: 1.05rem; }
    .cv__where, .cv__text { font-size: 0.64rem; line-height: 1.32; }
    .cv__title { font-size: 0.98rem !important; }
    .cv__n { display: none; }
    .cv__when { font-size: 0.8rem; }
    .book__end { padding: 10% 9%; }
    .book__end p { font-size: 1rem !important; }
    .cover__title { font-size: 1.4rem; }
  }
  .cv { position: relative; height: 100%; display: grid; align-content: center; gap: 0.7rem; padding: 12%; color: #1a1a1a; }
  .cv__when { font: italic 400 clamp(1rem, 1.6vw, 1.3rem) var(--font-letter); color: var(--ochre); }
  .cv__title { font-size: clamp(1.4rem, 2.4vw, 2.1rem); color: #1a1a1a; }
  .cv__where { font-weight: 600; font-size: 0.92rem; }
  .cv__text { font-size: 0.9rem; color: rgb(26 26 26 / 0.72); line-height: 1.5; }
  .cv--todo .cv__text { font-style: italic; color: rgb(26 26 26 / 0.45); }
  .cv__n { position: absolute; bottom: 8%; right: 10%; font: italic 400 0.9rem var(--font-letter); color: rgb(26 26 26 / 0.35); }
  .book__end { gap: 0.6rem; padding: 12%; align-content: center; overflow: hidden; }
  .book__page { overflow: hidden; }
  .book__end p.cv__when { font: italic 400 1.2rem var(--font-letter) !important; color: var(--ochre); }
  .book__end p.cv__text { font: 400 0.9rem/1.5 var(--font-ui) !important; color: rgb(26 26 26 / 0.7); }
  .book__end .cv__text { margin-top: 0.4rem; }
</style>
