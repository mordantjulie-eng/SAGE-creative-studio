---
// Scène « livre » : un lookbook fermé s'ouvre au défilement, puis ses pages se tournent.
const leaves = [
  { front: { cover: true }, back: { img: 'moodboard', cap: 'Moodboard' } },
  { front: { img: 'swatches', cap: 'Palette & matières' }, back: { img: 'design-screen', cap: 'Templates réseaux' } },
  { front: { img: 'flatlay', cap: 'Atelier créatif' }, back: { img: 'julie-studio', cap: 'Direction photo' } },
];
---

<section class="scene book-scene" data-scene data-book aria-label="Lookbook">
  <div class="scene__sticky book-scene__sticky">
    <div class="orbs" aria-hidden="true">
      <span class="orb orb--sage" style="width:640px;height:640px;left:-180px;top:-120px;--d:26s"></span>
      <span class="orb orb--champagne" style="width:560px;height:560px;right:-140px;bottom:-200px;opacity:.6;--d:30s"></span>
    </div>

    <div class="container book-scene__head">
      <p class="eyebrow">Branding & art direction</p>
      <h2>Des univers<br /><em>qui se feuillettent.</em></h2>
    </div>

    <div class="book-wrap" aria-hidden="true">
      <div class="book" data-book-el>
        <div class="book__page book__page--left">
          <div class="book__blank"><span>SAGE</span></div>
        </div>
        <div class="book__page book__page--right">
          <div class="book__end">
            <p>Votre marque,<br /><em>prochaine page.</em></p>
          </div>
        </div>
        {
          leaves.map((l, i) => (
            <div class="leaf" data-leaf style={`z-index:${leaves.length - i}`}>
              <div class="leaf__face leaf__front">
                {l.front.cover ? (
                  <div class="cover">
                    <span class="cover__brand">SAGE</span>
                    <span class="cover__title">Lookbook</span>
                    <span class="cover__sub">creative studio</span>
                  </div>
                ) : (
                  <figure>
                    <img class="photo" src={`/media/${l.front.img}.jpg`} alt="" />
                    <figcaption>{l.front.cap}</figcaption>
                  </figure>
                )}
              </div>
              <div class="leaf__face leaf__back">
                <figure>
                  <img class="photo" src={`/media/${l.back.img}.jpg`} alt="" />
                  <figcaption>{l.back.cap}</figcaption>
                </figure>
              </div>
            </div>
          ))
        }
      </div>
    </div>
    <p class="book-scene__note">Visuels d'illustration</p>
  </div>
</section>

<script>
  const scene = document.querySelector<HTMLElement>('[data-book]');
  if (scene) {
    const book = scene.querySelector<HTMLElement>('[data-book-el]')!;
    const leaves = [...scene.querySelectorAll<HTMLElement>('[data-leaf]')];
    const n = leaves.length;
    const clamp = (x: number) => Math.min(1, Math.max(0, x));
    const render = (p: number) => {
      // ouverture de la couverture puis pages, chacune sur une tranche du défilement
      const span = 0.8 / n;
      leaves.forEach((leaf, i) => {
        const t = clamp((p - 0.08 - i * span) / (span * 0.85));
        const e = t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2;
        leaf.style.transform = `rotateY(${-180 * e}deg)`;
        leaf.style.zIndex = String(e > 0.5 ? 10 + i : n - i);
      });
      const open = clamp((p - 0.08) / (span * 0.85));
      book.style.setProperty('--open', String(open));
    };
    render(0);
    scene.addEventListener('scene', (e) => render((e as CustomEvent<number>).detail));
  }
</script>

<style>
  .book-scene {
    height: 360vh;
    background: var(--grad-soft);
  }
  .book-scene__sticky {
    display: grid;
    grid-template-rows: auto 1fr auto;
    padding-top: clamp(96px, 13vh, 140px);
    padding-bottom: 28px;
  }
  .book-scene__head {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 1rem;
  }
  .book-scene__head h2 {
    font-size: clamp(2.2rem, 4.6vw, 4rem);
  }
  .book-wrap {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    perspective: 2400px;
  }
  .book {
    --w: min(32vw, 46vh, 440px);
    --open: 0;
    position: relative;
    width: calc(var(--w) * 2);
    height: calc(var(--w) * 1.32);
    transform-style: preserve-3d;
    transform: translateX(calc(var(--w) * -0.5 * (1 - var(--open)))) rotateX(calc(14deg * (1 - var(--open)) + 6deg));
    transition: transform 0.1s linear;
  }
  .book__page {
    position: absolute;
    top: 0;
    width: 50%;
    height: 100%;
    background: #fbf9f4;
    box-shadow: var(--shadow);
  }
  .book__page--left {
    left: 0;
    border-radius: 14px 4px 4px 14px;
    opacity: calc(var(--open) * 3);
    background: linear-gradient(90deg, #f3efe6, #fbf9f4 85%, #e9e3d6);
  }
  .book__page--right {
    right: 0;
    border-radius: 4px 14px 14px 4px;
    background: linear-gradient(90deg, #e9e3d6, #fbf9f4 15%, #f3efe6);
  }
  .book__blank,
  .book__end {
    height: 100%;
    display: grid;
    place-items: center;
    text-align: center;
  }
  .book__blank span {
    font: 300 1.2rem var(--font-serif);
    letter-spacing: 0.3em;
    color: var(--eucalyptus);
  }
  .book__end p {
    font: 300 clamp(1.3rem, 2.2vw, 2rem) / 1.15 var(--font-serif);
    color: var(--ink);
  }
  .book__end em {
    color: var(--ochre);
  }
  .leaf {
    position: absolute;
    top: 0;
    right: 0;
    width: 50%;
    height: 100%;
    transform-origin: left center;
    transform-style: preserve-3d;
  }
  .leaf__face {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    background: #fbf9f4;
    overflow: hidden;
  }
  .leaf__front {
    border-radius: 4px 14px 14px 4px;
  }
  .leaf__back {
    transform: rotateY(180deg);
    border-radius: 14px 4px 4px 14px;
  }
  .leaf figure {
    margin: 0;
    height: 100%;
    padding: 9%;
    display: grid;
    grid-template-rows: 1fr auto;
    gap: 0.8rem;
  }
  .leaf figure img {
    width: 100%;
    height: 100%;
    border-radius: 6px;
  }
  .leaf figcaption {
    font: italic 300 1rem var(--font-serif);
    color: var(--eucalyptus);
  }
  .cover {
    height: 100%;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.6rem;
    background: var(--grad-dark);
    color: var(--cream);
    box-shadow: inset 6px 0 12px -6px rgb(0 0 0 / 0.4);
  }
  .cover__brand {
    font: 300 1rem var(--font-serif);
    letter-spacing: 0.4em;
    padding-left: 0.4em;
    opacity: 0.85;
  }
  .cover__title {
    font: italic 300 clamp(2.2rem, 3.6vw, 3.4rem) / 1 var(--font-serif);
    color: var(--ochre);
  }
  .cover__sub {
    font: italic 300 0.95rem var(--font-serif);
    opacity: 0.7;
  }
  .book-scene__note {
    position: relative;
    z-index: 1;
    text-align: center;
    font-size: 0.75rem;
    color: rgb(43 52 47 / 0.5);
  }
  @media (max-width: 760px) {
    .book {
      --w: 44vw;
    }
  }
</style>
