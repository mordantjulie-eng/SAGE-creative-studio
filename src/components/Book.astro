---
// Scène « livre » : le parcours de Julie, façon CV, qui se feuillette au défilement.
import SceneNav from './SceneNav.astro';
type Entry = { when: string; title: string; where: string; text?: string; points?: string[]; todo?: boolean };
const entries: Entry[] = [
  { when: '2020 à 2024', title: 'Bachelier en Marketing', where: 'EPHEC, option International Business', text: 'Marketing digital, communication, UX/UI et business international.' },
  {
    when: '2023', title: 'YourStory Agency', where: 'Stage en social media',
    points: [
      "Création de contenu pour les réseaux sociaux, de l'idée à la publication.",
      'Production vidéo : tournage et montage de formats courts.',
      'Community management : animation et modération des communautés.',
    ],
  },
  {
    when: 'Waterloo', title: 'ENEON / Idweaver', where: 'Marketing Officer',
    points: [
      'Personal branding de dirigeants, notamment sur LinkedIn.',
      'Newsletters et campagnes emailing.',
      'Production de contenus pour des podcasts.',
      "Marque employeur : valoriser les équipes et la culture d'entreprise.",
      'Pour des PME et des groupes internationaux.',
    ],
  },
  {
    when: '2024 à 2025, Bruxelles', title: 'Socialsky', where: 'Community Manager Gen Z, CDD puis CDI',
    points: [
      'Stratégie social media et angles éditoriaux adaptés à chaque marque.',
      'Calendriers de contenu et temps forts.',
      'Rédaction et vidéos courtes, du tournage au montage.',
      'Animation, modération, commentaires et messages.',
      'Pour des enseignes nationales et des groupes internationaux.',
    ],
  },
  {
    when: '2025 à 2027', title: 'Kontnu', where: 'Business Development puis Digital Marketing Manager',
    points: [
      'Acquisition de commerçants et de créateurs en Belgique et en France.',
      'Calendrier éditorial Instagram, TikTok et LinkedIn, en FR, EN et NL.',
      'Reels et TikToks : conception, tournage, montage.',
      'Campagnes Meta : ciblage et répartition du budget.',
      'Influence : créateurs ambassadeurs, briefs et suivi.',
    ],
  },
  {
    when: 'Kontnu, suite', title: 'Business et équipe', where: 'Du terrain au reporting',
    points: [
      'Prospection, rendez-vous, signature et onboarding des commerçants.',
      'Communautés de commerçants et de créateurs sur Instagram et WhatsApp.',
      'Événement des 15 000 collaborations, puis suivi des retombées et des leads.',
      "Recrutement et encadrement d'un stagiaire.",
      "IA générative et vibe coding pour produire plus vite et prototyper des outils.",
    ],
  },
  {
    when: 'En résumé', title: "Ce que j'apporte", where: 'Agence, startup et terrain',
    points: [
      'Stratégie social media et acquisition',
      'Création de contenu et vidéo courte',
      'Community management',
      'Campagnes Meta et marketing d\'influence',
      'Business development et CRM',
      'IA et optimisation du travail',
    ],
  },
];
const leaves = [
  { front: null, back: entries[0] },
  { front: entries[1], back: entries[2] },
  { front: entries[3], back: entries[4] },
  { front: entries[5], back: entries[6] },
];
---

<section class="scene book-scene" data-theme="cream" data-scene data-book aria-label="Mon parcours" id="parcours">
  <div class="scene__sticky book-scene__sticky">
    <div class="orbs" aria-hidden="true">
      <span class="orb orb--sage" style="width:640px;height:640px;left:-180px;top:-120px;--d:26s"></span>
      <span class="orb orb--champagne" style="width:560px;height:560px;right:-140px;bottom:-200px;opacity:.6;--d:30s"></span>
    </div>

    <div class="container book-scene__head">
      <p class="eyebrow">Mon parcours</p>
      <h2>Des agences <em>à l'entrepreneuriat</em></h2>
    </div>

    <div class="book-wrap" aria-hidden="true">
      <div class="book" data-book-el>
        <div class="book__page book__page--left">
          <div class="book__blank"><span>SAGE</span></div>
        </div>
        <div class="book__page book__page--right">
          <div class="book__end">
            <p class="cv__when">2027</p>
            <p>SAGE<br /><em>creative studio.</em></p>
            <p class="cv__text">Et la prochaine page, on l'écrit ensemble.</p>
          </div>
        </div>
        {
          leaves.map((l, i) => (
            <div class="leaf" data-leaf style={`z-index:${leaves.length - i}`}>
              <div class="leaf__face leaf__front">
                {l.front === null ? (
                  <div class="cover">
                    <span class="cover__print" aria-hidden="true">Mon<br />par<br />cours</span>
                    <span class="cover__brand">SAGE</span>
                    <span class="cover__title">Mon parcours</span>
                    <span class="cover__sub">Julie Mordant</span>
                  </div>
                ) : (
                  <article class:list={['cv', { 'cv--todo': l.front.todo }]}>
                    <p class="cv__when">{l.front.when}</p>
                    <h3 class="cv__title">{l.front.title}</h3>
                    <p class="cv__where">{l.front.where}</p>
                    {l.front.text && <p class="cv__text">{l.front.text}</p>}
                    {l.front.points && <ul class="cv__list">{l.front.points.map((pt) => <li>{pt}</li>)}</ul>}
                    <span class="cv__n">{i * 2}</span>
                  </article>
                )}
              </div>
              <div class="leaf__face leaf__back">
                <article class:list={['cv', { 'cv--todo': l.back.todo }]}>
                  <p class="cv__when">{l.back.when}</p>
                  <h3 class="cv__title">{l.back.title}</h3>
                  <p class="cv__where">{l.back.where}</p>
                  {l.back.text && <p class="cv__text">{l.back.text}</p>}
                    {l.back.points && <ul class="cv__list">{l.back.points.map((pt) => <li>{pt}</li>)}</ul>}
                  <span class="cv__n">{i * 2 + 1}</span>
                </article>
              </div>
            </div>
          ))
        }
      </div>
    </div>
    <SceneNav steps={5} label="Faites défiler pour tourner les pages" />
  </div>
</section>

<script>
  const scene = document.querySelector<HTMLElement>('[data-book]');
  if (scene) {
    const book = scene.querySelector<HTMLElement>('[data-book-el]')!;
    const leaves = [...scene.querySelectorAll<HTMLElement>('[data-leaf]')];
    const n = leaves.length;
    const clamp = (x: number) => Math.min(1, Math.max(0, x));
    const render = (p: number) => {
      // ouverture de la couverture puis pages, chacune sur une tranche du défilement
      const span = 0.8 / n;
      leaves.forEach((leaf, i) => {
        const t = clamp((p - 0.08 - i * span) / (span * 0.85));
        const e = t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2;
        leaf.style.transform = `rotateY(${-180 * e}deg)`;
        leaf.style.zIndex = String(e > 0.5 ? 10 + i : n - i);
      });
      const open = clamp((p - 0.08) / (span * 0.85));
      book.style.setProperty('--open', String(open));
    };
    render(0);
    // Liens « /#parcours-N » (menu) : ouvre le livre à la double page N
    const goTo = (k: number, smooth = true) => {
      const span = 0.8 / n;
      const p = 0.08 + (k - 1) * span + span * 0.97;
      const y = scene.offsetTop + (scene.offsetHeight - innerHeight) * p;
      const lenis = (window as any).__lenis;
      if (lenis) lenis.scrollTo(y, { immediate: !smooth, duration: 1.6 });
      else window.scrollTo({ top: y, behavior: smooth ? 'smooth' : 'auto' });
    };
    const fromHash = (h: string) => { const m = /^#parcours-(\d)$/.exec(h); return m ? Number(m[1]) : 0; };
    document.addEventListener('click', (e) => {
      const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href*="#parcours-"]');
      if (!a || a.pathname !== location.pathname) return;
      const k = fromHash(a.hash);
      if (!k) return;
      e.preventDefault();
      history.replaceState(null, '', a.hash);
      goTo(k);
    });
    const k0 = fromHash(location.hash);
    if (k0) window.addEventListener('load', () => setTimeout(() => goTo(k0, false), 60));
    window.addEventListener('hashchange', () => { const k = fromHash(location.hash); if (k) goTo(k); });
    scene.addEventListener('scene', (e) => render((e as CustomEvent<number>).detail));
  }
</script>

<style>
  .book-scene {
    height: 440vh;
  }
  .book-scene__sticky {
    display: grid;
    grid-template-rows: auto 1fr auto;
    padding-top: clamp(96px, 13vh, 140px);
    padding-bottom: 28px;
  }
  .book-scene__head {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 1rem;
  }
  .book-scene__head h2 {
    font-size: clamp(2.2rem, 4.6vw, 4rem);
  }
  .book-wrap {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    perspective: 2400px;
  }
  .book {
    --w: min(32vw, 46vh, 440px);
    --open: 0;
    position: relative;
    width: calc(var(--w) * 2);
    height: calc(var(--w) * 1.32);
    transform-style: preserve-3d;
    transform: translateX(calc(var(--w) * -0.5 * (1 - var(--open)))) rotateX(calc(14deg * (1 - var(--open)) + 6deg));
    transition: transform 0.1s linear;
  }
  .book__page {
    position: absolute;
    top: 0;
    width: 50%;
    height: 100%;
    background: var(--white);
    box-shadow: var(--shadow);
  }
  .book__page--left {
    left: 0;
    border-radius: 14px 4px 4px 14px;
    opacity: calc(var(--open) * 3);
    background: linear-gradient(90deg, #eeeae6, var(--white) 85%, #e3ddd8);
  }
  .book__page--right {
    right: 0;
    border-radius: 4px 14px 14px 4px;
    background: linear-gradient(90deg, #e3ddd8, var(--white) 15%, #eeeae6);
  }
  .book__blank,
  .book__end {
    height: 100%;
    display: grid;
    place-items: center;
    text-align: center;
  }
  .book__blank span {
    font: 300 2.4rem var(--font-display);
    font-stretch: 125%;
    letter-spacing: -0.04em;
    color: var(--carmine);
  }
  .book__end p {
    font: 560 clamp(1.3rem, 2.2vw, 2rem) / 1 var(--font-display);
    letter-spacing: -0.05em;
    color: #161213;
  }
  .book__end em {
    font-style: normal;
    font-stretch: 125%;
    font-weight: 300;
    color: var(--carmine);
  }
  .leaf {
    position: absolute;
    top: 0;
    right: 0;
    width: 50%;
    height: 100%;
    transform-origin: left center;
    transform-style: preserve-3d;
  }
  .leaf__face {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    background: var(--white);
    overflow: hidden;
  }
  .leaf__front {
    border-radius: 4px 14px 14px 4px;
  }
  .leaf__back {
    transform: rotateY(180deg);
    border-radius: 14px 4px 4px 14px;
  }
  .leaf figure {
    margin: 0;
    height: 100%;
    padding: 9%;
    display: grid;
    grid-template-rows: 1fr auto;
    gap: 0.8rem;
  }
  .leaf figure img {
    width: 100%;
    height: 100%;
    border-radius: 6px;
  }
  .leaf figcaption {
    font: 500 1rem var(--font-display);
    color: var(--eucalyptus);
  }
  .cover {
    height: 100%;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.6rem;
    position: relative;
    overflow: hidden;
    background: radial-gradient(120% 90% at 30% 20%, #6e1628, var(--wine) 60%, #470b18);
    color: #f6ecec;
    box-shadow: inset 6px 0 12px -6px rgb(0 0 0 / 0.5);
  }
  .cover__brand {
    position: relative;
    font: 650 0.8rem var(--font-display);
    font-stretch: 125%;
    letter-spacing: 0.2em;
    padding-left: 0.2em;
    opacity: 0.85;
  }
  .cover__title {
    position: relative;
    font: 300 clamp(2rem, 3.4vw, 3.2rem) / 1 var(--font-display);
    font-stretch: 125%;
    letter-spacing: -0.05em;
    color: var(--blush);
  }
  .cover__sub {
    position: relative;
    font: 500 0.85rem var(--font-display);
    opacity: 0.7;
  }
  .book-scene__note {
    position: relative;
    z-index: 1;
    text-align: center;
    font-size: 0.75rem;
    color: rgb(43 52 47 / 0.5);
  }
  .cover__print {
    position: absolute;
    inset: -4% -10%;
    display: grid;
    align-content: center;
    font: 850 clamp(4rem, 9vw, 8rem) / 0.78 var(--font-display);
    font-stretch: 75%;
    text-transform: uppercase;
    letter-spacing: -0.04em;
    color: #7a1a2f;
    opacity: 0.9;
  }
  .book-scene { background: var(--paper); }
  .cv { position: relative; height: 100%; display: grid; align-content: center; gap: 0.7rem; padding: 12%; color: #161213; }
  .cv__when { font: 650 clamp(0.66rem, 0.9vw, 0.76rem) var(--font-ui); font-stretch: 125%; text-transform: uppercase; letter-spacing: 0.04em; color: var(--carmine); }
  .cv__title { font-size: clamp(1.4rem, 2.4vw, 2.1rem); color: #161213; letter-spacing: -0.05em; }
  .cv__where { font-weight: 600; font-size: 0.92rem; }
  .cv__text { font-size: 0.9rem; color: rgb(26 26 26 / 0.72); line-height: 1.5; }
  .cv__list { list-style: none; margin: 0.2rem 0 0; padding: 0; display: grid; gap: 0.45rem; font-size: 0.84rem; line-height: 1.4; color: rgb(26 26 26 / 0.74); }
  .cv__list li { margin: 0; }
  .cv--todo .cv__text { font-style: italic; color: rgb(26 26 26 / 0.45); }
  .cv__n { position: absolute; bottom: 7%; right: 10%; font: 300 0.9rem var(--font-ui); font-stretch: 125%; color: rgb(22 18 19 / 0.35); }
  .book__end { gap: 0.6rem; padding: 12%; align-content: center; overflow: hidden; }
  .book__page { overflow: hidden; }
  .book__end p.cv__when { font: 650 0.76rem var(--font-ui) !important; font-stretch: 125% !important; letter-spacing: 0.04em; color: var(--carmine); }
  .book__end p.cv__text { font: 400 0.9rem/1.5 var(--font-ui) !important; color: rgb(26 26 26 / 0.7); }
  .book__end .cv__text { margin-top: 0.4rem; }
  @media (max-width: 760px) {
    .book {
      --w: 46vw;
      height: calc(var(--w) * 2.55);
    }
    .cv { padding: 10% 9%; gap: 0.4rem; }
    .cv__title { font-size: 1.05rem; }
    .cv__where, .cv__text { font-size: 0.74rem; line-height: 1.32; }
    .cv__list { font-size: 0.71rem; line-height: 1.3; gap: 0.38rem; }
    .cv__title { font-size: 1.1rem !important; }
    .cv__n { display: none; }
    .cv__when { font-size: 0.8rem; }
    .book__end { padding: 10% 9%; }
    .book__end p { font-size: 1rem !important; }
    .cover__title { font-size: 1.4rem; }
  }
  @media (min-width: 761px) and (max-width: 1180px) {
    .book {
      --w: min(41vw, 44vh, 380px);
      height: calc(var(--w) * 1.4);
    }
    .cv { padding: 9% 9%; gap: 0.45rem; }
    .cv__title { font-size: 1.3rem; }
    .cv__when { font-size: 0.95rem; }
    .cv__where { font-size: 0.8rem; }
    .cv__list { font-size: 0.74rem; line-height: 1.32; gap: 0.32rem; }
    .cv__n { display: none; }
  }
</style>
