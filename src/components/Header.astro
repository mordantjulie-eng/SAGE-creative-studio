---
import Logo from './Logo.astro';
import { nav } from '../config/site';
---

<header class="header">
  <div class="header__bar glassdrop">
    <a href="/" class="header__home" aria-label="Accueil"><Logo /></a>

    <nav id="menu" class="header__nav" aria-label="Navigation principale">
      <ul>
        {
          nav.map((item) =>
            item.children && item.children.length ? (
              <li class="has-sub">
                <a href={item.href} aria-haspopup="true">
                  {item.label}
                  <svg class="chev" viewBox="0 0 12 12" width="10" height="10" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </a>
                <div class="sub">
                  <ul>
                    {item.children.map((c) => (
                      <li>
                        <a href={c.href}>
                          <span class="sub__l">{c.label}</span>
                          {c.hint && <span class="sub__h">{c.hint}</span>}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </li>
            ) : (
              <li><a href={item.href}>{item.label}</a></li>
            ),
          )
        }
      </ul>
    </nav>

    <a href="/#contact" class="header__cta">Parlons projet</a>

    <button class="header__toggle" aria-expanded="false" aria-controls="menu">
      <span class="sr-only">Menu</span>
      <span class="bar"></span><span class="bar"></span>
    </button>
  </div>
</header>

<script>
  const header = document.querySelector('.header');
  const toggle = document.querySelector<HTMLButtonElement>('.header__toggle');
  const menu = document.getElementById('menu');
  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 30);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    header?.classList.toggle('is-open', !open);
  });
  menu?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      toggle?.setAttribute('aria-expanded', 'false');
      header?.classList.remove('is-open');
    }),
  );
</script>

<style>
  /* Barre flottante en « goutte » de verre liquide, façon nouvelle interface Apple */
  .header {
    position: fixed;
    top: 14px;
    left: 0;
    right: 0;
    z-index: 50;
    padding-inline: var(--gutter);
    color: var(--ink);
    pointer-events: none;
  }
  .header__bar.glassdrop {
    position: relative;
    pointer-events: auto;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.26);
    backdrop-filter: blur(14px) saturate(1.9) brightness(1.04);
    -webkit-backdrop-filter: blur(14px) saturate(1.9) brightness(1.04);
    box-shadow:
      inset 0 1px 1px rgb(255 255 255 / 0.9),
      inset 0 -1px 1px rgb(255 255 255 / 0.35),
      inset 0 0 0 1px rgb(255 255 255 / 0.32),
      inset 0 -14px 24px -18px rgb(255 255 255 / 0.7),
      inset 0 12px 20px -16px rgb(0 0 0 / 0.08),
      0 12px 32px -14px rgb(0 0 0 / 0.22),
      0 2px 6px -2px rgb(0 0 0 / 0.08);
    transition: background 0.5s var(--ease), box-shadow 0.5s var(--ease), padding 0.4s var(--ease);
  }
  /* reflet spéculaire en haut à gauche, comme une goutte */
  .header__bar.glassdrop::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    background:
      radial-gradient(120% 140% at 12% -30%, rgb(255 255 255 / 0.55), transparent 45%),
      radial-gradient(80% 120% at 92% 130%, rgb(255 255 255 / 0.28), transparent 50%);
    mix-blend-mode: soft-light;
  }
  .header.is-scrolled .header__bar.glassdrop { background: rgb(255 255 255 / 0.4); }
  /* Sur les sections foncées, la goutte se teinte */
  :global(body[data-theme='sage']) .header,
  :global(body[data-theme='charcoal']) .header {
    color: #f6ecec;
  }
  :global(body[data-theme='sage']) .header__bar.glassdrop {
    background: rgb(90 15 31 / 0.74) !important;
  }
  :global(body[data-theme='charcoal']) .header__bar.glassdrop {
    background: rgb(34 6 12 / 0.74) !important;
  }
  :global(body[data-theme='sage']) .header__bar.glassdrop,
  :global(body[data-theme='charcoal']) .header__bar.glassdrop {
    box-shadow:
      inset 0 1px 1px rgb(255 255 255 / 0.45),
      inset 0 -1px 1px rgb(255 255 255 / 0.15),
      inset 0 0 0 1px rgb(255 255 255 / 0.14),
      inset 0 -14px 24px -18px rgb(255 255 255 / 0.25),
      0 14px 34px -14px rgb(0 0 0 / 0.5);
  }
  :global(body[data-theme='sage']) .header__home,
  :global(body[data-theme='charcoal']) .header__home {
    color: var(--blush);
  }
  :global(body[data-theme='taupe']) .header.is-scrolled {
    background: rgb(205 189 242 / 0.75);
  }
  .header__bar {
    max-width: 1080px;
    margin-inline: auto;
    padding: 8px 8px 8px 24px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    transition: padding 0.4s var(--ease);
  }
  .header__home {
    justify-self: start;
    text-decoration: none;
    color: var(--choco);
  }
  .header__nav ul {
    display: flex;
    gap: 0.1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .header__nav a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.5rem 0.9rem;
    font-size: 0.8rem;
    font-weight: 600;
    font-stretch: 118%;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: var(--pill);
    transition: color 0.3s var(--ease), background 0.3s var(--ease);
  }
  .header__nav > ul > li > a:hover {
    color: var(--rasp);
  }
  .has-sub {
    position: relative;
  }
  .chev {
    transition: transform 0.3s var(--ease);
  }
  .has-sub:hover .chev,
  .has-sub:focus-within .chev {
    transform: rotate(180deg);
  }
  .sub {
    position: absolute;
    top: calc(100% + 14px);
    left: 50%;
    width: 360px;
    padding: 0.5rem;
    border-radius: var(--r);
    background: var(--white);
    box-shadow: 0 40px 70px -30px rgb(34 6 12 / 0.45), 0 0 0 1px rgb(22 18 19 / 0.06);
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, -6px);
    transition: opacity 0.25s var(--ease), transform 0.35s var(--ease-out), visibility 0.25s;
  }
  .sub::before {
    content: '';
    position: absolute;
    inset: -16px 0 auto 0;
    height: 16px;
  }
  .has-sub:hover .sub,
  .has-sub:focus-within .sub {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
  }
  .sub ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2px;
  }
  .header__nav .sub a {
    display: grid;
    gap: 0.1rem;
    padding: 0.7rem 0.9rem;
    border-radius: 12px;
    text-transform: none;
    letter-spacing: -0.01em;
    font-stretch: 100%;
    color: var(--ink);
  }
  .header__nav .sub a:hover {
    background: var(--choco);
    color: #f6ecec;
  }
  .sub__l {
    font-weight: 600;
    font-size: 0.95rem;
    white-space: pre;
  }
  .sub__h {
    font-size: 0.78rem;
    font-weight: 400;
    opacity: 0.65;
    line-height: 1.35;
  }
  .header__cta {
    justify-self: end;
    padding: 0.85rem 1.35rem;
    border-radius: var(--pill);
    background: var(--rasp);
    color: var(--white);
    font-weight: 600;
    font-size: 0.82rem;
    font-stretch: 112%;
    text-decoration: none;
  }
  .header__toggle {
    display: none;
  }

  @media (max-width: 1080px) and (min-width: 821px) {
    .header__nav a { padding: 0.5rem 0.6rem; font-size: 0.74rem; }
    .header__cta { padding: 0.75rem 1rem; font-size: 0.78rem; }
    .has-sub:last-child .sub { left: auto; right: 0; transform: translate(0, -6px); }
    .has-sub:last-child:hover .sub, .has-sub:last-child:focus-within .sub { transform: none; }
  }

  @media (max-width: 820px) {
    .header__bar { grid-template-columns: 1fr auto auto; }
    .header__nav {
      position: absolute;
      top: calc(100% + 10px);
      left: 0;
      right: 0;
      padding: 1rem 1.4rem 1.6rem;
      border-radius: 28px;
      background: rgb(248 246 243 / 0.97);
      backdrop-filter: blur(22px) saturate(1.6);
      -webkit-backdrop-filter: blur(22px) saturate(1.6);
      color: var(--ink);
      z-index: 60;
      box-shadow: 0 30px 50px -30px rgb(34 6 12 / 0.4);
      opacity: 0;
      transform: translateY(-8px);
      pointer-events: none;
      max-height: calc(100svh - 80px);
      overflow-y: auto;
      transition: opacity 0.3s var(--ease), transform 0.4s var(--ease-out);
    }
    .header.is-open .header__nav { opacity: 1; transform: none; pointer-events: auto; }
    .header__nav ul { flex-direction: column; }
    .sub {
      position: static;
      width: auto;
      padding: 0 0 0.6rem 0;
      background: none;
      box-shadow: none;
      opacity: 1;
      visibility: visible;
      transform: none;
    }
    .has-sub:hover .sub, .has-sub:focus-within .sub { transform: none; }
    .header__nav .sub a { font-size: 0.95rem; font-weight: 450; padding: 0.3rem 0; }
    .sub__h, .chev { display: none; }
    .header__nav > ul > li { border-top: 1px solid var(--hair); padding-top: 0.6rem; }
    .header__nav > ul > li > a {
      font-size: 2.2rem;
      font-weight: 560;
      font-stretch: 100%;
      letter-spacing: -0.05em;
      text-transform: none;
      padding: 0.1rem 0 0.4rem;
    }
    .header__cta { padding: 0.7rem 1rem; }
    .header__toggle {
      display: grid;
      gap: 6px;
      width: 44px;
      height: 44px;
      place-content: center;
      border-radius: 50%;
      background: rgb(22 18 19 / 0.06);
      border: 0;
      color: inherit;
      cursor: pointer;
    }
    .bar { display: block; width: 18px; height: 1.5px; background: currentColor; transition: transform 0.3s var(--ease); }
    .header.is-open .bar:first-of-type { transform: translateY(3.75px) rotate(45deg); }
    .header.is-open .bar:last-of-type { transform: translateY(-3.75px) rotate(-45deg); }
  }
  @media (max-width: 420px) {
    .header__cta { display: none; }
  }
</style>
