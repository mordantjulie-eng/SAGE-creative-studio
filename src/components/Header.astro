---
import Logo from './Logo.astro';
import { nav } from '../config/site';
---

<header class="header">
  <div class="header__bar">
    <a href="/" class="header__home" aria-label="Accueil"><Logo /></a>

    <nav id="menu" class="header__nav" aria-label="Navigation principale">
      <ul>
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>

    <a href="/#contact" class="header__cta">Parlons projet</a>

    <button class="header__toggle" aria-expanded="false" aria-controls="menu">
      <span class="sr-only">Menu</span>
      <span class="bar"></span><span class="bar"></span>
    </button>
  </div>
</header>

<script>
  const header = document.querySelector('.header');
  const toggle = document.querySelector<HTMLButtonElement>('.header__toggle');
  const menu = document.getElementById('menu');
  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 30);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    header?.classList.toggle('is-open', !open);
  });
  menu?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      toggle?.setAttribute('aria-expanded', 'false');
      header?.classList.remove('is-open');
    }),
  );
</script>

<style>
  .header {
    position: fixed;
    top: 16px;
    left: 0;
    right: 0;
    z-index: 50;
    padding-inline: var(--gutter);
    pointer-events: none;
  }
  .header__bar {
    pointer-events: auto;
    max-width: 1120px;
    margin-inline: auto;
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 8px 8px 8px 26px;
    border-radius: var(--pill);
    background: rgb(246 243 238 / 0.45);
    border: 1px solid rgb(255 255 255 / 0.6);
    backdrop-filter: blur(20px) saturate(1.4);
    -webkit-backdrop-filter: blur(20px) saturate(1.4);
    color: var(--ink);
    transition:
      background 0.4s var(--ease),
      box-shadow 0.4s var(--ease);
  }
  .header.is-scrolled .header__bar {
    background: rgb(246 243 238 / 0.72);
    box-shadow: var(--shadow-s);
  }
  .header__home {
    text-decoration: none;
    margin-right: auto;
  }
  .header__nav ul {
    display: flex;
    gap: 0.2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .header__nav a {
    display: block;
    padding: 0.55rem 1rem;
    border-radius: var(--pill);
    font-size: 0.92rem;
    text-decoration: none;
    transition: background 0.3s var(--ease);
  }
  .header__nav a:hover {
    background: rgb(255 255 255 / 0.6);
  }
  .header__cta {
    padding: 0.85rem 1.4rem;
    border-radius: var(--pill);
    background: var(--moss);
    color: var(--cream);
    font-weight: 500;
    font-size: 0.9rem;
    text-decoration: none;
    transition: background 0.3s var(--ease);
  }
  .header__cta:hover {
    background: var(--ink);
  }
  .header__toggle {
    display: none;
  }

  @media (max-width: 860px) {
    .header__nav {
      position: absolute;
      top: calc(100% + 10px);
      left: var(--gutter);
      right: var(--gutter);
      padding: 1rem;
      border-radius: var(--r);
      background: rgb(246 243 238 / 0.85);
      border: 1px solid rgb(255 255 255 / 0.7);
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
      box-shadow: var(--shadow);
      opacity: 0;
      transform: translateY(-8px);
      pointer-events: none;
      transition:
        opacity 0.3s var(--ease),
        transform 0.4s var(--ease-out);
    }
    .header.is-open .header__nav {
      opacity: 1;
      transform: none;
      pointer-events: auto;
    }
    .header__nav ul {
      flex-direction: column;
    }
    .header__nav a {
      font-family: var(--font-serif);
      font-size: 1.9rem;
      font-weight: 850;
      padding: 0.35rem 0.8rem;
    }
    .header__cta {
      padding: 0.75rem 1.1rem;
    }
    .header__toggle {
      display: grid;
      gap: 6px;
      width: 46px;
      height: 46px;
      place-content: center;
      border-radius: 50%;
      background: rgb(255 255 255 / 0.55);
      border: 0;
      color: inherit;
      cursor: pointer;
    }
    .bar {
      display: block;
      width: 18px;
      height: 1.5px;
      background: currentColor;
      transition: transform 0.3s var(--ease);
    }
    .header.is-open .bar:first-of-type {
      transform: translateY(3.75px) rotate(45deg);
    }
    .header.is-open .bar:last-of-type {
      transform: translateY(-3.75px) rotate(-45deg);
    }
  }
  @media (max-width: 420px) {
    .header__cta {
      display: none;
    }
  }
</style>
