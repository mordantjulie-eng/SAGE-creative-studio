---
import Logo from './Logo.astro';
import { nav } from '../config/site';
---

<header class="header">
  <div class="header__bar">
    <a href="/" class="header__home" aria-label="Accueil">
      <Logo />
    </a>

    <nav id="menu" class="header__nav" aria-label="Navigation principale">
      <ul>
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>

    <a href="/#contact" class="header__cta">
      Discutons
      <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 10 10 2M4 2h6v6" fill="none" stroke="currentColor" stroke-width="1.8"></path></svg>
    </a>

    <button class="header__toggle" aria-expanded="false" aria-controls="menu">
      <span class="sr-only">Menu</span>
      <span class="bar"></span><span class="bar"></span>
    </button>
  </div>
</header>

<script>
  const header = document.querySelector('.header');
  const toggle = document.querySelector<HTMLButtonElement>('.header__toggle');
  const menu = document.getElementById('menu');
  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 40);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    header?.classList.toggle('is-open', !open);
  });
  menu?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      toggle?.setAttribute('aria-expanded', 'false');
      header?.classList.remove('is-open');
    }),
  );
</script>

<style>
  .header {
    position: fixed;
    top: 14px;
    left: 0;
    right: 0;
    z-index: 50;
    padding-inline: var(--gutter);
    pointer-events: none;
  }
  .header__bar {
    pointer-events: auto;
    max-width: 1100px;
    margin-inline: auto;
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 8px 8px 8px 24px;
    border-radius: var(--pill);
    background: rgb(31 58 46 / 0.72);
    color: var(--sage-ivory);
    backdrop-filter: blur(14px) saturate(1.2);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    border: 1px solid rgb(231 226 216 / 0.14);
    transition:
      background 0.3s var(--ease),
      box-shadow 0.3s var(--ease);
  }
  .header.is-scrolled .header__bar {
    background: rgb(31 58 46 / 0.92);
    box-shadow: var(--shadow);
  }
  .header__home {
    text-decoration: none;
    margin-right: auto;
  }
  .header__nav ul {
    display: flex;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .header__nav a {
    display: block;
    padding: 0.55rem 1rem;
    border-radius: var(--pill);
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.2s var(--ease);
  }
  .header__nav a:hover {
    background: rgb(231 226 216 / 0.14);
  }
  .header__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.8rem 1.3rem;
    border-radius: var(--pill);
    background: var(--sage-ivory);
    color: var(--sage-forest);
    font-weight: 800;
    font-size: 0.92rem;
    text-decoration: none;
    transition: transform 0.35s var(--spring);
  }
  .header__cta:hover {
    transform: scale(1.06) rotate(-2deg);
  }
  .header__toggle {
    display: none;
  }

  @media (max-width: 860px) {
    .header__nav {
      position: absolute;
      top: calc(100% + 8px);
      left: var(--gutter);
      right: var(--gutter);
      padding: 1rem;
      border-radius: var(--radius);
      background: var(--sage-forest);
      color: var(--sage-ivory);
      box-shadow: var(--shadow);
      opacity: 0;
      transform: translateY(-10px) scale(0.97);
      pointer-events: none;
      transition:
        opacity 0.25s var(--ease),
        transform 0.35s var(--spring);
    }
    .header.is-open .header__nav {
      opacity: 1;
      transform: none;
      pointer-events: auto;
    }
    .header__nav ul {
      flex-direction: column;
    }
    .header__nav a {
      font-family: var(--font-display);
      font-weight: 800;
      font-size: 2.2rem;
      letter-spacing: -0.03em;
      padding: 0.4rem 0.8rem;
    }
    .header__cta {
      padding: 0.7rem 1rem;
    }
    .header__toggle {
      display: grid;
      gap: 6px;
      width: 46px;
      height: 46px;
      place-content: center;
      border-radius: 50%;
      background: rgb(231 226 216 / 0.14);
      border: 0;
      color: inherit;
      cursor: pointer;
    }
    .bar {
      display: block;
      width: 20px;
      height: 2px;
      background: currentColor;
      transition: transform 0.25s var(--ease);
    }
    .header.is-open .bar:first-of-type {
      transform: translateY(4px) rotate(45deg);
    }
    .header.is-open .bar:last-of-type {
      transform: translateY(-4px) rotate(-45deg);
    }
  }
</style>
