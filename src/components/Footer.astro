---
import Logo from './Logo.astro';
import { brand, nav } from '../config/site';
const year = new Date().getFullYear();
---

<footer class="footer on-dark">
  <div class="orbs" aria-hidden="true">
    <span class="orb orb--champagne" style="width:520px;height:520px;right:-120px;top:-160px;opacity:.35;--d:26s"></span>
    <span class="orb orb--mist" style="width:600px;height:600px;left:-200px;bottom:-260px;opacity:.25;--d:30s"></span>
  </div>
  <div class="container footer__top">
    <p class="footer__claim">Creative thinking.<br /><em>Digital impact.</em></p>
    <div class="footer__cols">
      <ul class="footer__nav">
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        <li><a href="/#contact">Contact</a></li>
      </ul>
      <div class="footer__meta">
        <a href={`mailto:${brand.email}`}>{brand.email}</a>
        <span>{brand.location}</span>
      </div>
    </div>
  </div>
  <div class="footer__logo"><Logo size="xl" withDescriptor /></div>
  <div class="container footer__bottom">
    <span>© {year} {brand.name} {brand.descriptor}</span>
    <span>Think. Create. Grow. Evolve.</span>
    <!-- À ajouter avant mise en ligne : mentions légales (n° BCE), confidentialité, cookies -->
  </div>
</footer>

<style>
  .footer {
    position: relative;
    overflow: hidden;
    background: var(--grad-dark);
    color: var(--cream);
    padding-top: clamp(72px, 9vw, 120px);
    border-radius: var(--r-l) var(--r-l) 0 0;
  }
  .footer > :not(.orbs) {
    position: relative;
    z-index: 1;
  }
  .footer__top {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 3rem;
  }
  .footer__claim {
    font: 300 clamp(2rem, 4vw, 3.2rem) / 1.05 var(--font-serif);
    letter-spacing: -0.02em;
  }
  .footer__claim em {
    color: var(--champagne);
  }
  .footer__cols {
    display: flex;
    gap: clamp(2rem, 6vw, 6rem);
  }
  .footer__nav {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
  }
  .footer a {
    text-decoration: none;
    opacity: 0.85;
    transition: opacity 0.3s var(--ease);
  }
  .footer a:hover {
    opacity: 1;
  }
  .footer__meta {
    display: grid;
    gap: 0.4rem;
    align-content: start;
    opacity: 0.85;
  }
  .footer__logo {
    display: flex;
    justify-content: center;
    padding-block: clamp(56px, 8vw, 110px) clamp(32px, 4vw, 56px);
    color: rgb(246 243 238 / 0.92);
  }
  .footer__bottom {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding-block: 1.6rem;
    border-top: 1px solid rgb(255 255 255 / 0.14);
    font-size: 0.8rem;
    opacity: 0.65;
  }
</style>
