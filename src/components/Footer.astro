---
import Logo from './Logo.astro';
import { brand, nav } from '../config/site';
const year = new Date().getFullYear();
---

<footer class="footer on-dark">
  <div class="container footer__top">
    <ul class="footer__nav">
      {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      <li><a href="/#contact">Contact</a></li>
    </ul>
    <div class="footer__meta">
      <a href={`mailto:${brand.email}`}>{brand.email}</a>
      <span>{brand.location}</span>
    </div>
  </div>
  <div class="footer__logo">
    <Logo size="xl" withDescriptor orbit />
  </div>
  <div class="container footer__bottom">
    <span>© {year} {brand.name} {brand.descriptor}</span>
    <span>Photos : Unsplash (illustration)</span>
    <!-- À ajouter avant mise en ligne : mentions légales (n° BCE), confidentialité, cookies -->
  </div>
</footer>

<style>
  .footer {
    background: var(--sage-forest);
    color: var(--sage-ivory);
    padding-top: clamp(56px, 8vw, 96px);
    border-radius: var(--radius-l) var(--radius-l) 0 0;
    margin-top: -1px;
    overflow: hidden;
  }
  .footer__top {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 2rem;
  }
  .footer__nav {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .footer__nav a {
    display: block;
    padding: 0.6rem 1.1rem;
    border: 1px solid rgb(231 226 216 / 0.3);
    border-radius: var(--pill);
    text-decoration: none;
    font-weight: 600;
    transition:
      background 0.2s var(--ease),
      color 0.2s var(--ease);
  }
  .footer__nav a:hover {
    background: var(--sage-ivory);
    color: var(--sage-forest);
  }
  .footer__meta {
    display: grid;
    gap: 0.3rem;
    text-align: right;
  }
  .footer__meta a {
    font-weight: 700;
    text-decoration: none;
  }
  .footer__logo {
    display: flex;
    justify-content: center;
    padding-block: clamp(48px, 8vw, 96px) clamp(24px, 4vw, 48px);
  }
  .footer__bottom {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding-block: 1.5rem;
    border-top: 1px solid rgb(231 226 216 / 0.15);
    font-size: 0.8rem;
    opacity: 0.7;
  }
  @media (max-width: 640px) {
    .footer__meta {
      text-align: left;
    }
  }
</style>
