---
import PressedLogo from './PressedLogo.astro';
import { brand, nav } from '../config/site';
const year = new Date().getFullYear();
---

<footer class="footer" data-theme="charcoal">
  <div class="container">
    <div class="meta footer__meta" style="--cols:4">
      <p><b>{brand.name} {brand.descriptor}</b><span>Studio créatif et digital</span></p>
      <p><b>{brand.location}</b><span>Lancement 2027</span></p>
      <p><b>Écrire</b><a href={`mailto:${brand.email}`}>{brand.email}</a></p>
      <p><b>Philosophie</b><span class="split"><span>Think.</span><span>Create.</span><span>Grow.</span><span>Evolve.</span></span></p>
    </div>

    <div class="footer__mid">
      <p class="footer__claim">Creative thinking.<br /><em>Digital impact.</em></p>
      <ul class="footer__nav">
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        <li><a href="/#contact">Contact</a></li>
      </ul>
    </div>
  </div>

  <div class="footer__logo" aria-hidden="true"><PressedLogo class="footer__emboss" ink="#0b0f30" shade="#000000" light="#2a3480" rim={false} /></div>

  <div class="container footer__bottom">
    <span>© {year} {brand.name} {brand.descriptor}</span>
    <a href="#top">Retour en haut</a>
    <!-- À ajouter avant mise en ligne : mentions légales (n° BCE), confidentialité, cookies -->
  </div>
</footer>

<style>
  .footer {
    position: relative;
    overflow: hidden;
    background: var(--choco-deep);
    color: #f5f3ee;
    padding-top: clamp(56px, 7vw, 96px);
  }
  .footer__meta {
    color: rgb(245 243 238 / 0.85);
    border-color: rgb(245 243 238 / 0.25);
  }
  .footer__meta a {
    text-decoration: none;
    opacity: 0.7;
  }
  .footer__mid {
    display: flex;
    justify-content: space-between;
    align-items: end;
    flex-wrap: wrap;
    gap: 3rem;
    padding-top: clamp(56px, 8vw, 110px);
  }
  .footer__claim {
    font-size: clamp(2.4rem, 5vw, 4.6rem);
    font-weight: 560;
    line-height: 0.95;
    letter-spacing: -0.055em;
  }
  .footer__claim em {
    font-style: normal;
    font-stretch: 125%;
    font-weight: 300;
    color: var(--blush);
  }
  .footer__nav {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.3rem;
    text-align: right;
    font-size: 0.8rem;
    font-weight: 600;
    font-stretch: 118%;
    text-transform: uppercase;
  }
  .footer a {
    text-decoration: none;
    transition: color 0.3s var(--ease);
  }
  .footer__nav a:hover {
    color: var(--rasp-soft);
  }
  .footer__logo {
    padding: clamp(48px, 7vw, 96px) var(--gutter) 0;
    color: var(--rasp);
    display: flex;
    justify-content: center;
    margin-bottom: -1.4vw;
  }
  .footer__logo :global(.footer__emboss) {
    width: min(100%, 1360px);
  }
  .footer__bottom {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding-block: 1.4rem;
    border-top: 1px solid rgb(245 243 238 / 0.16);
    font-size: 0.74rem;
    font-stretch: 112%;
    opacity: 0.7;
    position: relative;
  }
  @media (max-width: 700px) {
    .footer__nav { text-align: left; }
  }
</style>
