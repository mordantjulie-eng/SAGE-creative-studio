---
// Formulaire « ticket de projet ». Fonctionne avec Netlify Forms une fois le site en ligne sur Netlify.
import { services, brand } from '../config/site';
---

<form class="pass" name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field" action="/merci" data-contact>
  <input type="hidden" name="form-name" value="contact" />
  <p class="sr-only"><label>Ne pas remplir : <input name="bot-field" /></label></p>

  <div class="pass__head" aria-hidden="true">
    <span class="pass__title">Ticket projet</span>
    <span class="pass__no">N° 001 — {brand.name}.</span>
  </div>

  <div class="pass__grid">
    <label class="field">
      <span>Votre prénom & nom *</span>
      <input name="nom" required autocomplete="name" />
    </label>
    <label class="field">
      <span>E-mail *</span>
      <input name="email" type="email" required autocomplete="email" />
    </label>
    <label class="field">
      <span>Entreprise / marque</span>
      <input name="entreprise" autocomplete="organization" />
    </label>
    <label class="field">
      <span>Budget indicatif (optionnel)</span>
      <select name="budget">
        <option value="">Je ne sais pas encore</option>
        <option>Moins de 1 500 €</option>
        <option>1 500 – 5 000 €</option>
        <option>5 000 – 10 000 €</option>
        <option>Plus de 10 000 €</option>
      </select>
    </label>
  </div>

  <fieldset class="needs">
    <legend>De quoi avez-vous besoin ?</legend>
    <div class="needs__list">
      {
        services.map((s) => (
          <label class="need">
            <input type="checkbox" name="services" value={s.title} data-service={s.slug} />
            <span>
              {s.num} {s.title}
            </span>
          </label>
        ))
      }
      <label class="need">
        <input type="checkbox" name="services" value="Je ne sais pas encore" />
        <span>Je ne sais pas encore</span>
      </label>
    </div>
  </fieldset>

  <label class="field field--full">
    <span>Votre projet en quelques lignes *</span>
    <textarea name="message" rows="4" required placeholder="Où en êtes-vous, qu'aimeriez-vous changer, pour quand ?"></textarea>
  </label>

  <label class="consent">
    <input type="checkbox" name="consentement" required />
    <span>J'accepte que SAGE utilise ces informations pour me recontacter au sujet de mon projet.</span>
  </label>

  <div class="pass__foot">
    <button class="btn btn--primary" type="submit">
      Envoyer mon ticket
      <span class="arrow"><svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 10 10 2M4 2h6v6" fill="none" stroke="currentColor" stroke-width="1.8"></path></svg></span>
    </button>
    <p class="pass__alt">ou directement : <a href={`mailto:${brand.email}`}>{brand.email}</a></p>
  </div>
</form>

<script>
  // Pré-coche le service si on arrive depuis une page service (?service=slug#contact)
  const slug = new URLSearchParams(location.search).get('service');
  if (slug) {
    const box = document.querySelector<HTMLInputElement>(`[data-contact] input[data-service="${slug}"]`);
    if (box) box.checked = true;
  }
</script>

<style>
  .pass {
    position: relative;
    display: grid;
    gap: 1.4rem;
    padding: clamp(1.4rem, 3vw, 2.4rem);
    border-radius: 24px;
    background: var(--sage-paper);
    color: var(--sage-ink);
    text-align: left;
    box-shadow: var(--shadow);
    -webkit-mask:
      radial-gradient(circle 16px at 0 112px, #0000 97%, #000) left / 51% 100% no-repeat,
      radial-gradient(circle 16px at 100% 112px, #0000 97%, #000) right / 51% 100% no-repeat;
    mask:
      radial-gradient(circle 16px at 0 112px, #0000 97%, #000) left / 51% 100% no-repeat,
      radial-gradient(circle 16px at 100% 112px, #0000 97%, #000) right / 51% 100% no-repeat;
  }
  .pass__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
    padding-bottom: 1.4rem;
    border-bottom: 2px dashed rgb(31 58 46 / 0.3);
    min-height: 74px;
  }
  .pass__title {
    font: 800 clamp(1.8rem, 3vw, 2.4rem) / 1 var(--font-display);
    color: var(--sage-forest);
    letter-spacing: -0.03em;
  }
  .pass__no {
    font-family: var(--font-hand);
    font-size: 1.4rem;
    color: var(--sage-rust);
  }
  .pass__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  .field {
    display: grid;
    gap: 0.35rem;
    font-size: 0.85rem;
    font-weight: 700;
  }
  .field input,
  .field select,
  .field textarea {
    width: 100%;
    min-height: 50px;
    padding: 0.75rem 1rem;
    border-radius: 14px;
    border: 1.5px solid rgb(31 58 46 / 0.25);
    background: #fffdf8;
    font: 500 1rem var(--font-ui);
    color: var(--sage-ink);
    transition: border-color 0.2s var(--ease), box-shadow 0.2s var(--ease);
  }
  .field textarea {
    resize: vertical;
  }
  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--sage-forest);
    box-shadow: 0 0 0 4px rgb(196 154 84 / 0.35);
  }
  .needs {
    border: 0;
    margin: 0;
    padding: 0;
  }
  .needs legend {
    font-size: 0.85rem;
    font-weight: 700;
    margin-bottom: 0.6rem;
  }
  .needs__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .need {
    position: relative;
    cursor: pointer;
  }
  .need input {
    position: absolute;
    opacity: 0;
    inset: 0;
    cursor: pointer;
  }
  .need span {
    display: inline-block;
    padding: 0.55em 1em;
    border-radius: var(--pill);
    border: 1.5px solid rgb(31 58 46 / 0.35);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--sage-forest);
    transition: background 0.2s var(--ease), color 0.2s var(--ease), transform 0.3s var(--spring);
  }
  .need:hover span {
    transform: rotate(-2deg) scale(1.03);
  }
  .need input:checked + span {
    background: var(--sage-forest);
    border-color: var(--sage-forest);
    color: var(--sage-ivory);
  }
  .need input:focus-visible + span {
    outline: 3px solid var(--sage-ochre);
    outline-offset: 2px;
  }
  .consent {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    font-size: 0.85rem;
  }
  .consent input {
    margin-top: 0.25rem;
    width: 18px;
    height: 18px;
    accent-color: var(--sage-forest);
  }
  .pass__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .pass__alt {
    font-size: 0.9rem;
  }
  .pass__alt a {
    font-weight: 800;
  }
  @media (max-width: 640px) {
    .pass__grid {
      grid-template-columns: 1fr;
    }
    .pass__foot .btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
