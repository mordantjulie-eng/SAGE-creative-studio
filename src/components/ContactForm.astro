---
// Formulaire de contact (Netlify Forms une fois le site en ligne sur Netlify).
import { services, brand } from '../config/site';
---

<form class="form glass" name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field" action="/merci" data-contact>
  <input type="hidden" name="form-name" value="contact" />
  <p class="sr-only"><label>Ne pas remplir : <input name="bot-field" /></label></p>

  <div class="form__grid">
    <label class="field"><span>Prénom & nom *</span><input name="nom" required autocomplete="name" /></label>
    <label class="field"><span>E-mail *</span><input name="email" type="email" required autocomplete="email" /></label>
    <label class="field"><span>Entreprise / marque</span><input name="entreprise" autocomplete="organization" /></label>
    <label class="field">
      <span>Budget indicatif</span>
      <select name="budget">
        <option value="">Je ne sais pas encore</option>
        <option>Moins de 1 500 €</option>
        <option>De 1 500 à 5 000 €</option>
        <option>De 5 000 à 10 000 €</option>
        <option>Plus de 10 000 €</option>
      </select>
    </label>
  </div>

  <fieldset class="needs">
    <legend>Votre besoin</legend>
    <div class="needs__list">
      {
        services.map((s) => (
          <label class="need">
            <input type="checkbox" name="services" value={s.title} data-service={s.slug} />
            <span>{s.title}</span>
          </label>
        ))
      }
      <label class="need"><input type="checkbox" name="services" value="Je ne sais pas encore" /><span>Je ne sais pas encore</span></label>
    </div>
  </fieldset>

  <label class="field"><span>Votre projet *</span><textarea name="message" rows="4" required placeholder="Où en êtes-vous, qu'aimeriez-vous faire évoluer, et pour quand ?"></textarea></label>

  <label class="consent">
    <input type="checkbox" name="consentement" required />
    <span>J'accepte que SAGE utilise ces informations pour me recontacter au sujet de mon projet.</span>
  </label>

  <div class="form__foot">
    <button class="btn btn--primary" type="submit">Envoyer ma demande <span aria-hidden="true">→</span></button>
    <p class="form__alt">ou <a class="link" href={`mailto:${brand.email}`}>{brand.email}</a></p>
  </div>
</form>

<script>
  const slug = new URLSearchParams(location.search).get('service');
  if (slug) {
    const box = document.querySelector<HTMLInputElement>(`[data-contact] input[data-service="${slug}"]`);
    if (box) box.checked = true;
  }
</script>

<style>
  .form {
    display: grid;
    gap: 1.5rem;
    padding: clamp(1.5rem, 3.4vw, 2.6rem);
    border-radius: var(--r-l);
    color: var(--ink);
    text-align: left;
    background: rgb(246 243 238 / 0.72);
  }
  .form__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.1rem;
  }
  .field {
    display: grid;
    gap: 0.4rem;
    font-size: 0.85rem;
    color: rgb(43 52 47 / 0.75);
  }
  .field input,
  .field select,
  .field textarea {
    width: 100%;
    min-height: 52px;
    padding: 0.8rem 1.1rem;
    border-radius: var(--r-s);
    border: 1px solid rgb(43 52 47 / 0.12);
    background: rgb(255 255 255 / 0.7);
    font: 400 1rem var(--font-ui);
    color: var(--ink);
    transition: border-color 0.3s var(--ease), box-shadow 0.3s var(--ease), background 0.3s var(--ease);
  }
  .field textarea {
    resize: vertical;
  }
  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: none;
    background: #fff;
    border-color: var(--eucalyptus);
    box-shadow: 0 0 0 4px rgb(111 133 116 / 0.15);
  }
  .needs {
    border: 0;
    margin: 0;
    padding: 0;
  }
  .needs legend {
    font-size: 0.85rem;
    color: rgb(43 52 47 / 0.75);
    margin-bottom: 0.6rem;
  }
  .needs__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .need {
    position: relative;
    cursor: pointer;
  }
  .need input {
    position: absolute;
    opacity: 0;
    inset: 0;
    cursor: pointer;
  }
  .need span {
    display: inline-block;
    padding: 0.55em 1.05em;
    border-radius: var(--pill);
    border: 1px solid rgb(43 52 47 / 0.15);
    background: rgb(255 255 255 / 0.5);
    font-size: 0.86rem;
    transition: background 0.3s var(--ease), color 0.3s var(--ease), border-color 0.3s var(--ease);
  }
  .need:hover span {
    background: #fff;
  }
  .need input:checked + span {
    background: var(--moss);
    border-color: var(--moss);
    color: var(--cream);
  }
  .need input:focus-visible + span {
    outline: 2px solid var(--champagne);
    outline-offset: 2px;
  }
  .consent {
    display: flex;
    gap: 0.7rem;
    align-items: flex-start;
    font-size: 0.85rem;
    color: rgb(43 52 47 / 0.75);
  }
  .consent input {
    margin-top: 0.25rem;
    width: 17px;
    height: 17px;
    accent-color: var(--moss);
  }
  .form__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .form__alt {
    font-size: 0.9rem;
  }
  @media (max-width: 640px) {
    .form__grid {
      grid-template-columns: 1fr;
    }
    .form__foot .btn {
      width: 100%;
    }
  }
</style>
