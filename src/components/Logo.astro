---
// Logo PROVISOIRE (lettrage final à dessiner avec un graphiste).
interface Props {
  withDescriptor?: boolean;
  size?: 'sm' | 'xl';
}
const { withDescriptor = false, size = 'sm' } = Astro.props;
---

<span class:list={['logo', `logo--${size}`]} role="img" aria-label="SAGE Creative Studio">
  <span class="logo__word" aria-hidden="true">SAGE</span>
  {withDescriptor && <span class="logo__descriptor" aria-hidden="true">creative studio</span>}
</span>

<style>
  .logo {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    line-height: 1;
  }
  .logo__word {
    font-family: var(--font-serif);
    font-weight: 400;
    letter-spacing: 0.22em;
    padding-left: 0.22em;
  }
  .logo__descriptor {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 300;
    letter-spacing: 0.06em;
    margin-top: 0.5em;
    opacity: 0.8;
  }
  .logo--sm .logo__word {
    font-size: 1.35rem;
  }
  .logo--xl .logo__word {
    font-size: clamp(4.2rem, 15vw, 13rem);
    font-weight: 300;
  }
  .logo--xl .logo__descriptor {
    font-size: clamp(1.1rem, 2.2vw, 1.8rem);
  }
</style>
