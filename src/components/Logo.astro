---
// Logo SAGE repris tel quel du brand book (vectorisé), couleur héritée du texte.
// full = orbite + « SAGE. » + « CREATIVE STUDIO » ; sinon le mot seul.
import word from '../assets/logo-word.svg?raw';
import full from '../assets/logo-full.svg?raw';

interface Props {
  withDescriptor?: boolean;
  orbit?: boolean;
  size?: 'sm' | 'md' | 'xl';
}
const { withDescriptor = false, orbit = false, size = 'sm' } = Astro.props;
const svg = withDescriptor || orbit ? full : word;
---

<span class:list={['logo', `logo--${size}`, { 'logo--full': withDescriptor || orbit }]} role="img" aria-label="SAGE Creative Studio">
  <Fragment set:html={svg} />
</span>

<style>
  .logo {
    display: inline-block;
    line-height: 0;
    color: currentColor;
  }
  .logo :global(svg) {
    width: 100%;
    height: auto;
    display: block;
  }
  .logo--sm {
    width: 104px;
  }
  .logo--md {
    width: 220px;
  }
  .logo--xl {
    width: min(78vw, 820px);
  }
</style>
