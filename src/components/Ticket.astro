---
// Carte service en verre dépoli.
// Se retourne pour afficher toutes les prestations.
import { pillars, type Service } from '../config/site';
import Shape from './Shape.astro';

interface Props {
  service: Service;
  delay?: number;
}
const { service: s, delay = 0 } = Astro.props;
const pil = pillars.find((p) => p.letter === s.pillars[0])!;
---

<article class="card reveal" style={`--rd:${delay}s`} data-ticket>
  <div class="card__inner">
    <div class="card__face card__front glass" data-face="front">
      <div class="card__top">
        <span class="card__no">N° {s.num}</span>
        <span class="card__shape"><Shape name={pil.shape as any} color={pil.color} /></span>
      </div>
      <h3 class="card__title"><a href={`/services/${s.slug}`}>{s.title}</a></h3>
      <p class="card__short">{s.short}</p>
      <div class="card__foot">
        <p class="card__tags split">{s.highlights.map((h) => <span>{h}</span>)}</p>
        <button type="button" class="card__flip" data-flip aria-label={`Voir les prestations ${s.title}`}>
          Voir les prestations <span aria-hidden="true">+</span>
        </button>
      </div>
    </div>

    <div class="card__face card__back glass" data-face="back" inert>
      <div class="card__top">
        <span class="card__no">{s.title}</span>
        <button type="button" class="card__close" data-flip aria-label="Revenir">×</button>
      </div>
      <ul class="card__list">
        {s.items.map((i) => <li>{i}</li>)}
      </ul>
      <div class="card__foot">
        <a class="link" href={`/services/${s.slug}`}>Découvrir le service <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </div>
</article>

<script>
  document.querySelectorAll<HTMLElement>('[data-ticket]').forEach((t) => {
    const front = t.querySelector<HTMLElement>('[data-face="front"]')!;
    const back = t.querySelector<HTMLElement>('[data-face="back"]')!;
    t.querySelectorAll<HTMLButtonElement>('[data-flip]').forEach((b) =>
      b.addEventListener('click', () => {
        const flipped = t.classList.toggle('is-flipped');
        front.inert = flipped;
        back.inert = !flipped;
        (flipped ? back : front).querySelector<HTMLElement>('[data-flip]')?.focus({ preventScroll: true });
      }),
    );
  });
</script>

<style>
  .card {
    perspective: 1600px;
    transition: transform 0.7s var(--ease-out);
  }
  .card:hover {
    transform: translateY(-8px);
  }
  .card__inner {
    display: grid;
    transform-style: preserve-3d;
    transition: transform 0.9s var(--ease-out);
  }
  .card.is-flipped .card__inner {
    transform: rotateY(180deg);
  }
  .card__face {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-height: 360px;
    padding: 1.9rem 1.8rem 1.6rem;
    border-radius: var(--r);
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    transition: background 0.5s var(--ease);
  }
  .card:hover .card__front {
    background: var(--glass-strong);
  }
  .card__back {
    transform: rotateY(180deg);
    background: rgb(70 86 76 / 0.82);
    color: var(--cream);
    border-color: rgb(255 255 255 / 0.2);
  }
  .card__shape {
    width: 40px;
    display: grid;
    place-items: center;
    transition: transform 0.8s var(--ease-out);
  }
  .card__shape :global(.shape) {
    width: 100%;
    height: auto;
    max-height: 40px;
  }
  .card:hover .card__shape {
    transform: rotate(-18deg) scale(1.2);
  }
  .card__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }
  .card__no {
    font: italic 300 1.05rem var(--font-serif);
    color: var(--eucalyptus);
  }
  .card__back .card__no {
    color: var(--champagne);
  }
  .card__title {
    font-size: clamp(1.8rem, 2.4vw, 2.2rem);
    margin-top: 1.4rem;
  }
  .card__title a {
    text-decoration: none;
  }
  .card__short {
    color: rgb(43 52 47 / 0.75);
  }
  .card__foot {
    margin-top: auto;
    display: grid;
    gap: 1rem;
    padding-top: 1.1rem;
    border-top: 1px solid rgb(43 52 47 / 0.1);
  }
  .card__back .card__foot {
    border-color: rgb(255 255 255 / 0.25);
  }
  .card__tags {
    font-size: 0.82rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--eucalyptus);
  }
  .card__flip {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink);
    font: 500 0.95rem var(--font-ui);
    cursor: pointer;
  }
  .card__flip span {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: 1px solid var(--hair);
    font-size: 1.1rem;
    transition: transform 0.5s var(--ease-out), background 0.3s var(--ease);
  }
  .card__flip:hover span {
    transform: rotate(90deg);
    background: #fff;
  }
  .card__close {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid rgb(255 255 255 / 0.3);
    background: none;
    color: inherit;
    font-size: 1.3rem;
    line-height: 1;
    cursor: pointer;
  }
  .card__list {
    list-style: none;
    margin: 0.4rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.45rem;
    font-size: 0.95rem;
    line-height: 1.4;
  }
  .card__list li {
    padding-bottom: 0.45rem;
    border-bottom: 1px solid rgb(255 255 255 / 0.12);
  }
  .card__back .link {
    color: var(--cream);
  }
</style>
