---
// Carte service (pages secondaires) : une petite affiche, qui passe au bordeaux au survol.
import type { Service } from '../config/site';

interface Props {
  service: Service;
  delay?: number;
}
const { service: s, delay = 0 } = Astro.props;
---

<a class="card reveal" style={`--rd:${delay}s`} href={`/services/${s.slug}`}>
  <span class="card__tags split">{s.highlights.map((h) => <span>{h}</span>)}</span>
  <span class="card__title">{s.title}</span>
  <span class="card__short">{s.short}</span>
  <span class="card__go" aria-hidden="true">→</span>
</a>

<style>
  .card {
    position: relative;
    display: grid;
    align-content: space-between;
    gap: 1.4rem;
    min-height: 300px;
    padding: 1.6rem;
    border-radius: var(--r-l);
    background: var(--white);
    color: #17120e;
    text-decoration: none;
    box-shadow: 0 30px 60px -45px rgb(46 29 20 / 0.5);
    transition: background 0.5s var(--ease), color 0.5s var(--ease), transform 0.6s var(--ease-out);
  }
  .card:hover {
    background: var(--choco);
    color: #f5f1ea;
    transform: translateY(-4px);
  }
  .card__tags {
    font-size: 0.66rem;
    font-weight: 600;
    font-stretch: 125%;
    text-transform: uppercase;
    color: var(--rasp);
    padding-bottom: 0.8rem;
    border-bottom: 1px solid currentColor;
  }
  .card:hover .card__tags {
    color: var(--blush);
  }
  .card__title {
    font-size: clamp(1.7rem, 2.4vw, 2.3rem);
    font-weight: 560;
    letter-spacing: -0.055em;
    line-height: 0.95;
  }
  .card__short {
    font-size: 0.92rem;
    opacity: 0.72;
    max-width: 22rem;
  }
  .card__go {
    position: absolute;
    right: 1.4rem;
    bottom: 1.4rem;
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: rgb(23 18 14 / 0.06);
    transition: background 0.4s var(--ease), transform 0.5s var(--ease-out);
  }
  .card:hover .card__go {
    background: var(--rasp);
    transform: rotate(-45deg);
  }
</style>
