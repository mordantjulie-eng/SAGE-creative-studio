---
// Scène « morph » : une arche au centre de l'écran s'agrandit au défilement
// jusqu'à devenir une page plein écran, pendant que deux mots géants s'écartent.
interface Props {
  img: string;
}
const { img } = Astro.props;
---

<section class="scene morph" data-scene aria-label="Le studio en une phrase">
  <div class="scene__sticky morph__sticky">
    <p class="morph__word morph__word--l" aria-hidden="true">Creative</p>
    <p class="morph__word morph__word--r" aria-hidden="true"><em>thinking.</em></p>

    <div class="morph__frame">
      <img class="morph__img photo" src={img} alt="" />
      <div class="morph__veil"></div>
      <div class="morph__content">
        <p class="eyebrow">Une seule obsession</p>
        <p class="morph__title">Un studio. Six expertises.<br /><em>Votre marque, au centre.</em></p>
        <a href="#services" class="btn btn--primary">Voir les services <span aria-hidden="true">→</span></a>
      </div>
    </div>

    <p class="morph__hint" aria-hidden="true">Faites défiler</p>
  </div>
</section>

<style>
  .morph {
    height: 280vh;
    background: var(--cream);
  }
  .morph__sticky {
    display: grid;
    place-items: center;
  }
  .morph__word {
    position: absolute;
    top: 50%;
    z-index: 0;
    font: 300 clamp(4rem, 13vw, 13rem) / 1 var(--font-serif);
    letter-spacing: -0.04em;
    color: var(--ink);
    white-space: nowrap;
    opacity: calc(1 - var(--p) * 1.6);
  }
  .morph__word em {
    color: var(--ochre);
  }
  .morph__word--l {
    right: 52%;
    transform: translate(calc(var(--p) * -40vw), -50%);
  }
  .morph__word--r {
    left: 52%;
    transform: translate(calc(var(--p) * 40vw), -50%);
  }
  .morph__frame {
    position: relative;
    z-index: 1;
    width: calc(26vw + 74vw * var(--p));
    height: calc(58svh + 42svh * var(--p));
    border-radius: calc(40vw * (1 - var(--p))) calc(40vw * (1 - var(--p))) calc(28px * (1 - var(--p))) calc(28px * (1 - var(--p)));
    overflow: hidden;
    box-shadow: var(--shadow);
  }
  .morph__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transform: scale(calc(1.25 - 0.25 * var(--p)));
  }
  .morph__veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(160deg, rgb(59 72 65 / 0.92), rgb(83 101 89 / 0.78) 50%, rgb(127 148 131 / 0.7));
    opacity: calc(var(--p) * 1.6 - 0.45);
  }
  .morph__content {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 1.6rem;
    padding: var(--gutter);
    text-align: center;
    color: var(--cream);
    opacity: calc((var(--p) - 0.62) * 3.2);
    transform: translateY(calc((1 - var(--p)) * 40px));
  }
  .morph__content .eyebrow {
    color: var(--sage-light);
  }
  .morph__title {
    font: 300 clamp(2.4rem, 5.6vw, 5.4rem) / 1.05 var(--font-serif);
    letter-spacing: -0.02em;
  }
  .morph__title em {
    color: var(--ochre);
  }
  .morph__content .btn--primary {
    background: var(--cream);
    color: var(--moss);
  }
  .morph__hint {
    position: absolute;
    bottom: 28px;
    left: 50%;
    translate: -50% 0;
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--eucalyptus);
    opacity: calc(1 - var(--p) * 5);
  }
  .morph__hint::after {
    content: '';
    display: block;
    width: 1px;
    height: 40px;
    margin: 0.8rem auto 0;
    background: linear-gradient(currentColor, transparent);
    animation: hint 2s var(--ease) infinite;
  }
  @keyframes hint {
    0% { transform: scaleY(0); transform-origin: top; }
    50% { transform: scaleY(1); transform-origin: top; }
    51% { transform-origin: bottom; }
    100% { transform: scaleY(0); transform-origin: bottom; }
  }
  @media (max-width: 760px) {
    .morph {
      height: 220vh;
    }
    .morph__frame {
      width: calc(62vw + 38vw * var(--p));
      height: calc(52svh + 48svh * var(--p));
    }
    .morph__word {
      font-size: 17vw;
      transform: none;
    }
    .morph__word--l {
      right: auto;
      left: 6vw;
      top: 13svh;
      transform: translateX(calc(var(--p) * -60vw));
    }
    .morph__word--r {
      left: auto;
      right: 6vw;
      top: auto;
      bottom: 10svh;
      transform: translateX(calc(var(--p) * 60vw));
    }
    .morph__hint {
      display: none;
    }
  }
</style>
