---
// Formes organiques douces (DA « Saveurs ») : quatre silhouettes de galet, en dégradé.
// Les noms historiques (leaf, half, arch, circle) sont gardés pour ne rien casser.
interface Props {
  name: 'leaf' | 'half' | 'arch' | 'circle';
  color?: string;
  class?: string;
  style?: string;
}
const { name, color = 'var(--rasp)', class: cls = '', style = '' } = Astro.props;
const paths: Record<string, string> = {
  leaf: 'M52 6c22 0 42 14 44 36 2 20-10 28-8 44 1 10-16 12-32 10-20-2-28 4-42-4C2 84 2 66 6 52 10 38 2 26 12 16 20 9 36 6 52 6Z',
  half: 'M48 8c18-4 40 6 46 24 6 16-2 26 2 40 4 14-14 22-34 20-16-2-26 6-40-4C8 80 4 64 8 50 12 36 4 28 14 18 22 10 34 11 48 8Z',
  arch: 'M50 4c20 2 38 16 42 34 4 16-6 26-2 40 3 12-16 18-34 16-18-1-26 4-40-6C4 80 6 62 10 50c4-14-4-24 6-34C24 8 34 3 50 4Z',
  circle: 'M51 4C70 2 92 14 96 36c4 20-6 30-2 46 3 13-12 18-30 16-18-2-24 2-40-2C9 96 2 82 6 64 9 50 2 38 10 24 17 11 33 5 51 4Z',
};
const id = `g${Math.random().toString(36).slice(2, 8)}`;
---

<svg class:list={['shape', cls]} viewBox="0 0 100 100" style={`color:${color};${style}`} aria-hidden="true" focusable="false">
  <defs>
    <radialGradient id={id} cx="35%" cy="30%" r="80%">
      <stop offset="0%" stop-color="#ffffff" stop-opacity="0.55" />
      <stop offset="55%" stop-color="currentColor" stop-opacity="0.95" />
      <stop offset="100%" stop-color="currentColor" />
    </radialGradient>
  </defs>
  <path d={paths[name]} fill={`url(#${id})`}></path>
</svg>
