---
// Formes organiques du brand book : feuille, demi-lune, arche, cercle.
interface Props {
  name: 'leaf' | 'half' | 'arch' | 'circle';
  color?: string;
  class?: string;
  style?: string;
}
const { name, color = 'var(--ochre)', class: cls = '', style = '' } = Astro.props;
const paths: Record<string, { vb: string; d: string }> = {
  leaf: { vb: '0 0 100 100', d: 'M0 100 C0 42 42 0 100 0 C100 58 58 100 0 100 Z' },
  half: { vb: '0 0 100 50', d: 'M0 0 H100 A50 50 0 0 1 0 0 Z' },
  arch: { vb: '0 0 100 130', d: 'M0 130 V50 A50 50 0 0 1 100 50 V130 Z' },
  circle: { vb: '0 0 100 100', d: 'M50 0 A50 50 0 1 1 49.99 0 Z' },
};
const p = paths[name];
---

<svg class:list={['shape', cls]} viewBox={p.vb} style={`color:${color};${style}`} aria-hidden="true" focusable="false">
  <path d={p.d} fill="currentColor"></path>
</svg>
