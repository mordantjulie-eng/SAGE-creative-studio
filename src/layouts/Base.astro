---
import '@fontsource-variable/manrope';
import '@fontsource-variable/space-grotesk';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { brand } from '../config/site';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = `${brand.name} ${brand.descriptor} — ${brand.signature}`,
  description = 'Studio créatif et digital en Belgique : stratégie, direction artistique, contenu & visibilité, innovation & IA.',
} = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#1F3A2E" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Site en construction : pas d'indexation tant que le nom n'est pas validé juridiquement -->
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <a class="sr-only" href="#main">Aller au contenu</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      const els = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) =>
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                io.unobserve(e.target);
              }
            }),
          { threshold: 0.12 },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-in'));
      }
    </script>
  </body>
</html>
