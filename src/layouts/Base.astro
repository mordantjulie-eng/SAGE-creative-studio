---
import '@fontsource-variable/mona-sans/wdth.css';
import '@fontsource-variable/mona-sans/wdth-italic.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { brand } from '../config/site';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = `${brand.name} ${brand.descriptor}, ${brand.signature}`,
  description = 'Studio créatif et digital en Belgique : stratégie, direction artistique, contenu & visibilité, innovation & IA.',
} = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#3a0b16" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Site en construction : pas d'indexation tant que le nom n'est pas validé juridiquement -->
    <meta name="robots" content="noindex" />
  </head>
  <body id="top">
    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
      <filter id="water" x="-10%" y="-10%" width="120%" height="120%">
        <feTurbulence id="water-turb" type="fractalNoise" baseFrequency="0.012 0.03" numOctaves="2" seed="3" result="n" />
        <feDisplacementMap id="water-map" in="SourceGraphic" in2="n" scale="0" xChannelSelector="R" yChannelSelector="G" />
      </filter>
    </svg>
    <a class="sr-only" href="#main">Aller au contenu</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // Scènes pilotées par le défilement
      const scenes = [...document.querySelectorAll<HTMLElement>('[data-scene]')];
      const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (scenes.length) {
        const update = () => {
          scenes.forEach((el) => {
            const r = el.getBoundingClientRect();
            const total = el.offsetHeight - window.innerHeight;
            const p = still ? 1 : Math.min(1, Math.max(0, -r.top / total));
            el.style.setProperty('--p', p.toFixed(4));
            el.dispatchEvent(new CustomEvent('scene', { detail: p }));
          });
        };
        let ticking = false;
        const onScroll = () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(() => { update(); ticking = false; });
        };
        update();
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll);
      }

      // Titres découpés en mots pour une apparition mot par mot
      document.querySelectorAll<HTMLElement>('main h2.reveal').forEach((h) => {
        let i = 0;
        const wrap = (node: Node) => {
          [...node.childNodes].forEach((c) => {
            if (c.nodeType === 3) {
              const frag = document.createDocumentFragment();
              (c.textContent || '').split(/(\s+)/).forEach((part) => {
                if (!part) return;
                if (/^\s+$/.test(part)) { frag.appendChild(document.createTextNode(part)); return; }
                const w = document.createElement('span'); w.className = 'w';
                const inner = document.createElement('span'); inner.textContent = part; inner.style.setProperty('--wi', String(i++));
                w.appendChild(inner); frag.appendChild(w);
              });
              c.replaceWith(frag);
            } else if (c.nodeType === 1 && (c as Element).tagName !== 'BR') wrap(c);
          });
        };
        wrap(h);
        h.classList.add('split-done');
      });

      // Couleur de fond selon la section au centre de l'écran
      const themed = [...document.querySelectorAll<HTMLElement>('[data-theme]')];
      if (themed.length) {
        document.body.dataset.theme = themed[0].dataset.theme;
        const tio = new IntersectionObserver(
          (entries) => entries.forEach((e) => { if (e.isIntersecting) document.body.dataset.theme = (e.target as HTMLElement).dataset.theme; }),
          { rootMargin: '-50% 0px -50% 0px' },
        );
        themed.forEach((el) => tio.observe(el));
      }

      // Effets au survol (souris uniquement) : bouton liquide, loupe, halo
      if (!still && window.matchMedia('(pointer: fine)').matches) {
        const track = (el: HTMLElement, vx: string, vy: string) =>
          el.addEventListener('pointermove', (e) => {
            const r = el.getBoundingClientRect();
            el.style.setProperty(vx, `${e.clientX - r.left}px`);
            el.style.setProperty(vy, `${e.clientY - r.top}px`);
          });
        const pct = (el: HTMLElement) =>
          el.addEventListener('pointermove', (e) => {
            const r = el.getBoundingClientRect();
            el.style.setProperty('--lx', `${((e.clientX - r.left) / r.width) * 100}%`);
            el.style.setProperty('--ly', `${((e.clientY - r.top) / r.height) * 100}%`);
          });
        document.querySelectorAll<HTMLElement>('.btn, .header__cta, .snav__btn, .link').forEach((el) => {
          el.classList.add('liquid');
          track(el, '--mx', '--my');
          el.addEventListener('pointerenter', (e) => {
            const r = el.getBoundingClientRect();
            el.style.setProperty('--mx', `${e.clientX - r.left}px`);
            el.style.setProperty('--my', `${e.clientY - r.top}px`);
          });
        });
        document.querySelectorAll<HTMLElement>('.iphone__body, .st-shot__img, .sv-photo').forEach((el) => {
          el.classList.add('loupe');
          pct(el);
        });
        document.querySelectorAll<HTMLElement>('.st-trait, .st-how__item').forEach((el) => {
          el.classList.add('glow');
          track(el, '--gx', '--gy');
        });
      }

      // Chaque nouvelle page s'ouvre en haut (sauf lien vers une section précise) :
      // évite que le navigateur ou la visionneuse restaure la position de la page précédente
      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
      const toTop = () => { if (!location.hash) window.scrollTo(0, 0); };
      toTop();
      window.addEventListener('pageshow', toTop);

      // Défilement fluide
      if (!still) {
        import('lenis').then(({ default: Lenis }) => {
          const lenis = new Lenis({ lerp: 0.09, smoothWheel: true });
          (window as any).__lenis = lenis;
          if (!location.hash) lenis.scrollTo(0, { immediate: true, force: true });
          const raf = (t: number) => { lenis.raf(t); requestAnimationFrame(raf); };
          requestAnimationFrame(raf);
          document.querySelectorAll<HTMLAnchorElement>('a[href*="#"]').forEach((a) => {
            const url = new URL(a.href, location.href);
            if (url.pathname !== location.pathname || !url.hash) return;
            a.addEventListener('click', (ev) => { const t = document.querySelector(url.hash); if (t) { ev.preventDefault(); lenis.scrollTo(t as HTMLElement, { offset: -90 }); } });
          });
        });
      }

      const els = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) =>
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                io.unobserve(e.target);
              }
            }),
          { threshold: 0.12 },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-in'));
      }
    </script>

    <script>
      // Effets au survol (souris uniquement, coupés si animations réduites)
      const fine = window.matchMedia('(pointer: fine)').matches;
      const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (fine && !calm) {
        // Effet d'eau sur les photos au survol
        const map = document.getElementById('water-map');
        const turb = document.getElementById('water-turb');
        let amp = 0, target = 0, t0 = 0, active: HTMLElement | null = null;
        const tick = (t: number) => {
          amp += (target - amp) * 0.08;
          if (map) map.setAttribute('scale', amp.toFixed(1));
          if (turb) turb.setAttribute('baseFrequency', `${(0.012 + Math.sin(t / 900) * 0.004).toFixed(4)} ${(0.03 + Math.cos(t / 700) * 0.008).toFixed(4)}`);
          if (amp < 0.3 && target === 0 && active) { active.classList.remove('liquid-img'); active = null; }
          if (active || target) requestAnimationFrame(tick); else t0 = 0;
        };
        document.querySelectorAll<HTMLElement>('img.photo, .st-portrait img, .st-shot__img img').forEach((img) => {
          img.addEventListener('pointerenter', () => {
            if (active && active !== img) active.classList.remove('liquid-img');
            active = img; img.classList.add('liquid-img'); target = 16;
            if (!t0) { t0 = 1; requestAnimationFrame(tick); }
          });
          img.addEventListener('pointerleave', () => { target = 0; });
        });
      }
    </script>
  </body>
</html>
