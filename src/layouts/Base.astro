---
import '@fontsource-variable/funnel-sans';
import '@fontsource-variable/schibsted-grotesk';
import '@fontsource-variable/schibsted-grotesk/wght-italic.css';
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { brand } from '../config/site';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = `${brand.name} ${brand.descriptor}, ${brand.signature}`,
  description = 'Studio créatif et digital en Belgique : stratégie, direction artistique, contenu & visibilité, innovation & IA.',
} = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#46564C" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Site en construction : pas d'indexation tant que le nom n'est pas validé juridiquement -->
    <meta name="robots" content="noindex" />
  </head>
  <body id="top">
    <a class="sr-only" href="#main">Aller au contenu</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // Scènes pilotées par le défilement
      const scenes = [...document.querySelectorAll<HTMLElement>('[data-scene]')];
      const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (scenes.length) {
        const update = () => {
          scenes.forEach((el) => {
            const r = el.getBoundingClientRect();
            const total = el.offsetHeight - window.innerHeight;
            const p = still ? 1 : Math.min(1, Math.max(0, -r.top / total));
            el.style.setProperty('--p', p.toFixed(4));
            el.dispatchEvent(new CustomEvent('scene', { detail: p }));
          });
        };
        let ticking = false;
        const onScroll = () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(() => { update(); ticking = false; });
        };
        update();
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll);
      }

      // Titres découpés en mots pour une apparition mot par mot
      document.querySelectorAll<HTMLElement>('main h2.reveal').forEach((h) => {
        let i = 0;
        const wrap = (node: Node) => {
          [...node.childNodes].forEach((c) => {
            if (c.nodeType === 3) {
              const frag = document.createDocumentFragment();
              (c.textContent || '').split(/(\s+)/).forEach((part) => {
                if (!part) return;
                if (/^\s+$/.test(part)) { frag.appendChild(document.createTextNode(part)); return; }
                const w = document.createElement('span'); w.className = 'w';
                const inner = document.createElement('span'); inner.textContent = part; inner.style.setProperty('--wi', String(i++));
                w.appendChild(inner); frag.appendChild(w);
              });
              c.replaceWith(frag);
            } else if (c.nodeType === 1 && (c as Element).tagName !== 'BR') wrap(c);
          });
        };
        wrap(h);
        h.classList.add('split-done');
      });

      // Couleur de fond selon la section au centre de l'écran
      const themed = [...document.querySelectorAll<HTMLElement>('[data-theme]')];
      if (themed.length) {
        document.body.dataset.theme = themed[0].dataset.theme;
        const tio = new IntersectionObserver(
          (entries) => entries.forEach((e) => { if (e.isIntersecting) document.body.dataset.theme = (e.target as HTMLElement).dataset.theme; }),
          { rootMargin: '-50% 0px -50% 0px' },
        );
        themed.forEach((el) => tio.observe(el));
      }

      // Défilement fluide
      if (!still) {
        import('lenis').then(({ default: Lenis }) => {
          const lenis = new Lenis({ lerp: 0.09, smoothWheel: true });
          const raf = (t: number) => { lenis.raf(t); requestAnimationFrame(raf); };
          requestAnimationFrame(raf);
          document.querySelectorAll<HTMLAnchorElement>('a[href*="#"]').forEach((a) => {
            const url = new URL(a.href, location.href);
            if (url.pathname !== location.pathname || !url.hash) return;
            a.addEventListener('click', (ev) => { const t = document.querySelector(url.hash); if (t) { ev.preventDefault(); lenis.scrollTo(t as HTMLElement, { offset: -90 }); } });
          });
        });
      }

      const els = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) =>
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                io.unobserve(e.target);
              }
            }),
          { threshold: 0.12 },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-in'));
      }
    </script>
  </body>
</html>
