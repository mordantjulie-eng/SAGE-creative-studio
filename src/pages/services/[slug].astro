---
import Base from '../../layouts/Base.astro';
import Ticket from '../../components/Ticket.astro';
import { services, pillars, steps, type Service } from '../../config/site';

export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug }, props: { service: s } }));
}

const { service: s } = Astro.props as { service: Service };
const idx = services.findIndex((x) => x.slug === s.slug);
const prev = services[(idx - 1 + services.length) % services.length];
const next = services[(idx + 1) % services.length];
const related = pillars.filter((p) => s.pillars.includes(p.letter));
const others = [1, 2, 3].map((k) => services[(idx + k) % services.length]);
---

<Base title={`${s.title} | SAGE Creative Studio`} description={`${s.title} : ${s.promise}`}>
  <section class="sv-hero">
    <div class="orbs" aria-hidden="true">
      <span class="orb orb--sage" style="width:700px;height:700px;left:-220px;top:-200px;--d:26s"></span>
      <span class="orb orb--champagne" style="width:520px;height:520px;right:-140px;top:80px;--d:30s"></span>
      <span class="orb orb--blush" style="width:500px;height:500px;left:35%;bottom:-260px;--d:34s"></span>
    </div>
    <div class="container sv-hero__grid rel">
      <div class="sv-hero__text">
        <a href="/#services" class="sv-back link">← Tous les services</a>
        <p class="eyebrow reveal">Service N° {s.num}</p>
        <h1 class="reveal" style="--rd:.08s">{s.title}</h1>
        <p class="lead reveal" style="--rd:.16s">{s.promise}</p>
        <div class="reveal" style="--rd:.24s">
          <a href={`/?service=${s.slug}#contact`} class="btn btn--primary">Discuter de ce service <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <div class="sv-hero__visual reveal" style="--rd:.1s">
        <div class="sv-photo arch"><img class="photo" src={`/media/${s.img}.jpg`} alt="" /></div>
        <div class="sv-tag glass float" style="--d:8s">
          <span>N° {s.num}</span>
          <em class="split">{s.highlights.map((h) => <span>{h}</span>)}</em>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container sv-body">
      <div class="sv-intro">
        <p class="eyebrow reveal">Le service</p>
        <p class="sv-intro__text reveal" style="--rd:.08s">{s.intro}</p>
        {s.note && <p class="sv-note glass reveal">{s.note}</p>}
      </div>
      <div class="sv-items">
        <p class="eyebrow reveal">Ce que ça comprend</p>
        <ol class="sv-list">
          {
            s.items.map((it, i) => (
              <li class="reveal" style={`--rd:${i * 0.05}s`}>
                <span class="sv-list__n">{String(i + 1).padStart(2, '0')}</span>
                <span>{it}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section class="sv-pillars on-dark">
    <div class="orbs" aria-hidden="true">
      <span class="orb orb--champagne" style="width:520px;height:520px;right:-140px;top:-180px;opacity:.35;--d:26s"></span>
    </div>
    <div class="container rel">
      <p class="eyebrow reveal">Le mindset derrière ce service</p>
      <div class="sv-pillars__row">
        {
          related.map((p, i) => (
            <div class="sv-pillar glass reveal" style={`--rd:${i * 0.1}s`}>
              <span class="sv-pillar__l">{p.letter}</span>
              <div>
                <h2>{p.name}</h2>
                <p>{p.verbs}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="sv-head">
        <p class="eyebrow reveal">Comment on travaille ensemble</p>
        <h2 class="reveal" style="--rd:.08s">Simple, cadré, <em>sans surprise.</em></h2>
      </div>
      <ol class="sv-steps">
        {
          steps.map((st, i) => (
            <li class="reveal" style={`--rd:${i * 0.08}s`}>
              <span class="sv-steps__n">{st.num}</span>
              <h3>{st.title}</h3>
              <p>{st.text}</p>
            </li>
          ))
        }
      </ol>
      <p class="sv-formats reveal">Formats possibles&nbsp;: <span>Mission ponctuelle</span><span>Accompagnement mensuel</span><span>Sur mesure</span></p>
    </div>
  </section>

  <section class="section sv-more">
    <div class="orbs" aria-hidden="true">
      <span class="orb orb--mist" style="width:640px;height:640px;left:-200px;top:0;--d:26s"></span>
      <span class="orb orb--champagne" style="width:520px;height:520px;right:-160px;bottom:-160px;opacity:.5;--d:30s"></span>
    </div>
    <div class="container rel">
      <div class="sv-nav">
        <a href={`/services/${prev.slug}`}>← {prev.title}</a>
        <a href={`/services/${next.slug}`}>{next.title} →</a>
      </div>
      <p class="eyebrow reveal" style="margin-bottom:2rem">Les autres expertises</p>
      <div class="sv-others">
        {others.map((o, i) => <Ticket service={o} delay={i * 0.1} />)}
      </div>
    </div>
  </section>

  <section class="sv-cta on-dark">
    <div class="orbs" aria-hidden="true">
      <span class="orb orb--champagne" style="width:520px;height:520px;right:10%;top:-220px;opacity:.35;--d:26s"></span>
    </div>
    <div class="container sv-cta__inner rel reveal">
      <h2>Un projet en <em>{s.title.toLowerCase()}</em>&nbsp;?</h2>
      <a href={`/?service=${s.slug}#contact`} class="btn btn--primary">Parlons-en <span aria-hidden="true">→</span></a>
    </div>
  </section>
</Base>

<style>
  .rel { position: relative; z-index: 1; }
  .sv-hero { position: relative; overflow: hidden; background: var(--grad-soft); padding: 150px 0 clamp(70px, 9vw, 120px); }
  .sv-hero__grid { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: clamp(2rem, 6vw, 6rem); align-items: center; }
  .sv-hero__text { display: grid; gap: 1.5rem; justify-items: start; }
  .sv-back { font-size: 0.88rem; color: rgb(43 52 47 / 0.7); }
  .sv-hero h1 { font-size: clamp(3rem, 6.6vw, 6rem); font-weight: 300; }
  .sv-hero__visual { position: relative; padding-left: 2rem; }
  .sv-photo { aspect-ratio: 4 / 5; box-shadow: var(--shadow); }
  .sv-photo img { width: 100%; height: 100%; }
  .sv-tag { position: absolute; left: 0; bottom: 10%; display: grid; gap: 0.2rem; padding: 1rem 1.3rem; border-radius: var(--r-s); }
  .sv-tag span { font: italic 300 1.3rem var(--font-serif); color: var(--eucalyptus); }
  .sv-tag em { font-style: normal; font-size: 0.8rem; letter-spacing: 0.1em; text-transform: uppercase; }

  .sv-body { display: grid; grid-template-columns: 0.95fr 1.05fr; gap: clamp(2.5rem, 7vw, 7rem); align-items: start; }
  .sv-intro { display: grid; gap: 1.4rem; position: sticky; top: 120px; }
  .sv-intro__text { font: 300 clamp(1.4rem, 2.2vw, 1.9rem)/1.35 var(--font-serif); }
  .sv-note { padding: 1.1rem 1.3rem; border-radius: var(--r-s); font-size: 0.92rem; }
  .sv-items { display: grid; gap: 1.2rem; }
  .sv-list { list-style: none; margin: 0; padding: 0; }
  .sv-list li { display: flex; gap: 1.4rem; align-items: baseline; padding-block: 1.15rem; border-top: 1px solid var(--hair); font-size: 1.08rem; transition: padding 0.5s var(--ease-out), color 0.4s var(--ease); }
  .sv-list li:last-child { border-bottom: 1px solid var(--hair); }
  .sv-list li:hover { padding-left: 0.6rem; color: var(--moss); }
  .sv-list__n { font: italic 300 1.15rem var(--font-serif); color: var(--eucalyptus); min-width: 2ch; }

  .sv-pillars { position: relative; overflow: hidden; background: var(--grad-dark); color: var(--cream); padding-block: clamp(64px, 8vw, 110px); border-radius: var(--r-l); margin-inline: clamp(0px, 1.5vw, 20px); }
  .sv-pillars__row { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.2rem; margin-top: 1.8rem; }
  .sv-pillar { display: flex; gap: 1.6rem; align-items: center; padding: 1.6rem 1.8rem; border-radius: var(--r); }
  .sv-pillar__l { font: italic 300 5rem/0.85 var(--font-serif); color: var(--champagne); }
  .sv-pillar h2 { font-size: 1.9rem; font-weight: 340; }
  .sv-pillar p { opacity: 0.8; }

  .sv-head { display: grid; gap: 1.2rem; margin-bottom: clamp(36px, 5vw, 64px); }
  .sv-head h2 { font-size: var(--h2); }
  .sv-steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 2rem; }
  .sv-steps li { display: grid; gap: 0.6rem; align-content: start; padding-top: 1.4rem; border-top: 1px solid var(--hair); }
  .sv-steps__n { font: italic 300 1.4rem var(--font-serif); color: var(--eucalyptus); }
  .sv-steps h3 { font-size: 1.6rem; font-weight: 340; }
  .sv-steps p { font-size: 0.95rem; color: rgb(43 52 47 / 0.75); }
  .sv-formats { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem; margin-top: 2.6rem; color: rgb(43 52 47 / 0.7); }
  .sv-formats span { padding: 0.5rem 1rem; border-radius: var(--pill); border: 1px solid var(--hair); background: rgb(255 255 255 / 0.5); color: var(--ink); font-size: 0.9rem; }

  .sv-more { overflow: hidden; background: var(--grad-soft); border-radius: var(--r-l) var(--r-l) 0 0; }
  .sv-nav { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1rem; margin-bottom: clamp(48px, 6vw, 80px); padding-bottom: 1.5rem; border-bottom: 1px solid var(--hair); }
  .sv-nav a { font: 300 clamp(1.2rem, 2vw, 1.7rem) var(--font-serif); text-decoration: none; transition: color 0.3s var(--ease); }
  .sv-nav a:hover { color: var(--eucalyptus); }
  .sv-others { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.4rem; }

  .sv-cta { position: relative; overflow: hidden; background: var(--grad-dark); color: var(--cream); padding-block: clamp(80px, 10vw, 140px); }
  .sv-cta__inner { display: grid; justify-items: center; text-align: center; gap: 2rem; }
  .sv-cta h2 { font-size: clamp(2.4rem, 5vw, 4.4rem); font-weight: 300; max-width: 18ch; }

  @media (max-width: 1000px) {
    .sv-others { grid-template-columns: 1fr 1fr; }
    .sv-others > :global(:nth-child(3)) { display: none; }
    .sv-steps { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 800px) {
    .sv-hero__grid, .sv-body { grid-template-columns: 1fr; }
    .sv-intro { position: static; }
    .sv-hero__visual { max-width: 420px; }
  }
  @media (max-width: 600px) {
    .sv-others, .sv-steps { grid-template-columns: 1fr; }
    .sv-others > :global(:nth-child(3)) { display: block; }
    .sv-hero .btn { width: 100%; }
  }
</style>
