---
import Base from '../../layouts/Base.astro';
import Ticket from '../../components/Ticket.astro';
import Phones from '../../components/Phones.astro';
import ServiceMock from '../../components/ServiceMock.astro';
import Shape from '../../components/Shape.astro';
import Scene3D from '../../components/Scene3D.astro';
import { services, pillars, steps, type Service } from '../../config/site';

export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug }, props: { service: s } }));
}

const { service: s } = Astro.props as { service: Service };
const idx = services.findIndex((x) => x.slug === s.slug);
const prev = services[(idx - 1 + services.length) % services.length];
const next = services[(idx + 1) % services.length];
const related = pillars.filter((p) => s.pillars.includes(p.letter));
const others = [1, 2, 3].map((k) => services[(idx + k) % services.length]);
---

<Base title={`${s.title} | SAGE Creative Studio`} description={`${s.title} : ${s.promise}`}>
  <section class="sv-hero" data-theme="cream">
    <div class="orbs" aria-hidden="true">
      <span class="orb orb--sage" style="width:700px;height:700px;left:-220px;top:-200px;--d:26s"></span>
      <span class="orb orb--champagne" style="width:520px;height:520px;right:-140px;top:80px;--d:30s"></span>
      <span class="orb orb--blush" style="width:500px;height:500px;left:35%;bottom:-260px;--d:34s"></span>
    </div>
    <div class="container sv-hero__grid rel">
      <div class="sv-hero__text">
        <a href="/#services" class="sv-back link">← Tous les services</a>
        <p class="eyebrow reveal">Service N° {s.num}</p>
        <h1 class="reveal" style="--rd:.08s">{s.title}</h1>
        <p class="lead reveal" style="--rd:.16s">{s.promise}</p>
        <div class="reveal" style="--rd:.24s">
          <a href={`/?service=${s.slug}#contact`} class="btn btn--primary">Discuter de ce service <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <div class="sv-hero__visual reveal" style="--rd:.1s">
        <Scene3D slug={s.slug} />
      </div>
    </div>
  </section>

  <section class="section" data-theme="cream">
    <div class="container sv-body">
      <div class="sv-stage reveal">
        <ServiceMock slug={s.slug} />
      </div>
      <div class="sv-what">
        <p class="eyebrow reveal">Ce que ça comprend</p>
        <h2 class="reveal" style="--rd:.06s">Trois choses, <em>bien faites.</em></h2>
        <div class="sv-groups">
          {
            s.groups.map((g, i) => (
              <div class="sv-group reveal" style={`--rd:${0.1 + i * 0.08}s`} tabindex={g.d ? 0 : undefined}>
                <span class="sv-group__ic"><Shape name={(['leaf', 'half', 'circle'] as const)[i % 3]} color={['var(--sage)', 'var(--ochre)', 'var(--clay)'][i % 3]} /></span>
                <div>
                  <h3>{g.t}</h3>
                  <div class="sv-group__swap">
                    <p class="split sv-group__kw">{g.items.map((it) => <span>{it}</span>)}</p>
                    {g.d && <p class="sv-group__def">{g.d}</p>}
                  </div>
                </div>
              </div>
            ))
          }
        </div>
        {s.note && <p class="sv-note bubble reveal">{s.note}</p>}
      </div>
    </div>
  </section>

  {s.slug === 'content-creation' && <Phones />}

  <section class="sv-pillars on-dark" data-theme="sage">
    <div class="orbs" aria-hidden="true">
      <span class="orb orb--champagne" style="width:520px;height:520px;right:-140px;top:-180px;opacity:.35;--d:26s"></span>
    </div>
    <div class="container rel">
      <p class="eyebrow reveal">Le mindset derrière ce service</p>
      <div class="sv-pillars__row">
        {
          related.map((p, i) => (
            <div class="sv-pillar glass reveal" style={`--rd:${i * 0.1}s`}>
              <span class="sv-pillar__l">{p.letter}</span>
              <div>
                <h2>{p.name}</h2>
                <p>{p.verbs}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" data-theme="cream">
    <div class="container">
      <div class="sv-head">
        <p class="eyebrow reveal">Comment on travaille ensemble</p>
        <h2 class="reveal" style="--rd:.08s">Simple, cadré, <em>sans surprise.</em></h2>
      </div>
      <ol class="sv-steps">
        {
          steps.map((st, i) => (
            <li class="reveal" style={`--rd:${i * 0.08}s`}>
              <span class="sv-steps__n">{st.num}</span>
              <h3>{st.title}</h3>
              <p>{st.text}</p>
            </li>
          ))
        }
      </ol>
      <p class="sv-formats reveal">Formats possibles&nbsp;: <span>Mission ponctuelle</span><span>Accompagnement mensuel</span><span>Sur mesure</span></p>
    </div>
  </section>

  <section class="section sv-more" data-theme="cream">
    <div class="orbs" aria-hidden="true">
      <span class="orb orb--mist" style="width:640px;height:640px;left:-200px;top:0;--d:26s"></span>
      <span class="orb orb--champagne" style="width:520px;height:520px;right:-160px;bottom:-160px;opacity:.5;--d:30s"></span>
    </div>
    <div class="container rel">
      <div class="sv-nav">
        <a href={`/services/${prev.slug}`}>← {prev.title}</a>
        <a href={`/services/${next.slug}`}>{next.title} →</a>
      </div>
      <p class="eyebrow reveal" style="margin-bottom:2rem">Les autres expertises</p>
      <div class="sv-others">
        {others.map((o, i) => <Ticket service={o} delay={i * 0.1} />)}
      </div>
    </div>
  </section>

  <section class="sv-cta on-dark" data-theme="sage">
    <div class="orbs" aria-hidden="true">
      <span class="orb orb--champagne" style="width:520px;height:520px;right:10%;top:-220px;opacity:.35;--d:26s"></span>
    </div>
    <div class="container sv-cta__inner rel reveal">
      <h2>Un projet en <em>{s.title.toLowerCase()}</em>&nbsp;?</h2>
      <a href={`/?service=${s.slug}#contact`} class="btn btn--primary">Parlons-en <span aria-hidden="true">→</span></a>
    </div>
  </section>
</Base>

<style>
  .sv-body { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: clamp(2rem, 6vw, 5.5rem); align-items: center; }
  .sv-what { display: grid; gap: 1.2rem; align-content: start; }
  .sv-what h2 { font-size: clamp(2rem, 3.6vw, 3.2rem); }
  .sv-groups { display: grid; gap: 0.9rem; margin-top: 0.6rem; }
  .sv-group { display: grid; grid-template-columns: auto 1fr; gap: 1.1rem; align-items: center; padding: 1.1rem 1.3rem; border-radius: 22px; background: rgb(255 255 255 / 0.6); box-shadow: 0 1px 1px rgb(0 0 0 / 0.03), 0 18px 40px -26px rgb(42 28 20 / 0.35), inset 0 0.5px 0 rgb(255 255 255 / 0.9); transition: transform 0.5s var(--ease-out), background 0.4s var(--ease); }
  /* Au survol (ou au focus), la fiche se transforme et donne une courte définition */
  .sv-group { cursor: default; outline: none; transition: transform 0.5s var(--ease-out), background 0.5s var(--ease), color 0.5s var(--ease); }
  .sv-group:hover, .sv-group:focus-visible { transform: translateX(6px); background: var(--choco); color: #f3ede4; }
  .sv-group__swap { display: grid; }
  .sv-group__swap > p { grid-area: 1 / 1; align-self: center; transition: opacity 0.45s var(--ease), filter 0.5s var(--ease-out), transform 0.5s var(--ease-out); }
  .sv-group__def { opacity: 0; filter: blur(8px); transform: translateY(6px); font-size: 0.92rem; line-height: 1.45; }
  .sv-group:hover .sv-group__def, .sv-group:focus-visible .sv-group__def { opacity: 1; filter: none; transform: none; color: rgb(243 237 228 / 0.86); }
  .sv-group:has(.sv-group__def):hover .sv-group__kw, .sv-group:has(.sv-group__def):focus-visible .sv-group__kw { opacity: 0; filter: blur(8px); transform: translateY(-6px); }
  .sv-group:hover h3, .sv-group:focus-visible h3 { color: var(--blush); }
  .sv-group__ic { width: 44px; display: block; }
  .sv-group__ic :global(.shape) { width: 100%; height: auto; }
  .sv-group h3 { font-size: 1.15rem; margin-bottom: 0.2rem; }
  .sv-group__kw { font-size: 0.92rem; color: rgb(30 26 22 / 0.65); column-gap: 0.9em; }
  .sv-note { justify-self: start; font-size: 0.85rem; padding: 0.7rem 1.1rem; border-radius: 16px; }
  @media (max-width: 900px) { .sv-body { grid-template-columns: 1fr; } }

  .rel { position: relative; z-index: 1; }
  .sv-hero { position: relative; overflow: hidden; background: var(--grad-soft); padding: 150px 0 clamp(70px, 9vw, 120px); }
  .sv-hero__grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 6vw, 6rem); align-items: center; }
  .sv-hero__text { display: grid; gap: 1.5rem; justify-items: start; }
  .sv-back { font-size: 0.88rem; color: rgb(30 26 22 / 0.7); }
  .sv-hero h1 { font-size: clamp(3rem, 6.6vw, 6rem); font-weight: 560; }
  .sv-hero__visual { position: relative; }
  .sv-photo { aspect-ratio: 4 / 5; box-shadow: var(--shadow); }
  .sv-photo img { width: 100%; height: 100%; }
  .sv-tag { position: absolute; left: 0; bottom: 10%; display: grid; gap: 0.2rem; padding: 1rem 1.3rem; border-radius: var(--r-s); }
  .sv-tag span { font: 300 1.3rem var(--font-ui); font-stretch: 125%; letter-spacing: -0.04em; color: var(--eucalyptus); }
  .sv-tag em { font-style: normal; font-size: 0.8rem; letter-spacing: 0.1em; text-transform: uppercase; }


  .sv-pillars { position: relative; overflow: hidden; background: var(--grad-dark); color: var(--ink); padding-block: clamp(64px, 8vw, 110px); border-radius: var(--r-l); margin-inline: clamp(0px, 1.5vw, 20px); }
  .sv-pillars__row { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.2rem; margin-top: 1.8rem; }
  .sv-pillar { display: flex; gap: 1.6rem; align-items: center; padding: 1.6rem 1.8rem; border-radius: var(--r); }
  .sv-pillar__l { font: 300 5rem/0.85 var(--font-ui); font-stretch: 125%; letter-spacing: -0.04em; color: var(--ink); }
  .sv-pillar h2 { font-size: 1.9rem; font-weight: 560; }
  .sv-pillar p { opacity: 0.8; }

  .sv-head { display: grid; gap: 1.2rem; margin-bottom: clamp(36px, 5vw, 64px); }
  .sv-head h2 { font-size: var(--h2); }
  .sv-steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 2rem; }
  .sv-steps li { display: grid; gap: 0.6rem; align-content: start; padding-top: 1.4rem; border-top: 1px solid var(--hair); }
  .sv-steps__n { font: 300 1.4rem var(--font-ui); font-stretch: 125%; letter-spacing: -0.04em; color: var(--eucalyptus); }
  .sv-steps h3 { font-size: 1.6rem; font-weight: 560; }
  .sv-steps p { font-size: 0.95rem; color: rgb(30 26 22 / 0.75); }
  .sv-formats { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem; margin-top: 2.6rem; color: rgb(30 26 22 / 0.7); }
  .sv-formats span { padding: 0.55rem 1.1rem; border-radius: var(--pill); color: var(--ink); font-weight: 500; font-size: 0.9rem; background: rgb(255 255 255 / 0.62); backdrop-filter: blur(20px) saturate(1.8); -webkit-backdrop-filter: blur(20px) saturate(1.8); border: 0; box-shadow: 0 1px 1px rgb(0 0 0 / 0.03), 0 10px 24px -14px rgb(30 26 22 / 0.35), inset 0 0.5px 0 rgb(255 255 255 / 0.9); }

  .sv-more { overflow: hidden; background: var(--grad-soft); border-radius: var(--r-l) var(--r-l) 0 0; }
  .sv-nav { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1rem; margin-bottom: clamp(48px, 6vw, 80px); padding-bottom: 1.5rem; border-bottom: 1px solid var(--hair); }
  .sv-nav a { font: 300 clamp(1.2rem, 2vw, 1.7rem) var(--font-ui); font-stretch: 125%; letter-spacing: -0.04em; text-decoration: none; transition: color 0.3s var(--ease); }
  .sv-nav a:hover { color: var(--eucalyptus); }
  .sv-others { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.4rem; }

  .sv-cta { position: relative; overflow: hidden; background: var(--grad-dark); color: var(--ink); padding-block: clamp(80px, 10vw, 140px); }
  .sv-cta__inner { display: grid; justify-items: center; text-align: center; gap: 2rem; }
  .sv-cta h2 { font-size: clamp(2.4rem, 5vw, 4.4rem); font-weight: 560; max-width: 18ch; }

  @media (max-width: 1000px) {
    .sv-others { grid-template-columns: 1fr 1fr; }
    .sv-others > :global(:nth-child(3)) { display: none; }
    .sv-steps { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 800px) {
    .sv-hero__grid, .sv-body { grid-template-columns: 1fr; }
    .sv-hero__visual { max-width: 520px; width: 100%; margin-inline: auto; }
  }
  @media (max-width: 600px) {
    .sv-others, .sv-steps { grid-template-columns: 1fr; }
    .sv-others > :global(:nth-child(3)) { display: block; }
    .sv-hero .btn { width: 100%; }
  }
</style>
