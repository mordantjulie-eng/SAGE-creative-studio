---
import Base from '../layouts/Base.astro';
import Ticket from '../components/Ticket.astro';
import Tickers from '../components/Tickers.astro';
import ContactForm from '../components/ContactForm.astro';
import { brand, services, pillars, steps, partners } from '../config/site';

// Photos Unsplash = illustrations provisoires (aucune ne représente Julie).
const m = (n: string) => `/media/${n}.jpg`;
const shapes: Record<string, string> = {
  leaf: 'M0 100 V45 A55 55 0 0 1 55 -10 H100 V45 A55 55 0 0 1 45 100 Z',
  half: 'M0 30 H100 A50 50 0 0 1 0 30 Z',
  arch: 'M0 100 V50 A50 50 0 0 1 100 50 V100 Z',
  dot: 'M50 18 A32 32 0 1 1 49.9 18 Z',
};
const rots = [-2.2, 1.6, -1.2, 2, -1.6, 1.1];
const arrow = '<svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 10 10 2M4 2h6v6" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>';
const under = '<svg viewBox="0 0 300 24" preserveAspectRatio="none" aria-hidden="true"><path d="M4 16 C 80 6, 170 4, 296 10 M 40 21 C 120 13, 200 13, 270 17"/></svg>';
const circle = '<svg viewBox="0 0 300 120" preserveAspectRatio="none" aria-hidden="true"><path d="M150 8 C 60 6, 8 30, 10 62 C 12 98, 90 114, 170 110 C 250 106, 296 82, 290 52 C 284 20, 210 4, 120 12"/></svg>';
const work = [
  { img: 'team-laugh', cat: 'Strategy & Consulting', n: '01' },
  { img: 'swatches', cat: 'Branding & Art Direction', n: '02' },
  { img: 'creator-tee', cat: 'Content Creation', n: '03' },
  { img: 'social-apps', cat: 'Community Management', n: '04' },
];
---

<Base>
  <!-- ================= 01 HERO ================= -->
  <section class="hero on-dark" data-parallax-root>
    <div class="hero__stage">
      <div class="fl fl--a float" style="--d:7s;--r:-5deg" data-depth="18"><img class="photo" src={m('moodboard')} alt="" /></div>
      <div class="fl fl--b float" style="--d:8s;--r:5deg;--delay:-2s" data-depth="10"><img class="photo" src={m('flatlay')} alt="" /></div>
      <div class="fl fl--c float" style="--d:6s;--r:-8deg;--delay:-1s" data-depth="26"><img class="photo" src={m('swatches')} alt="" /></div>

      <a href="#services" class="fl chip fl--s1 float" style="--d:5s;--r:-6deg" data-depth="30">01 Community</a>
      <a href="#services" class="fl chip chip--ochre fl--s2 float" style="--d:6.5s;--r:5deg;--delay:-3s" data-depth="22">02 Content</a>
      <a href="#services" class="fl chip chip--rust fl--s3 float" style="--d:5.5s;--r:-3deg;--delay:-1.5s" data-depth="34">05 Influence</a>
      <a href="#services" class="fl chip chip--soft fl--s4 float" style="--d:7s;--r:4deg;--delay:-4s" data-depth="16">06 IA</a>

      <div class="fl notif fl--notif float" style="--d:6s;--delay:-2.5s" data-depth="20" aria-hidden="true">
        <span class="notif__dot"></span>
        <div><strong>Nouveau brief</strong><br /><span>« On veut une marque qui se remarque. »</span></div>
      </div>

      <div class="fl phone fl--phone float" style="--d:7.5s;--r:6deg;--delay:-1s" data-depth="12" aria-hidden="true">
        <div class="phone__screen">
          <div class="feed">{['creator-red', 'flatlay', 'creator-hoodie', 'swatches', 'creator-red'].map((f) => <img class="photo" src={m(f)} alt="" />)}</div>
          <div class="phone__ui"><span class="heart">♥</span><span class="heart">♥</span><span class="heart">♥</span></div>
        </div>
      </div>

      <a href="#services" class="badge fl fl--badge" data-depth="8" aria-label="Voir les services">
        <svg viewBox="0 0 120 120" class="badge__ring" aria-hidden="true">
          <defs><path id="circ" d="M60 60 m-46 0 a46 46 0 1 1 92 0 a46 46 0 1 1 -92 0"></path></defs>
          <text><textPath href="#circ">THINK • CREATE • GROW • EVOLVE • </textPath></text>
        </svg>
        <span class="badge__arrow">↓</span>
      </a>

      <div class="hero__center">
        <p class="label hero__kicker">{brand.name}. {brand.descriptor} · {brand.location}</p>
        <h1 class="hero__title">
          Le studio créatif qui fait <span class="mark mark--under">grandir<Fragment set:html={under} /></span> les marques.
        </h1>
        <p class="hero__lead">
          Community management, création de contenu, stratégie, branding, influence et formation à l'IA :
          tout ce qu'il faut pour que votre marque se voie, se comprenne et se choisisse.
        </p>
        <div class="hero__ctas">
          <a href="#services" class="btn btn--primary">Découvrir les services <span class="arrow"><Fragment set:html={arrow} /></span></a>
          <a href="#contact" class="btn btn--ghost">Parlons de votre projet</a>
        </div>
        <p class="hand hero__hand" aria-hidden="true">Creative thinking. Digital impact.</p>
      </div>
    </div>
  </section>

  <Tickers />

  <!-- ================= 02 SERVICES ================= -->
  <section id="services" class="section services">
    <div class="container">
      <div class="head head--row">
        <div class="reveal">
          <p class="label">02 — Services</p>
          <h2>Six façons de faire<br />avancer votre <span class="mark mark--circle" style="--mark:var(--sage-rust)">marque<Fragment set:html={circle} /></span>.</h2>
        </div>
        <div class="head__aside reveal" style="--rd:.1s">
          <p>Chaque service peut être pris seul, en mission ponctuelle ou en accompagnement mensuel. Retournez un ticket pour voir ce qu'il contient.</p>
          <p class="hand head__hand" aria-hidden="true">↻ retournez-moi !</p>
        </div>
      </div>
      <div class="tickets">
        {services.map((s, i) => <Ticket service={s} rot={rots[i]} delay={(i % 3) * 0.08} />)}
      </div>
      <div class="services__note reveal">
        <span class="chip chip--forest">Un besoin hybride ?</span>
        <p>Les services se combinent. On compose ensemble l'accompagnement qui colle à votre réalité et à votre budget.</p>
        <a href="#contact" class="services__link">En parler →</a>
      </div>
    </div>
  </section>

  <!-- ================= 03 MINDSET ================= -->
  <section id="mindset" class="mindset on-dark">
    <div class="container">
      <div class="head head--row">
        <div class="reveal">
          <p class="label">03 — The SAGE Mindset</p>
          <h2>Quatre lettres.<br />Une façon de penser.</h2>
        </div>
        <p class="head__aside reveal" style="--rd:.1s">
          S.A.G.E. n'est pas une liste de services : c'est la méthode qui guide chacun d'eux. Cliquez sur une lettre.
        </p>
      </div>

      <div class="sage" data-tabs>
        <div class="sage__letters" role="tablist" aria-label="Les quatre piliers S.A.G.E.">
          {
            pillars.map((p, i) => (
              <button
                class="sage__tab reveal"
                style={`--rd:${i * 0.1}s`}
                role="tab"
                id={`tab-${p.letter}`}
                aria-controls={`panel-${p.letter}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? 0 : -1}
              >
                <svg class="sage__shape" viewBox="0 0 100 100" style={`color:${p.color}`} aria-hidden="true">
                  <path d={shapes[p.shape]} fill="currentColor" />
                </svg>
                <span class="sage__letter">{p.letter}</span>
                <span class="sage__name">{p.name}</span>
              </button>
            ))
          }
        </div>
        {
          pillars.map((p, i) => (
            <div class="sage__panel" role="tabpanel" id={`panel-${p.letter}`} aria-labelledby={`tab-${p.letter}`} hidden={i !== 0}>
              <div class="sage__card">
                <p class="sage__big" aria-hidden="true">{p.letter}</p>
                <div class="sage__content">
                  <p class="label">{p.letter} — {p.name}</p>
                  <h3>{p.verbs}</h3>
                  <p>{p.text}</p>
                  <div class="sage__in">
                    <span class="sage__inlabel">Au cœur de :</span>
                    {services
                      .filter((s) => s.pillars.includes(p.letter))
                      .map((s) => (
                        <a class="chip" href={`/services/${s.slug}`}>
                          {s.num} {s.title}
                        </a>
                      ))}
                  </div>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ================= 04 WORK ================= -->
  <section id="projets" class="section">
    <div class="container head head--row">
      <div class="reveal">
        <p class="label">04 — Selected Work</p>
        <h2>La vitrine<br />se prépare.</h2>
      </div>
      <p class="head__aside reveal" style="--rd:.1s">
        Les premières études de cas du studio arriveront ici, avec le contexte, la démarche et les résultats, validés par les clients.
      </p>
    </div>
    <div class="slider" data-slider>
      {
        work.map((w, i) => (
          <article class="case reveal" style={`--rd:${i * 0.06}s;--r:${[-2, 1.5, -1, 2][i]}deg`} data-cursor="Bientôt ✦">
            <div class="case__img">
              <img class="photo" src={m(w.img)} alt="" />
              <span class="case__stamp">En préparation</span>
            </div>
            <div class="case__label">
              <span class="label">{w.cat}</span>
              <span class="case__n">Case #{w.n}</span>
            </div>
          </article>
        ))
      }
      <article class="case case--cta reveal" style="--r:-1deg">
        <p class="hand">et si le prochain, c'était le vôtre ?</p>
        <a href="#contact" class="btn btn--primary">Proposer un projet <span class="arrow"><Fragment set:html={arrow} /></span></a>
      </article>
    </div>
    <p class="container work__credit">Visuels d'illustration (Unsplash).</p>
  </section>

  <!-- ================= 05 ABOUT ================= -->
  <section id="studio" class="section about">
    <div class="container about__grid">
      <div class="about__visual reveal">
        <figure class="polaroid float" style="--r:-4deg;--d:8s;--fy:-8px">
          <span class="tape" style="top:-14px;left:50%;translate:-50% 0;rotate:-3deg"></span>
          <div class="polaroid__photo">
            <span class="hand">ta photo ici ✦</span>
          </div>
          <figcaption class="hand">Julie, fondatrice</figcaption>
        </figure>
        <span class="chip chip--ochre about__sticker float" style="--r:8deg;--d:6s">100 % indépendante</span>
        <span class="chip chip--rust about__sticker about__sticker--2 float" style="--r:-6deg;--d:7s;--delay:-2s">basée en Belgique</span>
      </div>
      <div class="about__text">
        <p class="label reveal">05 — About the Studio</p>
        <h2 class="reveal">Derrière SAGE,<br />il y a <span class="mark mark--under">Julie<Fragment set:html={under} /></span>.</h2>
        <p class="reveal" style="--rd:.1s">
          Marketing, réseaux sociaux, contenu, influence, business et IA : j'ai passé ces dernières années à voir
          de l'intérieur ce qui fait avancer une marque, et ce qui la freine. SAGE est né de l'envie de réunir
          tout ça au même endroit, avec plus de sens et moins de jargon.
        </p>
        <div class="crew reveal" style="--rd:.15s">
          <h3>Seule aux commandes. Jamais seule au travail.</h3>
          <p>
            Pour les tournages, les shootings et le design graphique, je m'entoure de partenaires de confiance.
            Vous gardez un seul interlocuteur : moi.
          </p>
          <ul class="crew__list">
            {partners.map((p, i) => <li class={`chip chip--${p.sticker}`} style={`--r:${[-3, 2, -2, 3][i]}deg`}>{p.label}</li>)}
          </ul>
        </div>
        <a href="/studio" class="btn btn--primary reveal" style="--rd:.2s">Découvrir le studio <span class="arrow"><Fragment set:html={arrow} /></span></a>
      </div>
    </div>
  </section>

  <!-- ================= 06 CONTACT ================= -->
  <section id="contact" class="contact on-dark">
    <span class="chip chip--ochre contact__f1 float" style="--r:-8deg;--d:5s" aria-hidden="true">Allons-y !</span>
    <div class="container contact__grid">
      <div class="contact__intro">
        <p class="label reveal">06 — Let's work together</p>
        <h2 class="reveal">Créons quelque chose<br />qui <span class="u-ochre">compte.</span></h2>
        <p class="reveal" style="--rd:.1s">Un projet, une marque à clarifier, une idée encore floue : racontez-moi en quelques lignes. Je vous réponds sous 48 h ouvrées.</p>
        <ol class="mini-steps">
          {
            steps.map((s, i) => (
              <li class="mini reveal" style={`--rd:${0.1 + i * 0.07}s;--r:${[-1.5, 1, -1, 1.5][i]}deg`}>
                <span class="mini__num">{s.num}</span>
                <span>
                  <strong>{s.title}</strong> {s.text}
                </span>
              </li>
            ))
          }
        </ol>
      </div>
      <div class="reveal" style="--rd:.15s">
        <ContactForm />
      </div>
    </div>
  </section>

  <div class="cursor" aria-hidden="true"><span></span></div>
</Base>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fine = window.matchMedia('(pointer: fine)').matches;

  // Parallaxe souris (hero)
  const root = document.querySelector<HTMLElement>('[data-parallax-root]');
  if (root && fine && !reduce) {
    const items = root.querySelectorAll<HTMLElement>('[data-depth]');
    root.addEventListener('pointermove', (e) => {
      const r = root.getBoundingClientRect();
      const x = (e.clientX - r.left) / r.width - 0.5;
      const y = (e.clientY - r.top) / r.height - 0.5;
      items.forEach((el) => (el.style.translate = `${-x * Number(el.dataset.depth)}px ${-y * Number(el.dataset.depth)}px`));
    });
  }

  // Onglets S.A.G.E. (clic + flèches clavier)
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('.sage__tab')];
  const select = (t: HTMLButtonElement) => {
    tabs.forEach((x) => {
      const on = x === t;
      x.setAttribute('aria-selected', String(on));
      x.tabIndex = on ? 0 : -1;
      document.getElementById(x.getAttribute('aria-controls')!)!.hidden = !on;
    });
  };
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => select(t));
    t.addEventListener('keydown', (e) => {
      const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (!d) return;
      e.preventDefault();
      const n = tabs[(i + d + tabs.length) % tabs.length];
      select(n);
      n.focus();
    });
  });

  // Curseur bulle
  const cursor = document.querySelector<HTMLElement>('.cursor');
  if (cursor && fine && !reduce) {
    const label = cursor.querySelector('span')!;
    let x = 0, y = 0, cx = 0, cy = 0;
    window.addEventListener('pointermove', (e) => { x = e.clientX; y = e.clientY; });
    const loop = () => { cx += (x - cx) * 0.18; cy += (y - cy) * 0.18; cursor.style.transform = `translate(${cx}px, ${cy}px)`; requestAnimationFrame(loop); };
    loop();
    document.querySelectorAll<HTMLElement>('[data-cursor]').forEach((el) => {
      el.addEventListener('pointerenter', () => { label.textContent = el.dataset.cursor!; cursor.classList.add('is-on'); });
      el.addEventListener('pointerleave', () => cursor.classList.remove('is-on'));
    });
  }

  // Slider : glisser à la souris
  const slider = document.querySelector<HTMLElement>('[data-slider]');
  if (slider) {
    let down = false, sx = 0, sl = 0;
    slider.addEventListener('pointerdown', (e) => { if (e.pointerType !== 'mouse') return; down = true; sx = e.clientX; sl = slider.scrollLeft; slider.classList.add('is-drag'); });
    window.addEventListener('pointerup', () => { down = false; slider.classList.remove('is-drag'); });
    slider.addEventListener('pointermove', (e) => { if (down) slider.scrollLeft = sl - (e.clientX - sx); });
  }
</script>

<style>
  .u-ochre { color: var(--sage-ochre); }
  .head { display: grid; gap: 1.1rem; margin-bottom: clamp(40px, 6vw, 80px); }
  .head--row { display: flex; justify-content: space-between; align-items: end; gap: 2rem 4rem; flex-wrap: wrap; }
  .head h2, .about h2, .contact h2 { font-size: var(--h2); }
  .head .label { margin-bottom: 1.1rem; }
  .head__aside { max-width: 25rem; }
  .head__hand { color: var(--sage-rust); margin-top: 0.6rem; rotate: -4deg; }

  /* ---------- HERO ---------- */
  .hero {
    position: relative;
    background: radial-gradient(60% 50% at 50% 45%, rgb(196 154 84 / 0.12), transparent 70%), var(--sage-forest);
    color: var(--sage-ivory);
    border-radius: 0 0 var(--radius-l) var(--radius-l);
    overflow: hidden;
  }
  .hero__stage { position: relative; min-height: max(100svh, 780px); display: grid; place-items: center; padding: 130px var(--gutter) 90px; }
  .hero__center { position: relative; z-index: 2; display: grid; justify-items: center; text-align: center; gap: 1.5rem; max-width: 980px; }
  .hero__kicker { opacity: 0.75; }
  .hero__title { font-size: var(--h1); }
  .hero__title .mark svg { --mark: var(--sage-ochre); stroke-width: 4; }
  .hero__lead { max-width: 40rem; font-size: clamp(1.02rem, 1.35vw, 1.22rem); opacity: 0.92; }
  .hero__ctas { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem; }
  .hero__hand { color: var(--sage-ochre); rotate: -3deg; font-size: 1.7rem; }

  .fl { position: absolute; z-index: 3; transition: translate 0.6s var(--ease); }
  .fl img { width: 100%; height: 100%; }
  .fl--a { left: 5%; top: 17%; width: 170px; height: 170px; border-radius: 50%; overflow: hidden; border: 6px solid var(--sage-ivory); box-shadow: var(--shadow); }
  .fl--b { left: 7%; bottom: 9%; width: 230px; height: 160px; border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow); }
  .fl--c { right: 5%; bottom: 8%; width: 115px; height: 115px; border-radius: 30px; overflow: hidden; box-shadow: var(--shadow); }
  .fl--s1 { left: 19%; top: 15%; }
  .fl--s2 { right: 20%; top: 14%; }
  .fl--s3 { left: 19%; bottom: 31%; }
  .fl--s4 { right: 15%; bottom: 31%; }
  .fl--notif { left: 2%; top: 50%; }
  .fl--phone { right: 3.5%; top: 18%; }
  .fl--badge { right: 21%; bottom: 6%; }
  a.fl.chip { transition: translate .6s var(--ease), scale .3s var(--spring); }
  a.fl.chip:hover { scale: 1.08; }

  .notif { display: flex; gap: 0.7rem; align-items: center; max-width: 240px; padding: 0.8rem 1rem; border-radius: 20px; background: rgb(244 239 230 / 0.95); color: var(--sage-ink); font-size: 0.8rem; line-height: 1.35; box-shadow: var(--shadow); }
  .notif strong { font-size: 0.85rem; }
  .notif span { opacity: 0.75; }
  .notif__dot { flex: none; width: 34px; height: 34px; border-radius: 50%; background: var(--sage-rust); box-shadow: inset 0 0 0 9px var(--sage-ochre); }

  .phone { width: 190px; aspect-ratio: 9 / 18.5; padding: 9px; border-radius: 34px; background: var(--sage-ink); box-shadow: var(--shadow), inset 0 0 0 1.5px rgb(255 255 255 / 0.12); }
  .phone__screen { position: relative; height: 100%; border-radius: 26px; overflow: hidden; background: var(--sage-forest-2); }
  .feed { display: grid; height: 500%; animation: feed 12s cubic-bezier(.7,0,.3,1) infinite; }
  .feed img { width: 100%; height: 100%; }
  @keyframes feed {
    0%, 20% { transform: translateY(0); }
    25%, 45% { transform: translateY(-20%); }
    50%, 70% { transform: translateY(-40%); }
    75%, 95% { transform: translateY(-60%); }
    100% { transform: translateY(-80%); }
  }
  .phone__ui { position: absolute; right: 10px; bottom: 16px; display: grid; gap: 4px; }
  .heart { color: #fff; font-size: 14px; opacity: 0; animation: heart 3s ease-out infinite; text-shadow: 0 2px 6px rgb(0 0 0 / .4); }
  .heart:nth-child(2) { animation-delay: 1s; color: var(--sage-ochre); }
  .heart:nth-child(3) { animation-delay: 2s; color: #f4b6a0; }
  @keyframes heart { 0% { transform: translateY(10px) scale(.6); opacity: 0; } 20% { opacity: 1; } 100% { transform: translateY(-90px) translateX(-10px) scale(1.2); opacity: 0; } }

  .badge { display: grid; place-items: center; width: 118px; height: 118px; border-radius: 50%; background: var(--sage-ochre); color: var(--sage-ink); text-decoration: none; }
  .badge__ring { position: absolute; inset: 0; width: 100%; height: 100%; animation: spin 14s linear infinite; }
  .badge__ring text { font: 800 10.4px var(--font-ui); letter-spacing: 0.2em; fill: currentColor; }
  .badge__arrow { font-size: 1.6rem; font-weight: 800; transition: transform .35s var(--spring); }
  .badge:hover .badge__arrow { transform: translateY(4px) scale(1.2); }

  :global(.tickers) { margin-top: -40px; }

  /* ---------- SERVICES ---------- */
  .tickets { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2.4rem 1.6rem; }
  .tickets > :global(.ticket:nth-child(3n + 2)) { margin-top: 48px; }
  .tickets > :global(.ticket:nth-child(3n + 3)) { margin-top: 18px; }
  .services__note { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.4rem; margin-top: clamp(48px, 6vw, 80px); padding: 1.2rem 1.6rem; border-radius: var(--pill); border: 2px dashed rgb(31 58 46 / 0.3); }
  .services__note p { flex: 1 1 20rem; }
  .services__link { font-weight: 800; text-decoration: none; border-bottom: 2px solid var(--sage-rust); }

  /* ---------- MINDSET ---------- */
  .mindset { background: var(--sage-forest); color: var(--sage-ivory); padding-block: var(--section-y); border-radius: var(--radius-l); margin-inline: clamp(0px, 1.5vw, 20px); }
  .mindset .head__aside { opacity: 0.85; }
  .sage__letters { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-bottom: 1.5rem; }
  .sage__tab {
    position: relative; display: grid; justify-items: start; align-content: end;
    min-height: 230px; padding: 1.2rem 1.4rem;
    border: 1.5px solid rgb(231 226 216 / 0.2); border-radius: var(--radius);
    background: rgb(231 226 216 / 0.04); color: var(--sage-ivory); cursor: pointer; text-align: left; overflow: hidden;
    transition: background .3s var(--ease), border-color .3s var(--ease), transform .45s var(--spring);
  }
  .sage__tab:hover { transform: translateY(-6px) rotate(-1deg); border-color: rgb(231 226 216 / 0.5); }
  .sage__tab[aria-selected='true'] { background: var(--sage-ivory); color: var(--sage-forest); border-color: var(--sage-ivory); }
  .sage__shape { position: absolute; right: 14px; top: 18px; width: 92px; height: 92px; transition: transform .6s var(--spring); }
