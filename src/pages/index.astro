---
import Base from '../layouts/Base.astro';
import '@fontsource/nothing-you-could-do';
import ContactForm from '../components/ContactForm.astro';
import Veil from '../components/Veil.astro';
import Timeline from '../components/Timeline.astro';
import FlipCard from '../components/FlipCard.astro';
import Envelope from '../components/Envelope.astro';
import PressedLogo from '../components/PressedLogo.astro';
import { brand, services, pillars, steps, partners } from '../config/site';

const m = (n: string) => `/media/${n}.jpg`;
import { siInstagram, siTiktok, siBrevo, siMailchimp, siMeta, siNotion } from 'simple-icons';
import { canvaPath, openaiPath } from '../assets/extra-icons';
// Outils du quotidien (logos monochromes, couleur héritée). Facile d'en ajouter ou d'en retirer ici.
const tools = [
  { name: 'Instagram', path: siInstagram.path },
  { name: 'TikTok', path: siTiktok.path },
  { name: 'LinkedIn', path: null },
  { name: 'Meta', path: siMeta.path },
  { name: 'Canva', path: canvaPath },
  { name: 'CapCut', path: null, word: 'CapCut' },
  { name: 'Notion', path: siNotion.path },
  { name: 'ChatGPT', path: openaiPath },
  { name: 'Brevo', path: siBrevo.path },
  { name: 'Mailchimp', path: siMailchimp.path },
  { name: 'Metricool', path: null, word: 'metricool' },
];
---

<Base>
  <!-- HERO : une affiche -->
  <section class="hero" data-theme="cream" data-hero>
    <div class="container hero__in">
      <div class="meta hero__meta reveal" style="--cols:4">
        <p><b>{brand.name} {brand.descriptor}</b><span>Studio créatif et digital</span></p>
        <p><b>{brand.location}</b><span>Lancement 2027</span></p>
        <p><b>Par Julie Mordant</b><span>Pour les marques qui osent</span></p>
        <p><b>Creative thinking.</b><span>Digital impact.</span></p>
      </div>

      <h1 class="hero__title" data-hero-title>
        <span class="hl">Le studio créatif</span>
        <span class="hl">qui fait <em data-text="grandir">grandir</em></span>
        <span class="hl">les marques.</span>
      </h1>

      <div class="hero__row">
        <div class="hero__copy">
          <p class="lead reveal" style="--rd:.5s">
            Stratégie, contenu, social media, branding, influence et formation à l'IA&nbsp;: tout ce qu'il faut pour
            que votre marque se voie, se comprenne et se choisisse.
          </p>
          <div class="hero__ctas reveal" style="--rd:.6s">
            <a href="#services" class="btn btn--primary">Découvrir les services <span aria-hidden="true">→</span></a>
            <a href="#contact" class="btn btn--glass">Parlons de votre projet</a>
          </div>
        </div>

        <div class="hero__visual reveal" style="--rd:.3s" aria-hidden="true">
          <span class="organic hero__blob"></span>
          <div class="hero__stamp float" style="--d:8s">
            <PressedLogo class="hero__logo" ink="#f6f1ea" shade="#7a1f3d" light="#ffffff" rim={false} />
            <p class="hero__hand">Creative<br />thinking.</p>
          </div>
        </div>

        <ul class="hero__side reveal" style="--rd:.7s" aria-label="Les expertises en bref">
          <li>Stratégie</li>
          <li>Contenu</li>
          <li>Social media</li>
          <li>Branding</li>
          <li>Influence</li>
          <li>IA</li>
        </ul>
      </div>
    </div>
  </section>

  <Veil />

  <!-- SERVICES : un index, comme le sommaire d'un livre -->
  <section id="services" class="svc" data-theme="sage" aria-label="Les six expertises">
    <div class="container">
      <div class="svc__grid">
        {services.map((s, i) => <FlipCard service={s} delay={(i % 3) * 0.08} />)}
      </div>
      <div class="svc__end reveal">
        <p>Un besoin qui touche à plusieurs expertises&nbsp;?</p>
        <a class="btn btn--primary" href="#contact">Composons sur mesure <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- MINDSET : quatre volets qui s'ouvrent -->
  <section id="mindset" class="section mindset" data-theme="taupe">
    <div class="container">
      <div class="head">
        <div>
          <p class="eyebrow reveal">The SAGE mindset</p>
          <h2 class="reveal" style="--rd:.08s">Quatre lettres, <em>une façon de penser</em></h2>
        </div>
        <p class="lead reveal" style="--rd:.16s">
          S.A.G.E. n'est pas une liste de services&nbsp;: c'est la méthode qui guide chacun d'eux.
        </p>
      </div>

      <div class="pils" data-pils>
        {
          pillars.map((p, i) => (
            <article class:list={['pil reveal', { 'is-on': i === 0 }]} style={`--rd:${i * 0.08}s`}>
              <button class="pil__head" type="button" aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`pil-${p.letter}`}>
                <span class="pil__letter">{p.letter}</span>
                <span class="pil__name">{p.name}</span>
              </button>
              <div class="pil__body" id={`pil-${p.letter}`}>
                <h3>{p.verbs}</h3>
                <p>{p.text}</p>
                <p class="pil__in">
                  <span>Au cœur de</span>
                  {services
                    .filter((s) => s.pillars.includes(p.letter))
                    .map((s) => (
                      <a href={`/services/${s.slug}`}>{s.title}</a>
                    ))}
                </p>
                <a class="btn btn--primary" href={`/mindset/${p.letter.toLowerCase()}`}>Lire mon point de vue <span aria-hidden="true">→</span></a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <Timeline />

  <!-- ABOUT -->
  <section id="studio" class="section about" data-theme="cream">
    <div class="container">
      <div class="about__grid">
        <div class="about__visual reveal">
          <div class="about__float">
            <div class="about__photo"><img src={m('julie-filming-2')} alt="Julie, fondatrice de SAGE Creative Studio" /></div>
            <p class="about__hand" aria-hidden="true">Julie</p>
          </div>
          <span class="about__shadow" aria-hidden="true"></span>
        </div>
        <div class="about__text">
          <p class="eyebrow reveal">About the studio</p>
          <h2 class="reveal" style="--rd:.08s">Derrière SAGE, <em>il y a Julie</em></h2>
          <p class="lead reveal" style="--rd:.16s">
            Marketing, réseaux sociaux, contenu, influence, business et IA&nbsp;: j'ai passé ces dernières années à
            voir de l'intérieur ce qui fait avancer une marque, et ce qui la freine. SAGE est né de l'envie de réunir
            tout ça au même endroit, avec plus de sens et moins de jargon.
          </p>
          <div class="crew reveal" style="--rd:.22s">
            <h3>Seule aux commandes, <em>jamais seule au travail.</em></h3>
            <p>
              Pour les tournages, les shootings et le design graphique, je m'entoure de partenaires de confiance. Vous
              gardez un seul interlocuteur&nbsp;: moi.
            </p>
            <ul class="crew__list">{partners.map((p) => <li class="bubble">{p.label}</li>)}</ul>
          </div>
          <a href="/studio" class="btn btn--primary reveal" style="--rd:.28s">Découvrir le studio <span aria-hidden="true">→</span></a>
        </div>
      </div>

      <div class="tools reveal">
        <p class="eyebrow">Au quotidien, avec</p>
        <ul class="tools__grid">
          {
            tools.map((t) => (
              <li class="tool" title={t.name}>
                <span class="tool__ic" aria-hidden="true">
                  {t.word ? (
                    <span class="tool__word">{t.word}</span>
                  ) : (
                    <svg viewBox="0 0 24 24" width="100%" height="100%">
                      {t.path ? (
                        <path d={t.path} fill="currentColor" />
                      ) : (
                        <>
                          <rect x="1.5" y="1.5" width="21" height="21" rx="4" fill="currentColor" />
                          <rect x="5.6" y="9.6" width="2.9" height="8.6" fill="var(--paper)" />
                          <circle cx="7.05" cy="6.6" r="1.7" fill="var(--paper)" />
                          <path d="M10.6 9.6h2.8v1.3c.5-.9 1.6-1.6 3-1.6 2.6 0 3.3 1.6 3.3 4v4.9h-2.9v-4.3c0-1.1-.2-2.1-1.5-2.1-1.4 0-1.8 1-1.8 2.1v4.3h-2.9z" fill="var(--paper)" />
                        </>
                      )}
                    </svg>
                  )}
                </span>
                <span class="tool__n">{t.name}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section id="contact" class="section contact" data-theme="cream">
    <span class="organic contact__blob" aria-hidden="true"></span>
    <div class="container contact__grid rel">
      <div class="contact__intro">
        <p class="reveal"><span class="flag">Réponse sous 48 h ouvrées</span></p>
        <p class="eyebrow reveal">Let's work together</p>
        <h2 class="reveal" style="--rd:.08s">Créons quelque chose <em>qui compte</em></h2>
        <p class="lead reveal" style="--rd:.16s">
          Un projet, une marque à clarifier, une idée encore floue&nbsp;: racontez-moi en quelques lignes. Je vous
          réponds sous 48&nbsp;h ouvrées.
        </p>
        <div class="reveal" style="--rd:.2s"><Envelope href={`mailto:${brand.email}`} /></div>
        <ol class="steps">
          {
            steps.map((s, i) => (
              <li class="reveal" style={`--rd:${0.2 + i * 0.07}s`}>
                <strong>{s.title}</strong>
                <span>{s.text}</span>
              </li>
            ))
          }
        </ol>
      </div>
      <div class="reveal" style="--rd:.2s"><ContactForm /></div>
    </div>
  </section>
</Base>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fine = window.matchMedia('(pointer: fine)').matches;

  // Hero : le titre sort du flou au chargement, puis y retourne quand on descend
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const title = document.querySelector<HTMLElement>('[data-hero-title]');
  if (hero && title) {
    requestAnimationFrame(() => title.classList.add('is-in'));
    if (!reduce) {
      let tick = false;
      const upd = () => {
        const p = Math.min(1, Math.max(0, window.scrollY / (hero.offsetHeight * 0.9)));
        title.style.setProperty('--hb', `${(p * 14).toFixed(2)}px`);
        title.style.setProperty('--hy', `${(p * -60).toFixed(1)}px`);
        tick = false;
      };
      window.addEventListener('scroll', () => { if (!tick) { tick = true; requestAnimationFrame(upd); } }, { passive: true });
    }
  }

  // Mindset : un volet ouvert à la fois (clic, clavier, ou survol à la souris)
  const pils = [...document.querySelectorAll<HTMLElement>('.pil')];
  const open = (el: HTMLElement) =>
    pils.forEach((p) => {
      const on = p === el;
      p.classList.toggle('is-on', on);
      p.querySelector('.pil__head')!.setAttribute('aria-expanded', String(on));
    });
  pils.forEach((p) => {
    p.querySelector('.pil__head')!.addEventListener('click', () => open(p));
    if (fine) p.addEventListener('pointerenter', () => open(p));
  });
</script>

<style>
  .head { display: flex; justify-content: space-between; align-items: end; flex-wrap: wrap; gap: 1.5rem 4rem; margin-bottom: clamp(40px, 5vw, 80px); }
  .head > div { display: grid; gap: 1.2rem; }
  .head h2 { font-size: var(--h2); max-width: 14ch; }
  .head .lead { max-width: 24rem; }

  /* HERO */
  .hero { position: relative; overflow: hidden; padding: 96px 0 clamp(56px, 7vw, 96px); }
  .hero__in { display: grid; gap: clamp(28px, 4vw, 56px); }
  .hero__meta { color: var(--ink); }
  .hero__title {
    font-size: clamp(3.1rem, 9.6vw, 10.4rem);
    line-height: 0.88;
    letter-spacing: -0.065em;
    display: grid;
    filter: blur(var(--hb, 0px));
    transform: translateY(var(--hy, 0px));
    will-change: filter, transform;
  }
  .hl { display: block; opacity: 0; filter: blur(18px); transform: translateX(-0.12em); transition: opacity 1.2s var(--ease-out), filter 1.4s var(--ease-out), transform 1.4s var(--ease-out); }
  .hl:nth-child(2) { padding-left: 1.1em; transition-delay: 0.12s; }
  .hl:nth-child(3) { transition-delay: 0.24s; text-align: right; }
  .hero__title.is-in .hl { opacity: 1; filter: none; transform: none; }
  /* Le mot-clé a un écho flou, comme une photo en mouvement */
  .hero__title em { position: relative; display: inline-block; }
  .hero__title em::after {
    content: attr(data-text);
    position: absolute;
    left: 0.06em;
    top: 0;
    color: var(--rasp);
    filter: blur(10px);
    opacity: 0.45;
    transform: translateX(0.12em);
    pointer-events: none;
  }

  .hero__row { display: grid; grid-template-columns: 1fr minmax(260px, 0.8fr) auto; gap: clamp(1.5rem, 4vw, 4rem); align-items: end; }
  .hero__copy { display: grid; gap: 1.6rem; align-content: end; padding-bottom: 0.5rem; }
  .hero .lead { color: #4a4345; }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: 0.7rem; }
  .hero__visual { position: relative; aspect-ratio: 4 / 5; isolation: isolate; }
  .hero__title { position: relative; z-index: 2; }
  .hero__blob { inset: -4% -14% -4% -14%; --ob: 34px; z-index: -1; }
  /* Logo tamponné en blanc cassé directement dans le dégradé, sans cadre */
  .hero__stamp { position: absolute; inset: 0; display: grid; place-items: center; padding: 0 2%; --fy: -8px; }
  .hero__stamp :global(.hero__logo) { width: 100%; filter: drop-shadow(0 1px 0 rgb(255 255 255 / 0.35)); }
  /* Annotation manuscrite, sans cachet */
  .hero__hand { position: absolute; right: -6%; top: 22%; margin: 0; font: 400 clamp(1.7rem, 2.6vw, 2.5rem)/1 'Nothing You Could Do', 'Segoe Script', cursive; color: var(--rasp); transform: rotate(-8deg); }
  .hero__side { list-style: none; margin: 0; padding: 0 0 0.5rem; display: grid; gap: 0.2rem; text-align: right; font-size: 0.74rem; font-weight: 600; font-stretch: 125%; text-transform: uppercase; letter-spacing: 0.04em; }
  .hero__side li:nth-child(odd) { color: var(--rasp); }

  /* SERVICES */
  .svc { position: relative; padding: 0 0 var(--section-y); }
  .svc__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.2rem; }
  @media (max-width: 1000px) { .svc__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .svc__grid { grid-template-columns: 1fr; } }
  .svc__list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--hair); }
  .svc__item { border-bottom: 1px solid var(--hair); }
  .row summary { list-style: none; display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr) 44px; gap: 1.5rem; align-items: center; padding: clamp(1.4rem, 2.6vw, 2.4rem) 0; cursor: pointer; }
  .row summary::-webkit-details-marker { display: none; }
  .row__t { font-size: clamp(1.8rem, 4.2vw, 4rem); font-weight: 560; letter-spacing: -0.055em; line-height: 0.95; transition: color 0.4s var(--ease), letter-spacing 0.6s var(--ease-out), font-stretch 0.6s var(--ease-out); }
  .row summary:hover .row__t, .row[open] .row__t { color: var(--blush); font-stretch: 112%; }
  .row__s { color: rgb(246 236 236 / 0.7); max-width: 26rem; }
  .row__plus { position: relative; width: 44px; height: 44px; border-radius: 50%; background: rgb(255 255 255 / 0.08); transition: background 0.4s var(--ease), transform 0.5s var(--ease-out); }
  .row__plus::before, .row__plus::after { content: ''; position: absolute; left: 50%; top: 50%; width: 14px; height: 1.5px; background: currentColor; transform: translate(-50%, -50%); }
  .row__plus::after { transform: translate(-50%, -50%) rotate(90deg); }
  .row summary:hover .row__plus { background: var(--rasp); }
  .row[open] .row__plus { transform: rotate(45deg); background: var(--rasp); }
  .row__body { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr) 44px; gap: 1.5rem; padding-bottom: 2.4rem; animation: unblur 0.8s var(--ease-out); }
  @keyframes unblur { from { opacity: 0; filter: blur(10px); transform: translateY(-8px); } }
  .row__items { list-style: none; margin: 0; padding: 0; columns: 2; column-gap: 2rem; font-size: 0.95rem; color: rgb(246 236 236 / 0.82); }
  .row__items li { break-inside: avoid; padding: 0.35rem 0; }
  .row__side { display: grid; gap: 1.2rem; justify-items: start; align-content: start; }
  .row__tags { font-size: 0.72rem; font-weight: 600; font-stretch: 125%; text-transform: uppercase; color: var(--blush); }
  .svc__end { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1.2rem; margin-top: clamp(40px, 5vw, 72px); font-size: clamp(1.2rem, 2vw, 1.6rem); font-weight: 500; letter-spacing: -0.03em; }

  .peek { position: fixed; left: 0; top: 0; z-index: 40; width: 260px; aspect-ratio: 4 / 5; margin: -170px 0 0 -130px; pointer-events: none; border-radius: 50% / 40%; overflow: hidden; opacity: 0; filter: blur(16px); scale: 0.7; transition: opacity 0.4s var(--ease), filter 0.6s var(--ease-out), scale 0.6s var(--ease-out); box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.6); }
  .peek.is-on { opacity: 1; filter: none; scale: 1; }
  .peek img { width: 100%; height: 100%; }

  /* MINDSET */
  .mindset { overflow: hidden; }
  .pils { display: flex; gap: 0.8rem; height: clamp(460px, 62vh, 600px); }
  .pil { position: relative; flex: 1; min-width: 0; border-radius: var(--r-l); background: rgb(255 255 255 / 0.32); overflow: hidden; transition: flex 0.9s var(--ease-out), background 0.6s var(--ease), color 0.6s var(--ease); }
  .pil.is-on { flex: 3.4; background: var(--choco); color: #f6ecec; }
  .pil__head { all: unset; box-sizing: border-box; position: absolute; inset: 0 auto auto 0; width: 100%; height: 100%; padding: 1.6rem; cursor: pointer; display: flex; flex-direction: column; justify-content: space-between; }
  .pil.is-on .pil__head { height: auto; pointer-events: none; }
  .pil__head:focus-visible { box-shadow: inset 0 0 0 3px var(--rasp); border-radius: var(--r-l); }
  .pil__letter { font-size: clamp(5rem, 9vw, 9rem); font-weight: 300; font-stretch: 125%; line-height: 0.8; letter-spacing: -0.06em; transition: color 0.6s var(--ease); }
  .pil.is-on .pil__letter { color: var(--blush); }
  .pil__name { font-size: 0.74rem; font-weight: 600; font-stretch: 125%; text-transform: uppercase; letter-spacing: 0.04em; writing-mode: vertical-rl; transform: rotate(180deg); }
  .pil.is-on .pil__name { writing-mode: horizontal-tb; transform: none; margin-top: 1rem; }
  .pil__body { position: absolute; left: 1.6rem; right: 1.6rem; bottom: 1.6rem; display: grid; gap: 1rem; justify-items: start; max-width: 34rem; opacity: 0; visibility: hidden; filter: blur(10px); transition: opacity 0.4s var(--ease), filter 0.5s var(--ease), visibility 0s 0.4s; }
  .pil.is-on .pil__body { opacity: 1; visibility: visible; filter: none; transition: opacity 0.7s 0.35s var(--ease-out), filter 0.8s 0.35s var(--ease-out), visibility 0s; }
  .pil__body h3 { font-size: clamp(1.5rem, 2.4vw, 2.2rem); }
  .pil__body > p { color: rgb(246 236 236 / 0.78); }
  .pil .btn--primary { background: var(--white); color: var(--choco); }
  .pil__in { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem 1rem; font-size: 0.88rem; }
  .pil__in span { font-size: 0.68rem; font-weight: 600; font-stretch: 125%; text-transform: uppercase; opacity: 0.6; }
  .pil__in a { text-decoration: none; border-bottom: 1px solid rgb(246 236 236 / 0.35); }
  .pil__in a:hover { color: var(--blush); }

  /* ABOUT */
  .about__grid { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: clamp(2.5rem, 7vw, 7rem); align-items: center; }
  /* Photo nette qui part du bord gauche de l'écran et flotte, avec son ombre posée dessous */
  .about__visual { position: relative; margin-left: calc(-1 * (max(0px, (100vw - var(--container)) / 2) + var(--gutter))); padding-bottom: 46px; }
  .about__float { position: relative; animation: about-float 7s ease-in-out infinite; }
  .about__photo { position: relative; aspect-ratio: 4 / 4.6; border-radius: 0 var(--r-l) var(--r-l) 0; overflow: hidden; box-shadow: 0 30px 50px -30px rgb(34 6 12 / 0.35); }
  .about__photo img { width: 100%; height: 100%; object-position: 50% 25%; }
  .about__shadow { position: absolute; left: 6%; right: 6%; bottom: 0; height: 26px; border-radius: 50%; background: radial-gradient(closest-side, rgb(34 6 12 / 0.32), transparent); filter: blur(6px); animation: about-shadow 7s ease-in-out infinite; }
  @keyframes about-float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-14px); } }
  @keyframes about-shadow { 0%, 100% { transform: scaleX(1); opacity: 1; } 50% { transform: scaleX(0.86); opacity: 0.65; } }
  .about__hand { position: absolute; right: 8%; bottom: 6%; margin: 0; font: 400 clamp(3.2rem, 5.4vw, 4.8rem)/1 'Nothing You Could Do', 'Segoe Script', cursive; color: #fff; transform: rotate(-8deg); text-shadow: 0 2px 12px rgb(0 0 0 / 0.35); }
  .about__text { display: grid; gap: 1.6rem; justify-items: start; }
  .about__text h2 { font-size: var(--h2); }
  .crew { display: grid; gap: 0.8rem; padding-top: 1.4rem; border-top: 1px solid var(--hair); }
  .crew h3 { font-size: 1.4rem; }
  .crew p { color: var(--ink-soft); max-width: 34rem; }
  .crew__list { list-style: none; margin: 0.4rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .crew__list li { font-size: 0.86rem; }

  .tools { margin-top: clamp(64px, 8vw, 120px); display: grid; gap: 1rem; }
  .tools__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(112px, 1fr)); border-top: 1px solid var(--hair); border-left: 1px solid var(--hair); }
  .tool { display: grid; justify-items: start; gap: 1.6rem; padding: 1rem; border-right: 1px solid var(--hair); border-bottom: 1px solid var(--hair); transition: background 0.4s var(--ease), color 0.4s var(--ease); }
