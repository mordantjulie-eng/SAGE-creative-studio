---
import Base from '../layouts/Base.astro';
import { brand, pillars, method } from '../config/site';

const shapes: Record<string, string> = {
  leaf: 'M0 100 V40 A60 60 0 0 1 60 -20 H100 V40 A60 60 0 0 1 40 100 Z',
  half: 'M0 50 A50 50 0 0 0 100 50 Z',
  arch: 'M0 100 V50 A50 50 0 0 1 100 50 V100 Z',
  dot: 'M50 15 A35 35 0 1 1 49.9 15 Z',
};
const arrow = '<svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 10 10 2M4 2h6v6" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>';
---

<Base>
  <!-- HERO -->
  <section class="hero on-dark">
    <div class="container hero__inner">
      <p class="label hero__kicker">Studio créatif & digital · {brand.location}</p>
      <h1 class="hero__title">
        Creative thinking.<br />
        Digital <span class="scribble">impact<svg viewBox="0 0 300 30" preserveAspectRatio="none" aria-hidden="true"><path d="M4 20 C 80 8, 160 6, 296 12 M 30 26 C 110 17, 190 16, 270 20" /></svg></span>.
      </h1>
      <div class="hero__bottom">
        <p class="hero__lead">
          Un studio qui fait rencontrer stratégie, identité et croissance. Pour les marques qui veulent
          être choisies, pas seulement vues.
        </p>
        <div class="hero__ctas">
          <a href="#contact" class="btn btn--primary">Parlons de votre projet <Fragment set:html={arrow} /></a>
          <a href="#studio" class="btn btn--ghost">Découvrir le studio</a>
        </div>
      </div>
    </div>
  </section>

  <!-- STUDIO -->
  <section id="studio" class="section">
    <div class="container intro">
      <p class="label intro__label reveal">01 — Le studio</p>
      <h2 class="intro__title reveal">Du beau, oui.<br /><em>Du sens, surtout.</em></h2>
      <div class="intro__body reveal">
        <p>
          {brand.name} n'est pas une agence de community management de plus. C'est un studio qui part de
          votre business avant de parler de posts : où vous voulez aller, ce qui vous rend différent,
          et comment le montrer.
        </p>
        <p>
          Stratégie, direction artistique, visibilité et outils digitaux sont pensés ensemble, par la
          même tête. Moins d'intermédiaires, plus de cohérence.
        </p>
      </div>
    </div>
  </section>

  <!-- EXPERTISES -->
  <section id="expertises" class="section section--ivory">
    <div class="container">
      <div class="section-head reveal">
        <p class="label">02 — Expertises</p>
        <h2>Quatre lettres,<br />une seule approche.</h2>
      </div>
      <ul class="pillars">
        {
          pillars.map((p) => (
            <li class="pillar reveal">
              <div class="pillar__visual" aria-hidden="true">
                <svg class="pillar__shape" viewBox="0 0 100 100" style={`color:${p.color}`}>
                  <path d={shapes[p.shape]} fill="currentColor" />
                </svg>
                <span class="pillar__letter">{p.letter}</span>
              </div>
              <h3 class="pillar__name">{p.name}</h3>
              <p class="pillar__fr label">{p.fr}</p>
              <p class="pillar__verbs">{p.verbs}</p>
              <p class="pillar__text">{p.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- MANIFESTE -->
  <section class="manifesto" aria-label="Manifeste">
    <div class="container">
      <p class="manifesto__text reveal">
        {brand.manifesto.map((w, i) => <span class:list={[{ 'is-accent': i === 2 }]}>{w} </span>)}
      </p>
    </div>
  </section>

  <!-- PROJETS -->
  <section id="projets" class="section">
    <div class="container">
      <div class="section-head reveal">
        <p class="label">03 — Projets</p>
        <h2>Les preuves<br />arrivent.</h2>
      </div>
      <!-- Pas de faux projets : ces cartes seront remplacées par de vraies études de cas autorisées. -->
      <div class="projects">
        {
          ['Identité de marque', 'Stratégie social media', 'Automatisation & IA'].map((cat, i) => (
            <article class="project reveal">
              <div class="project__img" data-i={i}>
                <span class="label">Étude de cas en préparation</span>
              </div>
              <p class="label project__cat">{cat}</p>
              <h3 class="project__title">Contexte → démarche → résultat</h3>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- METHODE -->
  <section id="methode" class="section section--ivory">
    <div class="container">
      <div class="section-head reveal">
        <p class="label">04 — Méthode</p>
        <h2>Pas de production<br />sans direction.</h2>
      </div>
      <ol class="steps">
        {
          method.map((m) => (
            <li class="step reveal">
              <span class="step__num">{m.step}</span>
              <h3 class="step__title">{m.title}</h3>
              <p>{m.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- CONTACT -->
  <section id="contact" class="cta on-dark">
    <div class="container cta__inner">
      <p class="label reveal">05 — Contact</p>
      <h2 class="cta__title reveal">Créons quelque chose<br />qui <span class="dot-accent">compte</span>.</h2>
      <p class="cta__lead reveal">
        Un projet, une marque à clarifier, une idée encore floue : racontez-moi en quelques lignes, je
        reviens vers vous sous 48 h ouvrées.
      </p>
      <div class="hero__ctas reveal">
        <a href={`mailto:${brand.email}`} class="btn btn--primary">Écrire au studio <Fragment set:html={arrow} /></a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* HERO */
  .hero {
    background: var(--sage-forest);
    color: var(--sage-ivory);
    overflow: hidden;
  }
  .hero__inner {
    min-height: calc(100svh - 72px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 3rem;
    padding-block: clamp(48px, 8vw, 96px);
  }
  .hero__kicker {
    opacity: 0.75;
  }
  .hero__title {
    font-size: var(--h1);
    font-style: italic;
    transform: skewX(-4deg);
    transform-origin: left;
    letter-spacing: -0.05em;
    line-height: 0.92;
  }
  .scribble {
    position: relative;
    white-space: nowrap;
  }
  .scribble svg {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.12em;
    width: 100%;
    height: 0.22em;
    fill: none;
    stroke: var(--sage-ochre);
    stroke-width: 3.5;
    stroke-linecap: round;
    stroke-dasharray: 700;
    stroke-dashoffset: 700;
    animation: draw 0.9s 0.4s var(--ease) forwards;
  }
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .scribble svg {
      stroke-dashoffset: 0;
    }
  }
  .hero__bottom {
    display: grid;
    grid-template-columns: minmax(0, 34rem) auto;
    justify-content: space-between;
    align-items: end;
    gap: 2rem;
  }
  .hero__lead {
    font-size: clamp(1.05rem, 1.5vw, 1.3rem);
    opacity: 0.9;
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* SECTIONS */
  .section--ivory {
    background: var(--sage-ivory);
  }
  .section-head {
    display: grid;
    gap: 1.25rem;
    margin-bottom: clamp(40px, 6vw, 80px);
  }
  .section-head h2,
  .intro__title,
  .cta__title {
    font-size: var(--h2);
  }
  .label {
    color: inherit;
  }

  /* INTRO */
  .intro {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 2rem 1.5rem;
  }
  .intro__label {
    grid-column: 1 / -1;
  }
  .intro__title {
    grid-column: 1 / 8;
  }
  .intro__title em {
    font-style: italic;
    color: var(--sage-forest);
  }
  .intro__body {
    grid-column: 8 / -1;
    display: grid;
    gap: 1rem;
    align-self: end;
  }

  /* PILIERS */
  .pillars {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1.5px solid var(--sage-forest);
  }
  .pillar {
    padding: 2rem 1.5rem 2.5rem 0;
    display: grid;
    align-content: start;
    gap: 0.6rem;
  }
  .pillar + .pillar {
    padding-left: 1.5rem;
    border-left: 1px solid rgb(31 58 46 / 0.2);
  }
  .pillar__visual {
    position: relative;
    height: 150px;
    margin-bottom: 1rem;
  }
  .pillar__shape {
    position: absolute;
    left: 40px;
    bottom: 0;
    width: 100px;
    height: 100px;
    transition: transform 0.35s var(--ease);
  }
  .pillar:hover .pillar__shape {
    transform: translate(6px, -6px) rotate(-6deg);
  }
  .pillar__letter {
    position: relative;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 9rem;
    line-height: 1;
    letter-spacing: -0.06em;
    color: var(--sage-forest);
    display: inline-block;
    transform: skewX(-9deg);
  }
  .pillar__name {
    font-size: var(--h3);
    color: var(--sage-forest);
  }
  .pillar__fr {
    opacity: 0.7;
  }
  .pillar__verbs {
    font-weight: 600;
    margin-top: 0.5rem;
  }
  .pillar__text {
    font-size: 0.95rem;
    opacity: 0.85;
  }

  /* MANIFESTE */
  .manifesto {
    background: var(--sage-paper);
    padding-block: clamp(64px, 10vw, 140px);
    border-bottom: 1.5px solid var(--sage-forest);
  }
  .manifesto__text {
    font-family: var(--font-display);
    font-weight: 700;
    font-style: italic;
    font-size: clamp(2.6rem, 9vw, 8.5rem);
    line-height: 0.95;
    letter-spacing: -0.05em;
    color: var(--sage-forest);
  }
  .manifesto__text span {
    display: inline-block;
    margin-right: 0.15em;
  }
  .manifesto__text .is-accent {
    color: var(--sage-rust);
  }

  /* PROJETS */
  .projects {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr;
    gap: 1.5rem;
  }
  .project__img {
    aspect-ratio: 4 / 5;
    border-radius: var(--radius);
    display: grid;
    place-items: end start;
    padding: 1.25rem;
    margin-bottom: 1rem;
    color: var(--sage-ivory);
  }
  .project__img[data-i='0'] {
    background: var(--sage-forest);
  }
  .project__img[data-i='1'] {
    background: var(--sage-taupe);
    color: var(--sage-ink);
  }
  .project__img[data-i='2'] {
    background: var(--sage-soft);
    color: var(--sage-ink);
  }
  .project__cat {
    opacity: 0.7;
    margin-bottom: 0.35rem;
  }
  .project__title {
    font-size: 1.35rem;
    letter-spacing: -0.02em;
  }

  /* METHODE */
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }
  .step {
    display: grid;
    gap: 0.75rem;
    align-content: start;
    padding-top: 1.25rem;
    border-top: 1.5px solid var(--sage-forest);
  }
  .step__num {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--sage-rust);
  }
  .step__title {
    font-size: var(--h3);
    color: var(--sage-forest);
  }
  .step p {
    font-size: 0.95rem;
  }

  /* CTA */
  .cta {
    background: var(--sage-forest);
    color: var(--sage-ivory);
    padding-block: clamp(80px, 12vw, 176px);
  }
  .cta__inner {
    display: grid;
    gap: 1.75rem;
  }
  .cta__title {
    font-style: italic;
    letter-spacing: -0.05em;
  }
  .dot-accent {
    color: var(--sage-ochre);
  }
  .cta__lead {
    max-width: 36rem;
    opacity: 0.9;
  }

  /* RESPONSIVE */
  @media (max-width: 1000px) {
    .pillars {
      grid-template-columns: repeat(2, 1fr);
    }
    .pillar:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }
    .pillar:nth-child(n + 3) {
      border-top: 1px solid rgb(31 58 46 / 0.2);
    }
    .steps {
      grid-template-columns: repeat(2, 1fr);
      row-gap: 2.5rem;
    }
  }
  @media (max-width: 820px) {
    .hero__bottom {
      grid-template-columns: 1fr;
    }
    .intro__title,
    .intro__body {
      grid-column: 1 / -1;
    }
    .projects {
      grid-template-columns: 1fr;
    }
    .project__img {
      aspect-ratio: 16 / 10;
    }
  }
  @media (max-width: 560px) {
    .pillars,
    .steps {
      grid-template-columns: 1fr;
    }
    .pillar,
    .pillar + .pillar {
      padding-left: 0;
      border-left: 0;
    }
    .pillar + .pillar {
      border-top: 1px solid rgb(31 58 46 / 0.2);
    }
    .pillar__letter {
      font-size: 7rem;
    }
    .pillar__visual {
      height: 120px;
    }
    .hero__ctas .btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
