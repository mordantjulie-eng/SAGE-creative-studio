---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import { brand, pillars, method } from '../config/site';

// Photos Unsplash (licence Unsplash) = illustrations provisoires, à remplacer par de vraies photos du studio.
const m = (n: string) => `media/${n}.jpg`;

const shapes: Record<string, string> = {
  leaf: 'M0 100 V45 A55 55 0 0 1 55 -10 H100 V45 A55 55 0 0 1 45 100 Z',
  half: 'M0 30 H100 A50 50 0 0 1 0 30 Z',
  arch: 'M0 100 V50 A50 50 0 0 1 100 50 V100 Z',
  dot: 'M50 18 A32 32 0 1 1 49.9 18 Z',
};
const pillarPhotos = ['moodboard', 'swatches', 'social-apps', 'design-system'];
const feeds = [
  ['creator-red', 'flatlay', 'creator-tee', 'swatches', 'creator-red'],
  ['creator-hoodie', 'design-screen', 'creator-blue', 'moodboard', 'creator-hoodie'],
  ['portrait-orange', 'social-apps', 'team-laugh', 'design-system', 'portrait-orange'],
];
const projects = [
  { img: 'team-laugh', cat: 'Strategy · Growth', title: 'Repositionner une marque locale', tag: 'Exemple' },
  { img: 'swatches', cat: 'Art Direction', title: 'Identité visuelle complète', tag: 'Exemple' },
  { img: 'creator-tee', cat: 'Growth · UGC', title: 'Campagne créateurs & UGC', tag: 'Exemple' },
  { img: 'design-screen', cat: 'Evolution', title: 'Site & automatisations sur mesure', tag: 'Exemple' },
  { img: 'duo-work', cat: 'Strategy', title: 'Audit & plan de communication', tag: 'Exemple' },
];
const arrow = '<svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 10 10 2M4 2h6v6" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>';
const ticker = [...brand.manifesto, ...brand.manifesto, ...brand.manifesto];
const tags = ['Stratégie', 'Branding', 'Social media', 'Contenu', 'UGC', 'Influence', 'IA', 'Automatisation', 'Direction artistique', 'Vibe coding'];
---

<Base>
  <!-- ============ HERO ============ -->
  <section class="hero on-dark" data-parallax-root>
    <div class="hero__stage">
      <!-- bulles flottantes -->
      <div class="fl fl--portrait float" style="--d:7s;--r:-4deg" data-depth="18">
        <img class="photo" src={m('portrait-orange')} alt="" />
      </div>
      <div class="fl fl--flatlay float" style="--d:8s;--r:5deg;--delay:-2s" data-depth="10">
        <img class="photo" src={m('flatlay')} alt="" />
      </div>
      <div class="fl fl--swatch float" style="--d:6s;--r:-8deg;--delay:-1s" data-depth="26">
        <img class="photo" src={m('swatches')} alt="" />
      </div>

      <span class="fl chip fl--c1 float" style="--d:5s;--r:-6deg" data-depth="30">✦ Stratégie</span>
      <span class="fl chip chip--ochre fl--c2 float" style="--d:6.5s;--r:5deg;--delay:-3s" data-depth="22">Branding</span>
      <span class="fl chip chip--rust fl--c3 float" style="--d:5.5s;--r:-3deg;--delay:-1.5s" data-depth="34">Social media</span>
      <span class="fl chip chip--soft fl--c4 float" style="--d:7s;--r:4deg;--delay:-4s" data-depth="16">IA & automatisation</span>

      <div class="fl notif fl--notif float" style="--d:6s;--delay:-2.5s" data-depth="20">
        <span class="notif__dot"></span>
        <div><strong>Nouveau brief</strong><br /><span>« On veut une marque qui se remarque. »</span></div>
      </div>

      <div class="fl phone fl--phone float" style="--d:7.5s;--r:6deg;--delay:-1s" data-depth="12" aria-hidden="true">
        <div class="phone__screen">
          <div class="feed">
            {feeds[0].map((f) => <img class="photo" src={m(f)} alt="" />)}
          </div>
          <div class="phone__ui"><span class="heart">♥</span><span class="heart">♥</span><span class="heart">♥</span></div>
        </div>
      </div>

      <a href="#studio" class="badge fl fl--badge" data-depth="8" aria-label="Découvrir le studio">
        <svg viewBox="0 0 120 120" class="badge__ring" aria-hidden="true">
          <defs><path id="circ" d="M60 60 m-46 0 a46 46 0 1 1 92 0 a46 46 0 1 1 -92 0"></path></defs>
          <text><textPath href="#circ">CREATIVE THINKING • DIGITAL IMPACT • </textPath></text>
        </svg>
        <span class="badge__arrow">↓</span>
      </a>

      <!-- centre -->
      <div class="hero__center">
        <p class="label hero__kicker">Studio créatif & digital · {brand.location}</p>
        <h1 class="sr-only">{brand.name} {brand.descriptor} — {brand.signature}</h1>
        <Logo size="xl" withDescriptor orbit />
        <p class="hero__lead">
          On fait rencontrer <strong>stratégie</strong>, <strong>identité</strong> et <strong>croissance</strong>.
          Pour les marques qui veulent être choisies, pas seulement vues.
        </p>
        <div class="hero__ctas">
          <a href="#contact" class="btn btn--primary">Parlons de votre projet <span class="arrow"><Fragment set:html={arrow} /></span></a>
          <a href="#expertises" class="btn btn--ghost">Nos expertises</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ TICKERS ============ -->
  <div class="tickers" aria-hidden="true">
    <div class="ticker ticker--ochre">
      <div class="ticker__track">
        {[0, 1].map(() => <div class="ticker__group">{ticker.map((w) => <span>{w} <i>✺</i></span>)}</div>)}
      </div>
    </div>
    <div class="ticker ticker--forest">
      <div class="ticker__track ticker__track--rev">
        {[0, 1].map(() => <div class="ticker__group">{tags.map((w) => <span class="ticker__tag">{w}</span>)}</div>)}
      </div>
    </div>
  </div>

  <!-- ============ STUDIO ============ -->
  <section id="studio" class="section">
    <div class="container studio">
      <div class="studio__text">
        <p class="label reveal">01 — Le studio</p>
        <h2 class="reveal">Du beau, oui.<br /><span class="u-rust">Du sens,</span> surtout.</h2>
        <p class="reveal" style="--rd:.1s">
          {brand.name} n'est pas une agence de community management de plus. On part de votre business avant
          de parler de posts : où vous voulez aller, ce qui vous rend différent, et comment le montrer.
        </p>
        <p class="reveal" style="--rd:.15s">
          Stratégie, direction artistique, visibilité et outils digitaux sont pensés ensemble. Moins
          d'intermédiaires, plus de cohérence.
        </p>
        <div class="studio__chips reveal" style="--rd:.2s">
          <span class="chip">Indépendant</span><span class="chip">Bilingue FR / EN</span><span class="chip">Belgique & Europe</span>
        </div>
      </div>
      <div class="studio__collage" data-scroll-parallax>
        <div class="col col--big reveal" data-speed="-0.06"><img class="photo" src={m('team-laugh')} alt="Illustration : une équipe en atelier créatif" /></div>
        <div class="col col--round reveal" style="--rd:.15s" data-speed="0.08"><img class="photo" src={m('design-screen')} alt="" /></div>
        <div class="col col--sticker float" style="--r:-10deg;--d:5s">Made<br />with<br />purpose.</div>
      </div>
    </div>
  </section>

  <!-- ============ EXPERTISES ============ -->
  <section id="expertises" class="section section--ivory rounded-top">
    <div class="container">
      <div class="head reveal">
        <p class="label">02 — Expertises</p>
        <h2>Quatre lettres.<br />Une seule approche.</h2>
      </div>
      <ul class="pillars">
        {
          pillars.map((p, i) => (
            <li class="pillar reveal" style={`--rd:${i * 0.08}s`} data-cursor="Découvrir">
              <img class="pillar__bg photo" src={m(pillarPhotos[i])} alt="" />
              <div class="pillar__visual" aria-hidden="true">
                <svg class="pillar__shape" viewBox="0 0 100 100" style={`color:${p.color}`}>
                  <path d={shapes[p.shape]} fill="currentColor" />
                </svg>
                <span class="pillar__letter">{p.letter}</span>
              </div>
              <h3 class="pillar__name">{p.name}</h3>
              <p class="pillar__verbs">{p.verbs}</p>
              <p class="pillar__text">{p.text}</p>
              <span class="pillar__more">{p.fr} →</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ============ CONTENU / REELS ============ -->
  <section class="reels on-dark">
    <div class="container reels__inner">
      <div class="reels__text">
        <p class="label reveal">Growth</p>
        <h2 class="reveal">Du contenu pensé pour être vu.<br /><span class="u-ochre">Et pour faire avancer.</span></h2>
        <p class="reveal" style="--rd:.1s">
          Reels, carrousels, créateurs, UGC : chaque contenu sert un objectif clair, sur la bonne
          plateforme, avec une direction artistique qui reste la vôtre.
        </p>
        <a href="#contact" class="btn btn--primary reveal" style="--rd:.15s">Booster ma visibilité <span class="arrow"><Fragment set:html={arrow} /></span></a>
      </div>
      <div class="reels__phones" aria-hidden="true">
        {
          feeds.map((feed, i) => (
            <div class={`phone phone--${i} float`} style={`--d:${6 + i}s;--delay:-${i * 1.5}s;--r:${[-6, 3, 8][i]}deg`}>
              <div class="phone__screen">
                <div class="feed" style={`--fd:${12 + i * 3}s`}>
                  {feed.map((f) => <img class="photo" src={m(f)} alt="" />)}
                </div>
                <div class="phone__ui"><span class="heart">♥</span><span class="heart">♥</span><span class="heart">♥</span></div>
              </div>
            </div>
          ))
        }
        <span class="chip chip--ochre reels__bubble float" style="--r:-6deg;--d:5s">Reels ▶</span>
        <span class="chip reels__bubble reels__bubble--2 float" style="--r:5deg;--d:6s;--delay:-2s">UGC ✦</span>
      </div>
    </div>
  </section>

  <!-- ============ PROJETS ============ -->
  <section id="projets" class="section">
    <div class="container head head--row reveal">
      <div>
        <p class="label">03 — Projets</p>
        <h2>Ce qu'on<br />fabrique.</h2>
      </div>
      <p class="head__note">Visuels d'illustration : les études de cas réelles arrivent avec les premiers clients.</p>
    </div>
    <div class="slider" data-slider>
      {
        projects.map((p, i) => (
          <article class="card reveal" style={`--rd:${i * 0.06}s`} data-cursor="Voir ↗">
            <div class="card__img">
              <img class="photo" src={m(p.img)} alt="" loading="lazy" />
              <span class="chip card__tag">{p.tag}</span>
            </div>
            <p class="label card__cat">{p.cat}</p>
            <h3 class="card__title">{p.title}</h3>
          </article>
        ))
      }
    </div>
  </section>

  <!-- ============ METHODE ============ -->
  <section id="methode" class="section section--ivory rounded-top">
    <div class="container">
      <div class="head reveal">
        <p class="label">04 — Méthode</p>
        <h2>Pas de production<br />sans direction.</h2>
      </div>
      <ol class="steps">
        {
          method.map((s, i) => (
            <li class="step reveal" style={`--rd:${i * 0.1}s`}>
              <span class="step__num">{s.step}</span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ============ CONTACT ============ -->
  <section id="contact" class="cta">
    <div class="container cta__inner">
      <span class="chip chip--rust cta__f1 float" style="--r:-8deg;--d:5s">Allons-y !</span>
      <span class="chip chip--soft cta__f2 float" style="--r:6deg;--d:6s;--delay:-2s">48 h pour vous répondre</span>
      <img class="photo cta__f3 float" style="--r:8deg;--d:7s" src={m('portrait-orange')} alt="" />
      <p class="label reveal">05 — Contact</p>
      <h2 class="cta__title reveal">Créons quelque chose<br />qui <span class="u-rust">compte.</span></h2>
      <p class="cta__lead reveal" style="--rd:.1s">
        Un projet, une marque à clarifier, une idée encore floue : racontez-moi en quelques lignes.
      </p>
      <div class="reveal" style="--rd:.15s">
        <a href={`mailto:${brand.email}`} class="btn btn--primary btn--xl">Écrire au studio <span class="arrow"><Fragment set:html={arrow} /></span></a>
      </div>
    </div>
  </section>

  <div class="cursor" aria-hidden="true"><span></span></div>
</Base>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fine = window.matchMedia('(pointer: fine)').matches;

  // Parallaxe à la souris dans le hero
  const root = document.querySelector<HTMLElement>('[data-parallax-root]');
  if (root && fine && !reduce) {
    const items = root.querySelectorAll<HTMLElement>('[data-depth]');
    root.addEventListener('pointermove', (e) => {
      const r = root.getBoundingClientRect();
      const x = (e.clientX - r.left) / r.width - 0.5;
      const y = (e.clientY - r.top) / r.height - 0.5;
      items.forEach((el) => {
        const d = Number(el.dataset.depth);
        el.style.translate = `${-x * d}px ${-y * d}px`;
      });
    });
  }

  // Parallaxe au défilement (collage)
  const speedEls = document.querySelectorAll<HTMLElement>('[data-speed]');
  if (!reduce && speedEls.length) {
    const onScroll = () => {
      speedEls.forEach((el) => {
        const r = el.getBoundingClientRect();
        const c = r.top + r.height / 2 - window.innerHeight / 2;
        el.style.translate = `0 ${c * Number(el.dataset.speed)}px`;
      });
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  // Curseur « bulle »
  const cursor = document.querySelector<HTMLElement>('.cursor');
  if (cursor && fine && !reduce) {
    const label = cursor.querySelector('span')!;
    let x = 0, y = 0, cx = 0, cy = 0;
    window.addEventListener('pointermove', (e) => { x = e.clientX; y = e.clientY; });
    const loop = () => {
      cx += (x - cx) * 0.18; cy += (y - cy) * 0.18;
      cursor.style.transform = `translate(${cx}px, ${cy}px)`;
      requestAnimationFrame(loop);
    };
    loop();
    document.querySelectorAll<HTMLElement>('[data-cursor]').forEach((el) => {
      el.addEventListener('pointerenter', () => { label.textContent = el.dataset.cursor!; cursor.classList.add('is-on'); });
      el.addEventListener('pointerleave', () => cursor.classList.remove('is-on'));
    });
  }

  // Slider : glisser à la souris
  const slider = document.querySelector<HTMLElement>('[data-slider]');
  if (slider) {
    let down = false, sx = 0, sl = 0;
    slider.addEventListener('pointerdown', (e) => { if (e.pointerType !== 'mouse') return; down = true; sx = e.clientX; sl = slider.scrollLeft; slider.classList.add('is-drag'); });
    window.addEventListener('pointerup', () => { down = false; slider.classList.remove('is-drag'); });
    slider.addEventListener('pointermove', (e) => { if (down) slider.scrollLeft = sl - (e.clientX - sx); });
  }
</script>

<style>
  /* ---------- utilitaires ---------- */
  .u-rust { color: var(--sage-rust); }
  .u-ochre { color: var(--sage-ochre); }
  .section--ivory { background: var(--sage-ivory); }
  .rounded-top { border-radius: var(--radius-l) var(--radius-l) 0 0; }
  .head { display: grid; gap: 1.1rem; margin-bottom: clamp(40px, 6vw, 80px); }
  .head h2, .studio h2, .reels h2, .cta__title { font-size: var(--h2); color: inherit; }
  .head--row { display: flex; justify-content: space-between; align-items: end; gap: 2rem; flex-wrap: wrap; }
  .head__note { max-width: 22rem; font-size: 0.9rem; opacity: 0.7; }
  .chip--ochre { background: var(--sage-ochre); color: var(--sage-ink); }
  .chip--rust { background: var(--sage-rust); color: var(--sage-ivory); }
  .chip--soft { background: var(--sage-soft); color: var(--sage-forest); }

  /* ---------- HERO ---------- */
  .hero {
    position: relative;
    background:
      radial-gradient(60% 50% at 50% 45%, rgb(196 154 84 / 0.12), transparent 70%),
      var(--sage-forest);
    color: var(--sage-ivory);
    border-radius: 0 0 var(--radius-l) var(--radius-l);
    overflow: hidden;
  }
  .hero__stage {
    position: relative;
    min-height: max(100svh, 760px);
    display: grid;
    place-items: center;
    padding: 120px var(--gutter) 80px;
  }
  .hero__center {
    position: relative;
    z-index: 2;
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 1.6rem;
  }
  .hero__kicker { opacity: 0.75; margin-bottom: 2.6rem; }
  .hero__lead { max-width: 34rem; font-size: clamp(1.05rem, 1.4vw, 1.25rem); opacity: 0.92; }
  .hero__lead strong { color: var(--sage-ochre); font-weight: 700; }
  .hero__ctas { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem; }

  .fl { position: absolute; z-index: 3; transition: translate 0.6s var(--ease); }
  .fl img { width: 100%; height: 100%; }
  .fl--portrait { left: 6%; top: 18%; width: 190px; height: 190px; border-radius: 50%; overflow: hidden; border: 6px solid var(--sage-ivory); box-shadow: var(--shadow); }
  .fl--flatlay { left: 9%; bottom: 10%; width: 250px; height: 170px; border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow); }
  .fl--swatch { right: 5%; bottom: 7%; width: 120px; height: 120px; border-radius: 30px; overflow: hidden; box-shadow: var(--shadow); }
  .fl--c1 { left: 22%; top: 16%; }
  .fl--c2 { right: 22%; top: 24%; }
  .fl--c3 { left: 20%; bottom: 28%; }
  .fl--c4 { right: 13%; bottom: 33%; }
  .fl--notif { left: 2.5%; top: 52%; }
  .fl--phone { right: 3.5%; top: 17%; }
  .fl--badge { right: 21%; bottom: 7%; }

  .notif {
    display: flex; gap: 0.7rem; align-items: center;
    max-width: 250px; padding: 0.8rem 1rem;
    border-radius: 20px;
    background: rgb(244 239 230 / 0.95); color: var(--sage-ink);
    font-size: 0.8rem; line-height: 1.35;
    box-shadow: var(--shadow);
  }
  .notif strong { font-size: 0.85rem; }
  .notif span { opacity: 0.75; }
  .notif__dot { flex: none; width: 34px; height: 34px; border-radius: 50%; background: var(--sage-rust); box-shadow: inset 0 0 0 9px var(--sage-ochre); }

  /* téléphone */
  .phone {
    width: 200px; aspect-ratio: 9 / 18.5;
    padding: 9px; border-radius: 34px;
    background: var(--sage-ink);
    box-shadow: var(--shadow), inset 0 0 0 1.5px rgb(255 255 255 / 0.12);
  }
  .phone__screen { position: relative; height: 100%; border-radius: 26px; overflow: hidden; background: var(--sage-forest-2); }
  .feed { display: grid; height: 500%; animation: feed var(--fd, 12s) cubic-bezier(.7,0,.3,1) infinite; }
  .feed img { width: 100%; height: 100%; }
  @keyframes feed {
    0%, 20% { transform: translateY(0); }
    25%, 45% { transform: translateY(-20%); }
    50%, 70% { transform: translateY(-40%); }
    75%, 95% { transform: translateY(-60%); }
    100% { transform: translateY(-80%); }
  }
  .phone__ui { position: absolute; right: 10px; bottom: 16px; display: grid; gap: 4px; }
  .heart { color: #fff; font-size: 14px; opacity: 0; animation: heart 3s ease-out infinite; text-shadow: 0 2px 6px rgb(0 0 0 / .4); }
  .heart:nth-child(2) { animation-delay: 1s; color: var(--sage-ochre); }
  .heart:nth-child(3) { animation-delay: 2s; color: #f4b6a0; }
  @keyframes heart {
    0% { transform: translateY(10px) scale(.6); opacity: 0; }
    20% { opacity: 1; }
    100% { transform: translateY(-90px) translateX(-10px) scale(1.2); opacity: 0; }
  }

  /* badge rotatif */
  .badge { display: grid; place-items: center; width: 118px; height: 118px; border-radius: 50%; background: var(--sage-ochre); color: var(--sage-ink); text-decoration: none; }
  .badge__ring { position: absolute; inset: 0; width: 100%; height: 100%; animation: spin 14s linear infinite; }
  .badge__ring text { font: 800 9.6px var(--font-ui); letter-spacing: 0.16em; fill: currentColor; }
  .badge__arrow { font-size: 1.6rem; font-weight: 800; transition: transform .35s var(--spring); }
  .badge:hover .badge__arrow { transform: translateY(4px) scale(1.2); }

  /* ---------- TICKERS ---------- */
  .tickers { position: relative; height: clamp(150px, 16vw, 210px); margin-top: -40px; z-index: 3; overflow: hidden; }
  .ticker { position: absolute; left: -5%; right: -5%; overflow: hidden; padding-block: 1rem; }
  .ticker--ochre { top: 30px; background: var(--sage-ochre); transform: rotate(-2.5deg); z-index: 2; box-shadow: var(--shadow); }
  .ticker--forest { top: 80px; background: var(--sage-rust); color: var(--sage-ivory); transform: rotate(2deg); }
  .ticker__track { display: flex; width: max-content; animation: marquee 30s linear infinite; }
  .ticker__track--rev { animation-direction: reverse; animation-duration: 40s; }
  .ticker__group { display: flex; align-items: center; gap: 1.5rem; padding-right: 1.5rem; }
  .ticker--ochre span { font: italic 900 clamp(1.8rem, 3.6vw, 3rem)/1 var(--font-display); font-stretch: 115%; letter-spacing: -0.04em; color: var(--sage-forest); white-space: nowrap; }
  .ticker--ochre i { font-style: normal; color: var(--sage-ivory); margin-left: 1rem; }
  .ticker__tag { padding: 0.35em 1em; border: 1.5px solid rgb(231 226 216 / .6); border-radius: var(--pill); font-weight: 700; white-space: nowrap; }
  @keyframes marquee { to { transform: translateX(-50%); } }

  /* ---------- STUDIO ---------- */
  .studio { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 6vw, 6rem); align-items: center; }
  .studio__text { display: grid; gap: 1.4rem; }
  .studio h2 { color: var(--sage-forest); }
  .studio__chips { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .studio__collage { position: relative; height: clamp(420px, 46vw, 600px); }
  .col { position: absolute; overflow: hidden; box-shadow: var(--shadow); }
  .col img { width: 100%; height: 100%; }
  .col--big { left: 0; top: 0; width: 78%; height: 80%; border-radius: var(--radius-l); }
  .col--round { right: 0; bottom: 0; width: 46%; aspect-ratio: 1; border-radius: 50%; border: 8px solid var(--sage-paper); }
  .col--sticker {
    left: 4%; bottom: 4%;
    display: grid; place-items: center;
    width: 130px; height: 130px; border-radius: 50%;
    background: var(--sage-rust); color: var(--sage-ivory);
