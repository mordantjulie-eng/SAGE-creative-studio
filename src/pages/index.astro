---
import Base from '../layouts/Base.astro';
import Ticket from '../components/Ticket.astro';
import ContactForm from '../components/ContactForm.astro';
import Zoom from '../components/Zoom.astro';
import Phones from '../components/Phones.astro';
import Book from '../components/Book.astro';
import Shape from '../components/Shape.astro';
import { brand, services, pillars, steps, partners } from '../config/site';

const m = (n: string) => `/media/${n}.jpg`;
const work = [
  { img: 'team-laugh', cat: 'Strategy & Consulting' },
  { img: 'swatches', cat: 'Branding & Art Direction' },
  { img: 'creator-tee', cat: 'Content Creation' },
];
---

<Base>
  <!-- HERO -->
  <section class="hero" data-parallax-root>
    <div class="orbs" aria-hidden="true">
      <span class="orb orb--sage" data-depth="30" style="width:720px;height:720px;left:-200px;top:-160px;--d:24s"></span>
      <span class="orb orb--champagne" data-depth="45" style="width:560px;height:560px;right:-120px;top:40px;--d:28s;--dx:-60px"></span>
      <span class="orb orb--blush" data-depth="20" style="width:520px;height:520px;left:30%;bottom:-260px;--d:32s;--dy:-50px"></span>
    </div>

    <div class="container hero__grid">
      <div class="hero__text">
        <p class="hero__flags reveal"><span class="flag">Lancement 2027</span><span class="eyebrow split"><span>Creative studio</span><span>{brand.location}</span></span></p>
        <h1 class="hero__title reveal" style="--rd:.08s">Le studio créatif qui fait <em>grandir</em> les marques.</h1>
        <p class="lead reveal" style="--rd:.16s">
          Stratégie, contenu, social media, branding, influence et formation à l'IA&nbsp;: tout ce qu'il faut pour
          que votre marque se voie, se comprenne et se choisisse.
        </p>
        <div class="hero__ctas reveal" style="--rd:.24s">
          <a href="#services" class="btn btn--primary">Découvrir les services <span aria-hidden="true">→</span></a>
          <a href="#contact" class="btn btn--glass">Parlons de votre projet</a>
        </div>
      </div>

      <div class="hero__visual" aria-hidden="true">
        <div class="hs hs--leaf float" data-depth="40" style="--d:10s"><Shape name="leaf" color="var(--sage-light)" /></div>
        <div class="hs hs--half float" data-depth="55" style="--d:8s;--delay:-3s"><Shape name="half" color="var(--ochre)" /></div>
        <div class="hs hs--circle float" data-depth="24" style="--d:9s;--delay:-5s"><Shape name="circle" color="var(--clay)" /></div>
        <div class="hv hv--main float" data-depth="14" style="--d:9s">
          <img class="photo" src={m('julie-filming')} alt="" />
        </div>
        <div class="hv-card glass float" data-depth="22" style="--d:8s;--delay:-3s">
          <p class="hv-card__q">Creative thinking.<br /><em>Digital impact.</em></p>
        </div>
        <div class="hv-pill glass float" data-depth="36" style="--d:6.5s;--delay:-1s">
          <span class="split"><span>Stratégie</span><span>Contenu</span><span>Influence</span><span>IA</span></span>
        </div>
      </div>
    </div>
  </section>

  <Zoom />

  <!-- SERVICES -->
  <section id="services" class="section services">
    <div class="orbs" aria-hidden="true">
      <span class="bgshape" style="width:340px;left:18%;top:34%;--d:14s"><Shape name="arch" color="var(--sage-light)" /></span>
      <span class="bgshape" style="width:300px;right:14%;top:58%;--d:12s;--delay:-4s"><Shape name="half" color="var(--ochre)" style="opacity:.55" /></span>
      <span class="bgshape" style="width:220px;left:52%;top:22%;--d:16s;--delay:-7s"><Shape name="leaf" color="var(--sage)" style="opacity:.5" /></span>
      <span class="orb orb--mist" style="width:700px;height:700px;left:-220px;top:10%;--d:26s"></span>
      <span class="orb orb--champagne" style="width:520px;height:520px;right:-160px;top:45%;opacity:.55;--d:30s"></span>
      <span class="orb orb--sage" style="width:600px;height:600px;left:35%;bottom:-200px;opacity:.5;--d:34s"></span>
    </div>
    <div class="container rel">
      <div class="head">
        <div>
          <p class="hero__flags reveal"><span class="flag flag--cobalt">6 expertises, 1 interlocutrice</span></p>
          <p class="eyebrow reveal">Services</p>
          <h2 class="reveal" style="--rd:.08s">Six expertises,<br /><em>une même exigence.</em></h2>
        </div>
        <p class="lead reveal" style="--rd:.16s">
          En mission ponctuelle ou en accompagnement mensuel. Chaque carte se retourne pour révéler ce qu'elle
          contient.
        </p>
      </div>
      <div class="cards">
        {services.map((s, i) => <Ticket service={s} delay={(i % 3) * 0.1} />)}
      </div>
      <p class="services__note reveal">
        Un besoin qui touche à plusieurs expertises&nbsp;? <a class="link" href="#contact">Composons un accompagnement sur mesure <span aria-hidden="true">→</span></a>
      </p>
    </div>
  </section>

  <Phones />
  <Book />

  <!-- MINDSET -->
  <section id="mindset" class="mindset on-dark">
    <div class="orbs" aria-hidden="true">
      <span class="orb orb--champagne" style="width:560px;height:560px;right:-140px;top:-180px;opacity:.35;--d:26s"></span>
      <span class="orb orb--mist" style="width:620px;height:620px;left:-220px;bottom:-240px;opacity:.25;--d:30s"></span>
    </div>
    <div class="container rel">
      <div class="head">
        <div>
          <p class="eyebrow reveal">The SAGE mindset</p>
          <h2 class="reveal" style="--rd:.08s">Quatre lettres,<br /><em>une façon de penser.</em></h2>
        </div>
        <p class="lead reveal" style="--rd:.16s">
          S.A.G.E. n'est pas une liste de services&nbsp;: c'est la méthode qui guide chacun d'eux.
        </p>
      </div>

      <div class="sage">
        <div class="sage__letters" role="tablist" aria-label="Les quatre piliers S.A.G.E.">
          {
            pillars.map((p, i) => (
              <button
                class="sage__tab reveal"
                style={`--rd:${i * 0.08}s`}
                role="tab"
                id={`tab-${p.letter}`}
                aria-controls={`panel-${p.letter}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? 0 : -1}
              >
                <span class="sage__glyph">
                  <Shape name={p.shape as any} color={p.color} class="sage__shape" />
                  <span class="sage__letter">{p.letter}</span>
                </span>
                <span class="sage__name">{p.name}</span>
              </button>
            ))
          }
        </div>
        {
          pillars.map((p, i) => (
            <div class="sage__panel glass" role="tabpanel" id={`panel-${p.letter}`} aria-labelledby={`tab-${p.letter}`} hidden={i !== 0}>
              <p class="sage__big" aria-hidden="true">
                <Shape name={p.shape as any} color={p.color} class="sage__bigshape" />
                <span>{p.letter}</span>
              </p>
              <div class="sage__content">
                <h3>{p.verbs}</h3>
                <p>{p.text}</p>
                <p class="sage__in">
                  <span>Au cœur de</span>
                  {services
                    .filter((s) => s.pillars.includes(p.letter))
                    .map((s) => (
                      <a href={`/services/${s.slug}`}>{s.title}</a>
                    ))}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- WORK -->
  <section id="projets" class="section work">
    <div class="container">
      <div class="head">
        <div>
          <p class="eyebrow reveal">Selected work</p>
          <h2 class="reveal" style="--rd:.08s">La vitrine<br /><em>se prépare.</em></h2>
        </div>
        <p class="lead reveal" style="--rd:.16s">
          Les premières études de cas du studio arriveront ici, avec le contexte, la démarche et les résultats,
          validés par les clients.
        </p>
      </div>
      <div class="works">
        {
          work.map((w, i) => (
            <article class="workcard reveal" style={`--rd:${i * 0.1}s`}>
              <div class="workcard__img arch">
                <img class="photo" src={m(w.img)} alt="" />
              </div>
              <div class="workcard__label glass">
                <span>{w.cat}</span>
                <em>En préparation</em>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ABOUT -->
  <section id="studio" class="section about">
    <div class="orbs" aria-hidden="true">
      <span class="orb orb--blush" style="width:620px;height:620px;left:-180px;top:0;--d:28s"></span>
      <span class="orb orb--mist" style="width:560px;height:560px;right:-120px;bottom:-120px;--d:24s"></span>
    </div>
    <div class="container about__grid rel">
      <div class="about__visual reveal">
        <div class="about__photo arch"><img src={m('julie-studio')} alt="Julie, fondatrice de SAGE Creative Studio" /></div>
        <div class="about__wink float" style="--d:7s"><img src={m('julie-wink')} alt="" /></div>
        <div class="about__tag glass float" style="--d:8s;--delay:-2s">
          <strong>Julie</strong>
          <span>Fondatrice</span>
        </div>
      </div>
      <div class="about__text">
        <p class="eyebrow reveal">About the studio</p>
        <h2 class="reveal" style="--rd:.08s">Derrière SAGE,<br /><em>il y a Julie.</em></h2>
        <p class="lead reveal" style="--rd:.16s">
          Marketing, réseaux sociaux, contenu, influence, business et IA&nbsp;: j'ai passé ces dernières années à
          voir de l'intérieur ce qui fait avancer une marque, et ce qui la freine. SAGE est né de l'envie de réunir
          tout ça au même endroit, avec plus de sens et moins de jargon.
        </p>
        <div class="crew reveal" style="--rd:.22s">
          <h3>Seule aux commandes, <em>jamais seule au travail.</em></h3>
          <p>
            Pour les tournages, les shootings et le design graphique, je m'entoure de partenaires de confiance. Vous
            gardez un seul interlocuteur&nbsp;: moi.
          </p>
          <ul class="crew__list">
            {partners.map((p) => <li>{p.label}</li>)}
          </ul>
        </div>
        <a href="/studio" class="btn btn--primary reveal" style="--rd:.28s">Découvrir le studio <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section id="contact" class="contact on-dark">
    <div class="orbs" aria-hidden="true">
      <span class="bgshape" style="width:300px;right:30%;top:16%;--d:14s"><Shape name="arch" color="var(--ochre)" style="opacity:.55" /></span>
      <span class="bgshape" style="width:240px;right:4%;bottom:10%;--d:12s;--delay:-5s"><Shape name="circle" color="var(--sage-light)" style="opacity:.45" /></span>
      <span class="orb orb--champagne" style="width:600px;height:600px;right:-160px;top:-120px;opacity:.4;--d:26s"></span>
      <span class="orb orb--mist" style="width:640px;height:640px;left:-200px;bottom:-260px;opacity:.3;--d:30s"></span>
    </div>
    <div class="container contact__grid rel">
      <div class="contact__intro">
        <p class="hero__flags reveal"><span class="flag flag--vermilion">Réponse sous 48 h ouvrées</span></p>
        <p class="eyebrow reveal">Let's work together</p>
        <h2 class="reveal" style="--rd:.08s">Créons quelque chose<br /><em>qui compte.</em></h2>
        <p class="lead reveal" style="--rd:.16s">
          Un projet, une marque à clarifier, une idée encore floue&nbsp;: racontez-moi en quelques lignes. Je vous
          réponds sous 48&nbsp;h ouvrées.
        </p>
        <ol class="steps">
          {
            steps.map((s, i) => (
              <li class="reveal" style={`--rd:${0.2 + i * 0.07}s`}>
                <span class="steps__n">{s.num}</span>
                <span>
                  <strong>{s.title}</strong>
                  <br />
                  {s.text}
                </span>
              </li>
            ))
          }
        </ol>
      </div>
      <div class="reveal" style="--rd:.2s"><ContactForm /></div>
    </div>
  </section>
</Base>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fine = window.matchMedia('(pointer: fine)').matches;

  // Parallaxe douce à la souris (hero)
  const root = document.querySelector<HTMLElement>('[data-parallax-root]');
  if (root && fine && !reduce) {
    const items = root.querySelectorAll<HTMLElement>('[data-depth]');
    let tx = 0, ty = 0, cx = 0, cy = 0;
    root.addEventListener('pointermove', (e) => {
      const r = root.getBoundingClientRect();
      tx = (e.clientX - r.left) / r.width - 0.5;
      ty = (e.clientY - r.top) / r.height - 0.5;
    });
    const loop = () => {
      cx += (tx - cx) * 0.06; cy += (ty - cy) * 0.06;
      items.forEach((el) => (el.style.translate = `${-cx * Number(el.dataset.depth)}px ${-cy * Number(el.dataset.depth)}px`));
      requestAnimationFrame(loop);
    };
    loop();
  }

  // Onglets S.A.G.E.
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('.sage__tab')];
  const select = (t: HTMLButtonElement) =>
    tabs.forEach((x) => {
      const on = x === t;
      x.setAttribute('aria-selected', String(on));
      x.tabIndex = on ? 0 : -1;
      document.getElementById(x.getAttribute('aria-controls')!)!.hidden = !on;
    });
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => select(t));
    t.addEventListener('keydown', (e) => {
      const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (!d) return;
      e.preventDefault();
      const n = tabs[(i + d + tabs.length) % tabs.length];
      select(n);
      n.focus();
    });
  });
</script>

<style>
  .rel { position: relative; z-index: 1; }
  .head { display: flex; justify-content: space-between; align-items: end; flex-wrap: wrap; gap: 1.5rem 4rem; margin-bottom: clamp(48px, 6vw, 88px); }
  .head > div { display: grid; gap: 1.2rem; }
  .head h2 { font-size: var(--h2); }
  .head .lead { max-width: 26rem; }

  /* HERO */
  .hero { position: relative; overflow: hidden; background: var(--grad-soft); }
  .hero__grid { position: relative; z-index: 1; display: grid; grid-template-columns: 1.05fr 0.95fr; gap: 3rem; align-items: center; min-height: max(100svh, 760px); padding-block: 140px 90px; }
  .hero__text { display: grid; gap: 1.7rem; justify-items: start; }
  .hero__title { font-size: var(--h1); font-weight: 300; }
  .hero__flags { display: flex; flex-wrap: wrap; align-items: center; gap: 0.8rem 1.2rem; }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 0.4rem; }

  .hero__visual { position: relative; height: min(640px, 70vh); min-height: 520px; }
  .bgshape { position: absolute; display: block; animation: float var(--d, 12s) ease-in-out infinite; animation-delay: var(--delay, 0s); --fy: -24px; }
  .bgshape :global(.shape) { width: 100%; height: auto; }
  .hs { position: absolute; z-index: 0; }
  .hs :global(.shape) { width: 100%; height: auto; }
  .hs--leaf { width: 46%; right: 34%; top: -4%; opacity: 0.9; }
  .hs--half { width: 30%; right: -2%; top: 46%; z-index: 2; }
  .hs--circle { width: 13%; left: 20%; bottom: 26%; z-index: 2; }
  .hv { position: absolute; overflow: hidden; box-shadow: var(--shadow); }
  .hv img { width: 100%; height: 100%; }
  .hv--main { right: 6%; top: 0; width: 62%; height: 88%; border-radius: 999px 999px var(--r-l) var(--r-l); }
  .hv--small { left: 4%; top: 10%; width: 150px; height: 150px; border-radius: 50%; border: 6px solid rgb(255 255 255 / 0.6); }
  .hv-card { position: absolute; left: 0; bottom: 6%; padding: 1.4rem 1.6rem; border-radius: var(--r); }
  .hv-card__q { font: 300 1.6rem/1.15 var(--font-serif); letter-spacing: -0.01em; }
  .hv-card__q em { color: var(--eucalyptus); }
  .hv-pill { position: absolute; right: 0; bottom: 18%; display: inline-flex; align-items: center; gap: 0.6rem; padding: 0.75rem 1.2rem; border-radius: var(--pill); font-size: 0.85rem; }

  /* SERVICES */
  .services { overflow: hidden; }
  .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.4rem; }
  .cards > :global(.card:nth-child(3n + 2)) { margin-top: 40px; }
  .services__note { margin-top: clamp(48px, 6vw, 80px); text-align: center; color: rgb(43 52 47 / 0.75); }

  /* MINDSET */
  .mindset { position: relative; overflow: hidden; background: var(--grad-dark); color: var(--cream); padding-block: var(--section-y); border-radius: var(--r-l); margin: var(--section-y) clamp(0px, 1.5vw, 20px) 0; }
  .sage__letters { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-bottom: 1.2rem; }
  .sage__tab { display: grid; justify-items: start; gap: 0.3rem; padding: 1.4rem 1.6rem 1.3rem; border-radius: var(--r); border: 0; box-shadow: inset 0 0.5px 0 rgb(255 255 255 / 0.2); background: rgb(255 255 255 / 0.05); color: var(--cream); cursor: pointer; text-align: left; backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); transition: background 0.5s var(--ease), border-color 0.5s var(--ease), transform 0.6s var(--ease-out); }
  .sage__tab:hover { transform: translateY(-4px); background: rgb(255 255 255 / 0.1); }
  .sage__tab[aria-selected='true'] { background: rgb(255 255 255 / 0.18); box-shadow: 0 20px 40px -24px rgb(0 0 0 / 0.5), inset 0 0.5px 0 rgb(255 255 255 / 0.4); }
  .sage__glyph { position: relative; display: inline-block; padding: 0.6rem 1.6rem 0 0; }
  .sage__glyph :global(.sage__shape) { position: absolute; right: 0; bottom: 0; width: clamp(56px, 6vw, 84px); height: auto; opacity: 0.85; transition: transform 0.8s var(--ease-out); }
  .sage__tab:hover .sage__glyph :global(.sage__shape), .sage__tab[aria-selected='true'] .sage__glyph :global(.sage__shape) { transform: rotate(-12deg) scale(1.12); }
  .sage__letter { position: relative; font: 300 clamp(4rem, 8vw, 7rem)/0.9 var(--font-serif); }
  .sage__tab[aria-selected='true'] .sage__letter { font-style: italic; color: var(--champagne); }
  .sage__name { font-size: 0.85rem; letter-spacing: 0.14em; text-transform: uppercase; opacity: 0.85; }
  .sage__panel { display: grid; grid-template-columns: auto 1fr; gap: clamp(1.5rem, 5vw, 5rem); align-items: center; padding: clamp(1.8rem, 4vw, 3.4rem); border-radius: var(--r-l); animation: fade 0.8s var(--ease-out); }
  .sage__panel[hidden] { display: none; }
  @keyframes fade { from { opacity: 0; transform: translateY(10px); } }
  .sage__big { position: relative; display: grid; place-items: center; font: italic 300 clamp(7rem, 15vw, 13rem)/0.8 var(--font-serif); color: var(--cream); }
  .sage__big span { position: relative; }
  .sage__big :global(.sage__bigshape) { position: absolute; width: 78%; height: auto; right: -12%; bottom: -8%; opacity: 0.9; animation: shapein 1s var(--ease-out); }
  @keyframes shapein { from { transform: rotate(-30deg) scale(0.6); opacity: 0; } }
  .sage__content { display: grid; gap: 1.1rem; }
  .sage__content h3 { font-size: clamp(1.8rem, 3.2vw, 2.8rem); font-weight: 300; }
  .sage__content > p:not(.sage__in) { max-width: 38rem; opacity: 0.85; }
  .sage__in { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1.2rem; margin-top: 0.4rem; font-size: 0.92rem; }
  .sage__in span { font: italic 300 1.1rem var(--font-serif); color: var(--champagne); }
  .sage__in a { text-decoration: none; padding: 0.5rem 1rem; border-radius: var(--pill); font-weight: 500; background: rgb(255 255 255 / 0.14); backdrop-filter: blur(20px) saturate(1.6); -webkit-backdrop-filter: blur(20px) saturate(1.6); border: 0; box-shadow: 0 10px 24px -16px rgb(0 0 0 / 0.55), inset 0 0.5px 0 rgb(255 255 255 / 0.35); transition: background 0.3s var(--ease); }
  .sage__in a:hover { background: rgb(255 255 255 / 0.24); }

  /* WORK */
  .works { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.6rem; }
  .workcard { position: relative; }
  .workcard:nth-child(2) { margin-top: 60px; }
  .workcard__img { aspect-ratio: 3 / 4; box-shadow: var(--shadow); }
  .workcard__img img { width: 100%; height: 100%; transition: transform 1.4s var(--ease-out); }
  .workcard:hover .workcard__img img { transform: scale(1.05); }
  .workcard__label { position: absolute; left: 16px; right: 16px; bottom: 16px; display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 0.9rem 1.2rem; border-radius: var(--r-s); font-size: 0.88rem; }
  .workcard__label em { font: italic 300 1rem var(--font-serif); color: var(--eucalyptus); }

  /* ABOUT */
  .about { overflow: hidden; }
  .about__grid { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: clamp(2.5rem, 7vw, 7rem); align-items: center; }
  .about__visual { position: relative; padding-bottom: 2rem; }
  .about__photo { aspect-ratio: 4 / 5; box-shadow: var(--shadow); }
  .about__photo img { width: 100%; height: 100%; }
  .about__wink { position: absolute; right: -6%; bottom: 0; width: 34%; aspect-ratio: 1; border-radius: 50%; overflow: hidden; border: 6px solid rgb(255 255 255 / 0.7); box-shadow: var(--shadow); }
  .about__wink img { width: 100%; height: 100%; object-position: 30% 30%; }
  .about__tag { position: absolute; left: -4%; top: 14%; display: grid; padding: 0.9rem 1.3rem; border-radius: var(--r-s); }
  .about__tag strong { font: 400 1.4rem var(--font-serif); }
  .about__tag span { font-size: 0.8rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--eucalyptus); }
  .about__text { display: grid; gap: 1.5rem; justify-items: start; }
  .about__text h2 { font-size: var(--h2); }
  .crew { display: grid; gap: 0.8rem; padding-top: 1.5rem; border-top: 1px solid var(--hair); }
  .crew h3 { font-size: 1.6rem; font-weight: 340; }
