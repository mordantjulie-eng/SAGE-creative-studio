---
import Base from '../layouts/Base.astro';
import { brand, partners, journey, steps } from '../config/site';

const traits = [
  { word: 'Créative', text: 'Des idées qui sortent du lot, toujours au service de votre objectif.' },
  { word: 'Organisée', text: 'Des plannings tenus, des process clairs, des livrables à l’heure.' },
  { word: 'Curieuse', text: 'Toujours en train de tester un format, un outil, une plateforme.' },
  { word: 'Entreprenante', text: 'Je comprends les enjeux business, pas seulement les likes.' },
];
const how = [
  { t: 'Je sélectionne', d: 'Des partenaires que je connais, dont je maîtrise le travail et les délais.' },
  { t: 'Je dirige', d: 'Je garde la stratégie et la direction artistique de bout en bout.' },
  { t: 'Je coordonne', d: 'Un seul interlocuteur, un seul planning, une seule facture.' },
];
const shots = [
  { img: 'julie-filming', alt: 'Julie en tournage en extérieur, micro à la main', cap: 'En tournage' },
  { img: 'julie-studio', alt: 'Julie en séance photo en studio', cap: 'Shooting studio' },
  { img: 'julie-filming-2', alt: 'Julie face caméra pour un contenu vidéo', cap: 'Face caméra' },
  { img: 'julie-mirror', alt: 'Julie en selfie miroir', cap: 'Off duty' },
];
---

<Base title="Le studio | SAGE Creative Studio" description="SAGE Creative Studio, c'est Julie : un studio créatif indépendant en Belgique, entouré de partenaires de confiance.">
  <section class="st-hero">
    <div class="orbs" aria-hidden="true">
      <span class="orb orb--sage" style="width:700px;height:700px;left:-220px;top:-180px;--d:26s"></span>
      <span class="orb orb--champagne" style="width:520px;height:520px;right:-120px;top:60px;--d:30s"></span>
      <span class="orb orb--blush" style="width:500px;height:500px;left:40%;bottom:-260px;--d:34s"></span>
    </div>
    <div class="container st-hero__grid rel">
      <div class="st-hero__text">
        <p class="eyebrow reveal">Le studio</p>
        <h1 class="reveal" style="--rd:.08s">Hello,<br />moi c'est <em>{brand.founder}.</em></h1>
        <p class="lead reveal" style="--rd:.16s">
          Fondatrice de {brand.name}. Belge, 25 ans, formée au marketing international et passionnée par tout ce qui
          fait qu'une marque se remarque&nbsp;: la stratégie, l'image, le contenu, et les nouveaux outils qui
          changent notre façon de travailler.
        </p>
      </div>
      <div class="st-hero__visual reveal" style="--rd:.1s">
        <div class="st-portrait arch"><img src="/media/julie-portrait.jpg" alt="Portrait de Julie, fondatrice de SAGE Creative Studio" /></div>
        <div class="st-wink float" style="--d:7s"><img src="/media/julie-wink.jpg" alt="" /></div>
        <div class="st-quote glass float" style="--d:8s;--delay:-2s"><em>Think. Create.</em><br />Grow. Evolve.</div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container st-why">
      <p class="eyebrow reveal">Pourquoi SAGE</p>
      <p class="st-big reveal" style="--rd:.08s">
        J'ai vu des marques avec de super produits rester invisibles, et des comptes très actifs qui ne vendaient
        rien. <em>SAGE existe pour relier les deux</em>&nbsp;: une vraie réflexion, une image forte, et une présence
        qui sert vos objectifs.
      </p>
    </div>
  </section>

  <section class="st-bts" aria-label="Dans les coulisses">
    <div class="container">
      <p class="eyebrow reveal">Dans les coulisses</p>
      <div class="st-bts__row">
        {
          shots.map((s, i) => (
            <figure class="st-shot reveal" style={`--rd:${i * 0.08}s`}>
              <div class="st-shot__img">
                <img src={`/media/${s.img}.jpg`} alt={s.alt} />
              </div>
              <figcaption class="glass">{s.cap}</figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section st-traits-wrap">
    <div class="orbs" aria-hidden="true">
      <span class="orb orb--mist" style="width:640px;height:640px;left:-200px;top:0;--d:26s"></span>
      <span class="orb orb--champagne" style="width:520px;height:520px;right:-160px;bottom:-160px;opacity:.5;--d:30s"></span>
    </div>
    <div class="container rel">
      <div class="st-head">
        <p class="eyebrow reveal">Ma façon de travailler</p>
        <h2 class="reveal" style="--rd:.08s">Quatre mots <em>qui me résument.</em></h2>
      </div>
      <ul class="st-traits">
        {
          traits.map((t, i) => (
            <li class="st-trait glass reveal" style={`--rd:${i * 0.08}s`}>
              <span class="st-trait__w">{t.word}</span>
              <p>{t.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="st-head">
        <p class="eyebrow reveal">Mon parcours</p>
        <h2 class="reveal" style="--rd:.08s">D'où <em>je viens.</em></h2>
      </div>
      <ol class="st-line">
        {
          journey.map((j, i) => (
            <li class="st-stop reveal" style={`--rd:${i * 0.1}s`}>
              <span class="st-stop__when">{j.when}</span>
              <div>
                <strong>{j.what}</strong>
                <span>{j.where}</span>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="st-crew on-dark">
    <div class="orbs" aria-hidden="true">
      <span class="orb orb--champagne" style="width:560px;height:560px;right:-140px;top:-160px;opacity:.35;--d:26s"></span>
    </div>
    <div class="container st-crew__grid rel">
      <div>
        <p class="eyebrow reveal">Le réseau</p>
        <h2 class="reveal" style="--rd:.08s">Seule aux commandes,<br /><em>jamais seule au travail.</em></h2>
        <p class="lead reveal" style="--rd:.16s">
          {brand.name} est un studio indépendant&nbsp;: c'est moi que vous rencontrez, moi qui pense votre projet et
          moi qui le suis. Quand il faut une caméra, un studio photo ou un coup de crayon expert, je fais appel à des
          partenaires de confiance.
        </p>
        <ul class="st-partners reveal" style="--rd:.2s">
          {partners.map((p) => <li>{p.label}</li>)}
        </ul>
      </div>
      <ol class="st-how">
        {
          how.map((h, i) => (
            <li class="st-how__item glass reveal" style={`--rd:${i * 0.1}s`}>
              <span class="st-how__n">0{i + 1}</span>
              <div>
                <h3>{h.t}</h3>
                <p>{h.d}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="st-head">
        <p class="eyebrow reveal">Travailler ensemble</p>
        <h2 class="reveal" style="--rd:.08s">Comment <em>ça se passe.</em></h2>
      </div>
      <ol class="st-steps">
        {
          steps.map((s, i) => (
            <li class="reveal" style={`--rd:${i * 0.08}s`}>
              <span class="st-steps__n">{s.num}</span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="st-cta">
    <div class="orbs" aria-hidden="true">
      <span class="orb orb--sage" style="width:600px;height:600px;left:10%;top:-200px;--d:24s"></span>
      <span class="orb orb--blush" style="width:520px;height:520px;right:5%;bottom:-220px;--d:28s"></span>
    </div>
    <div class="container st-cta__inner rel reveal">
      <h2>Parlons de <em>votre projet.</em></h2>
      <div class="st-cta__btns">
        <a href="/#contact" class="btn btn--primary">Écrire au studio <span aria-hidden="true">→</span></a>
        <a href="/#services" class="btn btn--glass">Voir les services</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .rel { position: relative; z-index: 1; }
  .st-head { display: grid; gap: 1.2rem; margin-bottom: clamp(36px, 5vw, 72px); }
  .st-head h2, .st-crew h2 { font-size: var(--h2); }

  .st-hero { position: relative; overflow: hidden; background: var(--grad-soft); padding: 150px 0 clamp(80px, 10vw, 130px); }
  .st-hero__grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: clamp(2rem, 6vw, 6rem); align-items: center; }
  .st-hero__text { display: grid; gap: 1.6rem; }
  .st-hero h1 { font-size: clamp(3.4rem, 8vw, 7rem); font-weight: 850; }
  .st-hero__visual { position: relative; padding: 0 0 2rem 2rem; }
  .st-portrait { aspect-ratio: 4 / 5; box-shadow: var(--shadow); }
  .st-portrait img { width: 100%; height: 100%; }
  .st-wink { position: absolute; left: -4%; bottom: 0; width: 36%; aspect-ratio: 1; border-radius: 50%; overflow: hidden; border: 6px solid rgb(255 255 255 / 0.7); box-shadow: var(--shadow); }
  .st-wink img { width: 100%; height: 100%; object-position: 30% 30%; }
  .st-quote { position: absolute; right: -4%; top: 18%; padding: 1rem 1.4rem; border-radius: var(--r-s); font: italic 850 1.3rem/1.2 var(--font-display); }
  .st-quote em { color: var(--eucalyptus); }

  .st-why { display: grid; gap: 1.4rem; }
  .st-big { font: italic 850 clamp(1.8rem, 3.6vw, 3.2rem)/1.18 var(--font-display); letter-spacing: -0.015em; max-width: 30ch; }
  .st-big em { color: var(--eucalyptus); }

  .st-bts { padding-bottom: clamp(72px, 9vw, 120px); }
  .st-bts__row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.2rem; margin-top: 1.8rem; }
  .st-shot { position: relative; margin: 0; }
  .st-shot:nth-child(even) { margin-top: 48px; }
  .st-shot__img { aspect-ratio: 3 / 4; border-radius: var(--r); overflow: hidden; box-shadow: var(--shadow); }
  .st-shot__img img { width: 100%; height: 100%; transition: transform 1.4s var(--ease-out); }
  .st-shot:hover img { transform: scale(1.05); }
  .st-shot figcaption { position: absolute; left: 12px; bottom: 12px; padding: 0.45rem 0.9rem; border-radius: var(--pill); font-size: 0.82rem; }

  .st-traits-wrap { overflow: hidden; background: var(--grad-soft); border-radius: var(--r-l); margin-inline: clamp(0px, 1.5vw, 20px); }
  .st-traits { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.2rem; }
  .st-trait { display: grid; gap: 1rem; align-content: space-between; min-height: 230px; padding: 1.8rem; border-radius: var(--r); transition: transform 0.7s var(--ease-out); }
  .st-trait:hover { transform: translateY(-6px); }
  .st-trait__w { font: italic 700 2.2rem/1 var(--font-display); color: var(--moss); }
  .st-trait p { color: rgb(43 52 47 / 0.75); }

  .st-line { list-style: none; margin: 0; padding: 0; display: grid; }
  .st-stop { display: grid; grid-template-columns: 200px 1fr; gap: 2rem; align-items: baseline; padding-block: 1.5rem; border-top: 1px solid var(--hair); }
  .st-stop:last-child { border-bottom: 1px solid var(--hair); }
  .st-stop__when { font: italic 700 1.4rem var(--font-display); color: var(--eucalyptus); }
  .st-stop div { display: grid; gap: 0.2rem; }
  .st-stop strong { font: 750 1.35rem var(--font-display); }
  .st-stop span:not(.st-stop__when) { color: rgb(43 52 47 / 0.65); font-size: 0.92rem; }

  .st-crew { position: relative; overflow: hidden; background: var(--grad-dark); color: var(--ink); padding-block: var(--section-y); border-radius: var(--r-l); margin-inline: clamp(0px, 1.5vw, 20px); }
  .st-crew__grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: clamp(2.5rem, 6vw, 6rem); align-items: center; }
  .st-crew__grid > div { display: grid; gap: 1.5rem; }
  .st-partners { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .st-partners li { padding: 0.6rem 1.2rem; border-radius: var(--pill); font-weight: 500; font-size: 0.9rem; background: rgb(255 255 255 / 0.14); backdrop-filter: blur(20px) saturate(1.6); -webkit-backdrop-filter: blur(20px) saturate(1.6); border: 0; box-shadow: 0 10px 24px -16px rgb(0 0 0 / 0.55), inset 0 0.5px 0 rgb(255 255 255 / 0.35); }
  .st-how { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; }
  .st-how__item { display: flex; gap: 1.3rem; align-items: baseline; padding: 1.5rem 1.7rem; border-radius: var(--r); }
  .st-how__n { font: italic 700 1.6rem var(--font-display); color: var(--champagne); }
  .st-how__item h3 { font-size: 1.5rem; font-weight: 850; margin-bottom: 0.3rem; }
  .st-how__item p { font-size: 0.95rem; opacity: 0.8; }

  .st-steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 2rem; }
  .st-steps li { display: grid; gap: 0.6rem; align-content: start; padding-top: 1.4rem; border-top: 1px solid var(--hair); }
  .st-steps__n { font: italic 700 1.4rem var(--font-display); color: var(--eucalyptus); }
  .st-steps h3 { font-size: 1.6rem; font-weight: 850; }
  .st-steps p { font-size: 0.95rem; color: rgb(43 52 47 / 0.75); }

  .st-cta { position: relative; overflow: hidden; background: var(--grad-soft); padding-block: clamp(100px, 12vw, 170px); }
  .st-cta__inner { display: grid; justify-items: center; text-align: center; gap: 2rem; }
  .st-cta h2 { font-size: clamp(2.8rem, 7vw, 6rem); font-weight: 850; }
  .st-cta__btns { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.8rem; }

  @media (max-width: 1000px) {
    .st-traits, .st-steps, .st-bts__row { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 800px) {
    .st-hero__grid, .st-crew__grid { grid-template-columns: 1fr; }
    .st-hero__visual { max-width: 440px; }
    .st-stop { grid-template-columns: 1fr; gap: 0.3rem; }
  }
  @media (max-width: 560px) {
    .st-traits, .st-steps { grid-template-columns: 1fr; }
    .st-trait { min-height: 0; }
    .st-quote { right: 0; }
    .st-cta__btns .btn { width: 100%; }
  }
</style>
